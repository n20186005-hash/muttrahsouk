{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muttrahsouk",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
