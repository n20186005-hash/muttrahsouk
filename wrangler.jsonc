{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mutrah-souq-guide",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
