---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة', href: '/itineraries/half-day/' },
  { name: 'جولة مشي ساعتين' },
];

const quickFacts = [
  { label: 'مدة الجولة', value: 'ساعتان تقريباً' },
  { label: 'نطاق المسار', value: 'داخل سوق مطرح ثم الكورنيش' },
  { label: 'الأنسب زمنياً', value: 'الصباح الباكر أو بعد العصر' },
  { label: 'طبيعة الأرض', value: 'مشي متوسط على أرض غير مستوية' },
];

const stops = [
  { time: '00:00–00:15', place: 'نقطة البداية على كورنيش مطرح قرب المدخل الرئيسي', note: 'نظرة سريعة على الواجهة والميناء، وتحديد مدخل الأزقة الذي ستعود إليه.' },
  { time: '00:15–00:40', place: 'الممر الرئيسي داخل السوق', note: 'محال اللبان والبخور والعطور؛ اسأل عن المنشأ قبل الشراء.' },
  { time: '00:40–01:05', place: 'الجزء المسقوف الأكثر إظلاماً', note: 'أزقة ضيقة وأسقف خشبية؛ تجربة «سوق الظلام» بمعناها الوصفي لا الإغلاق.' },
  { time: '01:05–01:30', place: 'محال الأقمشة والفضيات والخناجر والتحف', note: 'وقت مناسب للاطلاع على الحرف والهدايا دون التزام بالشراء.' },
  { time: '01:30–01:50', place: 'الخروج باتجاه سوق السمك وأسفل قلعة مطرح', note: 'اكتفِ بالمشاهدة؛ صعود القلعة يحتاج وقتاً وحرارة أقل.' },
  { time: '01:50–02:00', place: 'العودة إلى كورنيش مطرح', note: 'ختام الجولة بمشروب سريع مع إطلالة على الميناء.' },
];

const faq = [
  { q: 'هل تكفي ساعتان لزيارة سوق مطرح؟', a: 'نعم، تكفي ساعتان لاستكشاف الممر الرئيسي والأزقة المسقوفة والمرور على محال اللبان والأقمشة والفضيات، مع وقت قصير على الكورنيش. أما من يريد الشراء بتأنٍّ أو الجلوس للطعام فيحتاج وقتاً أطول.' },
  { q: 'ما أفضل وقت لبدء جولة الساعتين؟', a: 'الصباح الباكر أهدأ وأبرد، وفترة بعد العصر أكثر حيوية وقرباً من أجواء الإضاءة المسائية. تجنّب ذروة الظهيرة صيفاً قدر الإمكان.' },
  { q: 'هل تشمل الجولة صعود قلعة مطرح؟', a: 'لا، لأن الصعود إضافة تستهلك وقتاً أكبر وجهداً في الحرارة. اترك القلعة لبرنامج نصف اليوم إن كان لديك متسع، وتحقّق من ساعات الزيارة قبل الصعود.' },
  { q: 'ماذا أفعل إن كان الازدحام شديداً؟', a: 'اتخذ الممرات الجانبية بدلاً من المحور الرئيسي، وتقدّم مع اتجاه المشاة، وقلّل الوقوف الطويل أمام المداخل والمحال المزدحمة.' },
  { q: 'هل الجولة مناسبة مع الأطفال أو كبار السن؟', a: 'المسار قصير لكن الأرض غير مستوية والأزقة ضيقة. التوقيت الأبرد وتقليل الوقفات الطويلة يخفّفان الجهد؛ راجع صفحة الزيارة مع الأطفال والمعالم الخاصة بالإتاحة قبل الالتزام بالمسار كاملاً.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان وفترة الزيارة المناسبة من سبتمبر إلى مايو.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف الأزقة والأسقف الخشبية والسلع، وهو أساس ترتيب المسار داخل السوق.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع وساعات القائمة؛ تحقّق منها قبل الانطلاق.' },
];

const related = [
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم في مطرح', desc: 'إضافة القلعة وسوق السمك وتوقف للطعام إلى الزيارة.' },
  { href: '/itineraries/one-hour/', label: 'زيارة سوق مطرح في ساعة', desc: 'نسخة مضغوطة لمن لديه وقت قصير جداً.' },
  { href: '/visit/best-time/', label: 'أفضل وقت لزيارة السوق', desc: 'الموازنة بين الهدوء والحركة والحرارة.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'ممشى الواجهة البحرية الذي يفتتح ويختم الجولة.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'معلم قريب يمكن إضافته خارج نطاق الساعتين.' },
];
---
<GuideLayout
  title="جولة مشي في سوق مطرح لمدة ساعتين | مسار مقترح خطوة بخطوة"
  h1="جولة مشي في سوق مطرح في ساعتين"
  description="مسار مشي منظّم لمدة ساعتين داخل سوق مطرح: نقاط التوقف بترتيب زمني من الكورنيش إلى الأزقة المسقوفة، مع بدائل عند الحر أو الازدحام وما يمكن الاستغناء عنه."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">مسار مقترح خطوة بخطوة</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">خريطة زمنية لجولة الساعتين</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="هذه جولة مشي من الواجهة البحرية إلى داخل الأزقة المسقوفة ثم عودة إلى الكورنيش. رتّبنا التوقف بحيث يجري كل جزء في طريقه الطبيعي بدل التنقل العشوائي، فيمكنك الالتزام بالزمن أو تعديله بحسب الاهتمام والازدحام دون أن تضيع البوصلة." /></p>
            <p><BidiText text="الأزقة ضيقة والمسافات قصيرة، لذا يغلب على الجولة المشي البطيء لا المسافات الطويلة. المسار المنشور هنا مقترح تنظيمي وليس مساراً رسمياً معلَماً؛ تحقّق من المداخل المفتوحة في يوم زيارتك." /></p>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse text-right text-sm">
            <thead>
              <tr class="bg-[#2b1b13] text-white">
                <th class="p-4 font-black">الوقت</th>
                <th class="p-4 font-black">المحطة</th>
                <th class="p-4 font-black">ملاحظة</th>
              </tr>
            </thead>
            <tbody>
              {stops.map((s, i) => (
                <tr class={i % 2 ? 'bg-[#f7f0df]' : 'bg-[#fffaf0]'}>
                  <td class="p-4 font-bold text-[#176b68]"><BidiText text={s.time} /></td>
                  <td class="p-4 font-black text-[#18110d]">{s.place}</td>
                  <td class="p-4 text-[#66574e]">{s.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">نقطة البداية المقترحة</p>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="ابدأ من كورنيش مطرح بحيث يكون المدخل الرئيسي للسوق على يمينك، فيصبح الوصول والخروج في نفس الاتجاه وتتجنّب الدوران داخل الأزقة." /></p>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> الأزقة غير مستوية وقد تكون مزدحمة؛ خصّص هامشاً زمنياً صغيراً بين المحطات بدلاً من حجزها بالدقيقة.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">المرونة أثناء الجولة</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">بدائل عند الحر أو الازدحام، وما يُستغنى عنه</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">إذا ارتفعت الحرارة</h3>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>ابدأ في الصباح الباكر أو بعد العصر بدل الظهيرة.</li>
            <li>قلّل الوقفات في الأجزاء غير المظللة قرب الكورنيش.</li>
            <li>اختبر الجولة على جزئين مع راحة متكررة في الظل.</li>
          </ul>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">إذا اشتدّ الازدحام</h3>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>استخدم الممرات الجانبية بعيداً عن المحور الرئيسي.</li>
            <li>سِر مع اتجاه المشاة ولا تعكس السير في الأزقة الضيقة.</li>
            <li>أجّل التوقف عند المداخل حتى تخفّ الحركة.</li>
          </ul>
        </div>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-6">
        <p class="text-sm font-black text-[#18110d]">إن ضاق الوقت، استغنَ عن صعود القلعة وزيارة سوق السمك واكتفِ بجولة السوق والكورنيش.</p>
        <p class="mt-2 text-sm text-[#66574e]">وإن كان هدفك الشراء، خصّص وقتاً أطول لمحال اللبان والتوابل والأقمشة وقلّل التوقف في المداخل.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا تفاصيل هذه الجولة في 2 نوفمبر 2026. تبقى ساعات العمل وأعمال الصيانة والمداخل المفتوحة قابلة للتغيير، خصوصاً يوم الجمعة والعطلات والمناسبات." /></p>
        <p>هذا المسار اقتراح تنظيمي من دليل مستقل وغير رسمي، ولا يمثّل طريقاً رسمياً معتمداً. تحقّق من خرائط جوجل والقنوات الرسمية في يوم زيارتك، واتبع تعليمات الموظفين واللوحات المحلية داخل السوق.</p>
      </div>
    </div>
  </section>
</GuideLayout>
