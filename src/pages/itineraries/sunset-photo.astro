---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة', href: '/itineraries/half-day/' },
  { name: 'الغروب والتصوير' },
];

const quickFacts = [
  { label: 'توقيت الغروب', value: 'يتغير بالفصول، ويقع تقريباً بين 17:20 و19:00' },
  { label: 'أفضل ضوء', value: 'الساعة الذهبية قبل الغروب وبعده' },
  { label: 'مواقع الإطلالة', value: 'كورنيش مطرح ومحيط قلعة مطرح' },
  { label: 'داخل الأزقة', value: 'الوسق الخشبي والمصابيح بعد الغروب' },
];

const schedule = [
  { t: 'قبل الغروب بنحو ساعة', what: 'الوصول إلى الكورنيش أو محيط القلعة لالتقاط الضوء الذهبي المنخفض على الميناء والواجهة البحرية.' },
  { t: 'لحظة الغروب', what: 'تثبيت موقع إطلالة مفتوح غرباً لمتابعة انخفاض الشمس؛ التغير سريع فاستعد مسبقاً.' },
  { t: 'بعد الغروب مباشرةً', what: 'ضوء أزرق هادئ على الأفق وبداية إضاءة المصابيح؛ فرصة لصور متوازنة بين السماء والإضاءة.' },
  { t: 'بعد حلول الظلام', what: 'الدخول إلى الأزقة المسقوفة حيث يبرز أثر الوسق الخشبي والمصابيح على الجدران.' },
];

const viewpoints = [
  { name: 'كورنيش مطرح', text: 'الممشى المفتوح على الواجهة البحرية يمنح أفقاً واسعاً ومرمى حراً نحو الميناء والقوارب، وهو الأنسب لإطار الغروب العام.' },
  { name: 'محيط قلعة مطرح', text: 'المنطقة المرتفعة قرب القلعة تمنح منظوراً أعلى على الميناء والمنطقة؛ يُشاهد الموقع من الخارج مع الحذر على المنحدرات.' },
  { name: 'الأزقة المسقوفة', text: 'بعد الغروب يتحول السوق إلى مشهد مختلف تماماً؛ الأسقف الخشبية والمصابيح تصنع ظلالاً وملمساً مميزاً للصور الداخلية.' },
];

const monthTable = [
  { m: 'يناير', s: '17:41' },
  { m: 'فبراير', s: '18:02' },
  { m: 'مارس', s: '18:16' },
  { m: 'يوليو (الأبعد)', s: '18:57' },
  { m: 'أكتوبر', s: '17:32' },
  { m: 'نوفمبر (الأبكر)', s: '17:18' },
];

const safety = [
  'راقب حركة السيارات على الطرق المحيطة بالكورنيش واعبر من نقاط آمنة.',
  'قلّل حِمل المعدات الظاهرة وتجنّب إغلاق الممرات بالمُثلّث أو الحقيبة.',
  'احترم من يمنع التصوير، واستأذن قبل تصوير الأشخاص أو الباعة.',
  'احذر الازدحام في المساء عند محاولة الوقوف بثبات لالتقاط الصور.',
];

const faq = [
  {
    q: 'متى يحين الغروب في مطرح؟',
    a: 'يتغير توقيت الغروب عبر السنة فيقع تقريباً بين الساعة الخامسة والدقيقة العشرين والساعة السابعة مساءً. تحقق من توقيت يومك تحديداً لأن الفارق يبلغ ساعات بين الفصول.',
  },
  {
    q: 'ما أفضل نقطة لتصوير الغروب؟',
    a: 'الكورنيش أنسب لإطار واسع نحو الميناء، ومحيط قلعة مطرح يمنح منظوراً أعلى. أما الأزقة المسقوفة فتكون في أنسب حالاتها بعد الغروب مع الإضاءة الليلية.',
  },
  {
    q: 'هل يمكن التصوير داخل السوق؟',
    a: 'التصوير في الأماكن العامة عادةً ممكن، لكن استأذن الأشخاص والباعة قبل تصويرهم واحترم أي منع. راجع صفحة آداب التصوير على هذا الدليل للتفاصيل.',
  },
  {
    q: 'هل يمكن استخدام الطائرات المسيّرة للتصوير؟',
    a: 'تشغيل الطائرات المسيّرة يخضع لموافقات الجهات المختصة، وينبغي التحقق من القواعد السارية قبل أي استخدام. لا تفترض السماح بالاستخدام في المناطق السياحية.',
  },
  {
    q: 'ما احتياطات السلامة عند التصوير مساءً؟',
    a: 'راقب حركة السيارات حول الكورنيش، ولا تسدّ الممرات، وقلّل حمل المعدات الظاهرة، وتجنّب التصوير في مواقع مزدحمة قد تسبب تعطيلاً للآخرين.',
  },
];

const sources = [
  {
    label: 'Sunrise and sunset times in Muscat',
    org: 'sunrisesunset.io',
    url: 'https://sunrisesunset.io/om/muscat/muscat/',
    desc: 'تقويم شمسي لمسقط؛ منه الأوقات التقريبية للغروب والفروق بين الفصول.',
  },
  {
    label: 'Sunset Times in Muscat (2026)',
    org: 'Captain Wake',
    url: 'https://captainwake.io/sunset/muscat',
    desc: 'أوقات الغروب والساعة الذهبية شهراً بشهر في مسقط كمرجع تقريبي.',
  },
  {
    label: 'تجربة عُمان — سوق مطرح',
    org: 'وزارة التراث والسياحة (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat/mutrah-souq',
    desc: 'تعريف رسمي بالسوق وطابعه وأزقته المسقوفة المرتبطة بالمشهد الليلي.',
  },
  {
    label: 'خرائط جوجل — موقع سوق مطرح',
    org: 'خرائط جوجل',
    url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8',
    desc: 'تحديد المدخل والموقع لتخطيط نقطة الإطلالة قبل الغروب (لقطة 2 نوفمبر 2026).',
  },
];

const related = [
  { href: '/souq/photography-etiquette/', label: 'التصوير والآداب', desc: 'قواعد استئذان الناس والباعة والتصوير المسؤول.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'منطقة إطلالة مرتفعة على الميناء.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى الأنسب لإطار الغروب الواسع.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'موازنة الهدوء والحركة والإضاءة.' },
  { href: '/itineraries/2-hour-walk/', label: 'جولة مشي ساعتين', desc: 'مسار نهاري يمكن دمجه مع جلسة الغروب.' },
];
---
<GuideLayout
  title="الغروب والتصوير في مطرح: مواقع وتوقيت وضوء | دليل سوق مطرح"
  h1="التصوير والغروب في مطرح: مواقع وتوقيت"
  description="تصوير الغروب في مطرح: توقيت الغروب المتغير بالفصول، مواقع إطلالة على الكورنيش ومحيط القلعة، وضوء الأزقة المسقوفة بعد الغروب."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">الوقت هو المفتاح</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">الغروب في مسقط ليس موعداً ثابتاً</h2>
      <div class="mt-6 space-y-4 text-[#58483e]">
        <p><BidiText text="يتغيّر توقيت الغروب عبر فصول السنة، ويقع في مسقط تقريباً بين الساعة الخامسة والدقيقة العشرين والساعة السابعة مساءً. هذا يعني أن الفارق بين موعد صيفي وموعد شتوي قد يبلغ أكثر من ساعة ونصف، فالتخطيط على وقت ذكرناه في صفحة سابقة لا يكفي." /></p>
        <p><BidiText text="أنسب فترة للوصول هي الساعة التي تسبق الغروب، لأن الضوء الذهبي المنخفض يمنح الأفق والميناء ملمساً مميزاً. راجع توقيت يومك من تقويم موثوق واطرح منه نحو ساعة لتحديد وقت الحضور." /></p>
      </div>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#2b1b13] text-white">
              <th class="p-4">الشهر</th>
              <th class="p-4">الغروب التقريبي</th>
              <th class="p-4">ملاحظة</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#B98739]/30 bg-[#fffaf0]">
            {monthTable.map((r) => (
              <tr>
                <td class="p-4 font-black text-[#18110d]">{r.m}</td>
                <td class="p-4"><BidiText text={r.s} /></td>
                <td class="p-4 text-[#66574e]">قيمة إرشادية تتغير سنوياً — تحقّق لتاريخك</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-10 lg:grid-cols-2">
      <div>
        <p class="kicker">خط زمني للجلسة</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">من الساعة الذهبية إلى الأضواء</h2>
        <ol class="mt-6 grid gap-4">
          {schedule.map((s) => (
            <li class="card rounded-3xl p-5">
              <p class="text-xs font-black text-[#176b68]">{s.t}</p>
              <p class="mt-2 text-[#58483e]"><BidiText text={s.what} /></p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <p class="kicker">مواقع الإطلالة</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">أين تقف وقت الغروب</h2>
        <div class="mt-6 grid gap-4">
          {viewpoints.map((v) => (
            <article class="card rounded-3xl p-6">
              <h3 class="text-lg font-black text-[#18110d]">{v.name}</h3>
              <p class="mt-2 text-[#66574e]"><BidiText text={v.text} /></p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell">
      <p class="text-sm font-bold text-[#F6D98C]">قبل أن ترفع الكاميرا</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">احتياطات وسلوك مسؤول</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {safety.map((s) => (
          <li class="rounded-3xl border border-white/15 bg-black/15 p-5 text-[#e6f2ef]"><BidiText text={s} /></li>
        ))}
      </ul>
      <p class="mt-6 max-w-3xl text-sm text-[#d8eee9]"><BidiText text="لا نذكر أي محال أو مقاهٍ باسمها؛ اختر نقطة وقوفك على الأساس العام للمكان والضوء، والتزم آداب المكان وأولوية الناس على الصورة." /></p>
    </div>
  </section>

  <section class="section">
    <div class="shell rounded-[2rem] border border-[#B98739]/30 bg-[#fffaf0] p-6 text-sm text-[#66574e]">
      <p><b class="text-[#18110d]">ملاحظة التحقق:</b> روجعت أوقات الغروب التقريبية بتاريخ <bdi dir="ltr">2 نوفمبر 2026</bdi>. القيم إرشادية وتتغير سنوياً، فضلاً عن اختلافها بفعل التضاريس؛ تحقّق من توقيت يومك قبل الانطلاق.</p>
    </div>
  </section>
</GuideLayout>
