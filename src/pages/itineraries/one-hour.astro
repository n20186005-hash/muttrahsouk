---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة', href: '/itineraries/half-day/' },
  { name: 'زيارة في ساعة واحدة' },
];

const quickFacts = [
  { label: 'إجمالي المدة', value: 'نحو 60 دقيقة' },
  { label: 'نقطة الدخول', value: 'المدخل الرئيسي من جهة كورنيش مطرح' },
  { label: 'ما تُلتقطه', value: 'الأزقة المسقوفة واللبان والتوابل والفضيات' },
  { label: 'ما يُستغنى عنه', value: 'قلعة مطرح وسوق السمك ومحطات مسقط القديمة' },
];

const route = [
  { t: 'الدقائق 0–5', what: 'الدخول من المدخل الرئيسي جهة الكورنيش، ونظرة سريعة على الممر الرئيسي لتحديد الاتجاه.' },
  { t: 'الدقائق 5–25', what: 'التوقف عند محال اللبان والبخور والتوابل؛ تجربة الروائح والسؤال عن المنشأ باختصار.' },
  { t: 'الدقائق 25–40', what: 'الممر نحو محال الفضيات والخناجر؛ مشاهدة سريعة للقطع دون تعمّق في التفاصيل والسعر.' },
  { t: 'الدقائق 40–52', what: 'عبور الجزء المسقوف الأكثر إظلاماً بين الأزقة لالتقاط انطباع سوق الظلام.' },
  { t: 'الدقائق 52–60', what: 'الخروج من أقرب مدخل باتجاه الكورنيش، أو التوجه مباشرة إلى نقطة الانطلاق قبل مغادرة المكان.' },
];

const skips = [
  'التعمّق في محال القطع الثمينة: يحتاج وقتاً للتفاوض والمعاينة.',
  'صعود قلعة مطرح: يضيف وقتاً كبيراً للجولة.',
  'زيارة سوق السمك: أنسب في الصباح وليس ضمن نافذة الساعة.',
  'محطات مسقط القديمة: تحتاج انتقالاً منفصلاً ونصف يوم.',
];

const tips = [
  'ادخل من المدخل الرئيسي واخرج من المدخل الأقرب لوجهتك التالية لتوفير وقت الدخول والخروج.',
  'احمل بعض النقود للمشتريات السريعة؛ قبول البطاقات يتفاوت من محل لآخر.',
  'حدّد سلفاً فئتين أو ثلاث فئات تريد رؤيتها (مثل اللبان والتوابل والفضة) لتجنّب التشتت.',
  'تجنّب الذروة إن أمكن: صباحاً أو قبل الغروب تكون الأزقة أخفّ حركة.',
  'اجعل الانطباع السريع هدفاً لا شراء كل شيء؛ يمكن العودة لاحقاً بجولة أطول.',
];

const faq = [
  {
    q: 'هل تكفي ساعة واحدة لزيارة سوق مطرح؟',
    a: 'نعم لالتقاط انطباع حقيقي ومشتريات سريعة. الساعة لا تكفي للتسوّق المتأنّي أو لدمج معالم أخرى، لكنها مناسبة لمن وقته ضيق أو يريد لمحة أولى.',
  },
  {
    q: 'من أين أبدأ الجولة وأين أنتهي؟',
    a: 'ابدأ من المدخل الرئيسي جهة كورنيش مطرح لأنه أوضح المداخل وأقربها للواجهة البحرية، واخرج من المدخل الأقرب إلى وجهتك التالية لتوفير الوقت.',
  },
  {
    q: 'ماذا سأفوّت في الجولة السريعة؟',
    a: 'قلعة مطرح وسوق السمك ومحطات مسقط القديمة، إضافةً إلى التعمّق في المحال الثمينة. يمكن تغطية هذه العناصر في جولة ساعتين أو نصف يوم.',
  },
  {
    q: 'ما أفضل وقت لهذه الجولة؟',
    a: 'صباحاً أو قبل الغروب حيث تكون الحركة أخف والحرارة أقل في أغلب المواسم. تجنّب ذروة المساء والعطلات إن كنت تفضّل نسخة سريعة ومريحة.',
  },
];

const sources = [
  {
    label: 'تجربة عُمان — سوق مطرح',
    org: 'وزارة التراث والسياحة (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat/mutrah-souq',
    desc: 'تعريف رسمي بالسوق وممراته ومحال اللبان والتوابل والمنسوجات.',
  },
  {
    label: 'بلدية مسقط — سوق مطرح',
    org: 'بلدية مسقط (رسمي)',
    url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903',
    desc: 'وصف الأزقة والأسقف الخشبية وتسمية سوق الظلام والسلع المعروضة.',
  },
  {
    label: 'خرائط جوجل — موقع سوق مطرح',
    org: 'خرائط جوجل',
    url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8',
    desc: 'اللقطة المرجعية للموقع والمداخل؛ تحقّق قبل الانطلاق (لقطة 2 نوفمبر 2026).',
  },
];

const related = [
  { href: '/itineraries/2-hour-walk/', label: 'جولة مشي ساعتين', desc: 'النسخة الأوسع بترتيب زمني مضبوط.' },
  { href: '/visit/entrances/', label: 'المداخل والبوابات', desc: 'اختيار نقطة الدخول والخروج المناسبة.' },
  { href: '/souq/al-dhalam/', label: 'لماذا سوق الظلام؟', desc: 'سبب تسمية الجزء المسقوف المظلم.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'موازنة الهدوء والحركة والحرارة.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'وجهة قريبة بعد إنهاء الجولة السريعة.' },
];
---
<GuideLayout
  title="زيارة سوق مطرح في ساعة واحدة: مسار سريع محدد | دليل سوق مطرح"
  h1="زيارة سوق مطرح في ساعة واحدة: مسار مضغوط"
  description="مسار سريع لزيارة سوق مطرح في ساعة: نقطة دخول واضحة، ترتيب زمني بالدقائق، وما تُلتقطه وما تستغني عنه لمن وقته ضيق."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">مسار الساعة الواحدة</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">ترتيب زمني بالدقائق</h2>
      <p class="mt-5 max-w-3xl text-[#58483e]">خصص ساعة صافية داخل السوق ولا تجعلها ساعة مع البحث عن موقف أو التنقل. المسار التالي مصمّم ليمنحك الانطباع الأقوى بأقصر خطوات ممكنة داخل الأزقة.</p>
      <ol class="mt-8 grid gap-4">
        {route.map((s) => (
          <li class="card flex items-start gap-4 rounded-3xl p-5">
            <span class="shrink-0 rounded-full bg-[#E2A52E] px-4 py-1.5 text-xs font-black text-[#18110d]"><BidiText text={s.t} /></span>
            <p class="text-[#58483e]"><BidiText text={s.what} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-10 lg:grid-cols-2">
      <div>
        <p class="kicker">لضمان الالتزام بالوقت</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">ما يُستغنى عنه في جولة الساعة</h2>
        <ul class="mt-6 space-y-4">
          {skips.map((s) => (
            <li class="card rounded-3xl p-5 text-[#66574e]"><BidiText text={s} /></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="kicker">نصائح للوقت القصير</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">اجعل الساعة مكسباً لا خسارة</h2>
        <ul class="mt-6 space-y-3 text-[#58483e]">
          {tips.map((s) => (
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#176b68]"></span><p><BidiText text={s} /></p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell rounded-[2rem] border border-[#B98739]/30 bg-[#fffaf0] p-6 text-sm text-[#66574e]">
      <p><b class="text-[#18110d]">ملاحظة التحقق:</b> روجعت تفاصيل هذا المسار بتاريخ <bdi dir="ltr">2 نوفمبر 2026</bdi>. ترتيب المحال والمداخل قد يتغير، وساعات الزيارة تتفاوت، فتحقّق ميدانياً عند الوصول وعدّل المدد بحسب الازدحام.</p>
    </div>
  </section>
</GuideLayout>
