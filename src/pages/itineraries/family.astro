---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة', href: '/itineraries/half-day/' },
  { name: 'مسار عائلي' },
];

const quickFacts = [
  { label: 'الأنسب مع الأطفال', value: 'الصباح الباكر أو بعد العصر' },
  { label: 'طول المسار', value: 'قصير مع فواصل راحة متكرّرة' },
  { label: 'نقاط الراحة', value: 'كورنيش مطرح والحديقة القريبة' },
  { label: 'ما يُحمل', value: 'ماء وواقٍ للشمس، والتحقق من ملاءمة عربة الأطفال' },
];

const plan = [
  { t: 'البداية', what: 'الوصول قبل الحرارة أو بعد العصر، والتوقف عند الكورنيش أولاً لأن المكان مفتوح وأسهل لتجمع الأطفال وتوزيع الأدوار.' },
  { t: 'القسم الأول', what: 'دخول قصير إلى السوق من المدخل القريب من الكورنيش، مع تحديد هدف واحد فقط مثل اللبان أو التوابل ليبقى الأطفال متفاعلين.' },
  { t: 'فاصل راحة', what: 'الخروج إلى الكورنيش أو نقطة ظل للجلوس والماء قبل المواصلة؛ الفاصل القصير يجدد النشاط.' },
  { t: 'القسم الثاني', what: 'جولة ثانية قصيرة داخل ممر واحد أو اثنين فقط، مع تجنّب الممرات الضيقة في أوقات الازدحام.' },
  { t: 'الخِتام', what: 'العودة إلى مساحة مفتوحة كالكورنيش أو الحديقة المجاورة للعب والراحة قبل المغادرة.' },
];

const practical = [
  'التوقيت أهم من المسار: ابدأ صباحاً أو بعد العصر لتقليل الحرارة والازدحام مع الأطفال.',
  'اختصر الهدف: فئة واحدة أو اثنتان تكفي، فالأطفال يفقدون التركيز في التسوّق الطويل.',
  'أكّد توفر المرافق ودورات المياه ميدانياً قبل الاعتماد عليها.',
  'اختبر ملاءمة عربة الأطفال على أرضية السوق غير المستوية قبل الدخول بها.',
  'حدّد نقطة لقاء واضحة بين أفراد الأسرة حال تفرّقهم في الازدحام.',
];

const faq = [
  {
    q: 'هل سوق مطرح مناسب للأطفال؟',
    a: 'نعم لزيارة قصيرة ومنظّمة، خصوصاً مع الكورنيش المجاور. لكن الممرات قد تكون ضيقة ومزدحمة وأرضيتها غير مستوية، لذا الأنسب جولة قصيرة بفواصل راحة.',
  },
  {
    q: 'ما أفضل وقت للزيارة العائلية؟',
    a: 'الصباح الباكر أو بعد العصر حين تنخفض الحرارة وتخفّ الحركة. تجنّب الظهيرة صيفاً وذروة المساء في العطلات.',
  },
  {
    q: 'هل يمكن استخدام عربة الأطفال؟',
    a: 'الأرضيات غير مستوية والممرات قد تكون ضيقة، لذا يجب اختبار الملاءمة ميدانياً عند المدخل، ويمكن الاعتماد على الكورنيش المفتوح كبديل أسهل للتنقل.',
  },
  {
    q: 'أين ترتاح الأسرة؟',
    a: 'الكورنيش والحديقة القريبة هما الأسهل للجلوس والراحة. تأكد من توفر المرافق التي تحتاجها ميدانياً بدلاً من الافتراض.',
  },
  {
    q: 'كيف نتعامل مع إرهاق الأطفال؟',
    a: 'خطّط المسار على شكل أقسام قصيرة، وكن مستعداً للخروج إلى مساحة مفتوحة عند أول علامة تعب، أو لإنهاء الجولة مبكراً بلا إلزام بإكمال كل المحطات.',
  },
];

const sources = [
  {
    label: 'تجربة عُمان — سوق مطرح',
    org: 'وزارة التراث والسياحة (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat/mutrah-souq',
    desc: 'تعريف رسمي بالسوق وسياقه، وفترة الزيارة المناسبة.',
  },
  {
    label: 'بلدية مسقط — سوق مطرح',
    org: 'بلدية مسقط (رسمي)',
    url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903',
    desc: 'وصف أزقة السوق وأسقفه الخشبية وسلعه؛ مفيد لتقدير طبيعة التنقل.',
  },
  {
    label: 'خرائط جوجل — موقع سوق مطرح',
    org: 'خرائط جوجل',
    url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8',
    desc: 'اللقطة المرجعية للموقع والمداخل؛ تحقّق قبل الانطلاق (لقطة 2 نوفمبر 2026).',
  },
];

const related = [
  { href: '/visit/family-practical/', label: 'الزيارة مع الأطفال', desc: 'إرشادات عملية تفصيلية للعائلات.' },
  { href: '/around/riyam-park/', label: 'حديقة ريام', desc: 'مساحة خضراء على الساحل مناسبة للتوقف.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'ممشى مفتوح للراحة والتنقل مع الأطفال.' },
  { href: '/food/quick-drinks/', label: 'الشاي والوجبات الخفيفة', desc: 'توقّف سريع خفيف مناسب للعائلات.' },
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'دمج الزيارة العائلية في برنامج أطول.' },
];
---
<GuideLayout
  title="مسار عائلي حول سوق مطرح: مشي قصير مع فواصل راحة | دليل سوق مطرح"
  h1="مسار عائلي حول سوق مطرح مع الأطفال"
  description="مسار عائلي حول سوق مطرح: مشي قصير بأقسام وفواصل راحة، أوقات أبرد، نقاط ظل وماء، والكورنيش للأطفال مع مرونة عند التعب."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">منطق المسار</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">أقسام قصيرة بدل جولة طويلة</h2>
      <p class="mt-5 max-w-3xl text-[#58483e]">هذا المسار مبني على مبدأ مختلف عن الجولات السريعة: الأولوية للراحة والتوقيت البارد لا لتغطية أكبر عدد من المحال. كل قسم يعقبه فاصل راحة، ويمكن إيقاف الجولة في أي نقطة دون خسارة جوهر التجربة.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {plan.map((s) => (
          <article class="card rounded-3xl p-6">
            <p class="text-xs font-black text-[#176b68]">{s.t}</p>
            <p class="mt-3 text-[#58483e]"><BidiText text={s.what} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell grid gap-10 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="text-sm font-bold text-[#F6D98C]">قواعد عملية</p>
        <h2 class="display mt-3 text-3xl font-black md:text-4xl">خمس قواعد تُنجح الجولة العائلية</h2>
        <ul class="mt-6 space-y-4">
          {practical.map((s) => (
            <li class="rounded-3xl border border-white/15 bg-black/15 p-5 text-[#e6f2ef]"><BidiText text={s} /></li>
          ))}
        </ul>
      </div>
      <div class="grid content-start gap-5">
        <div class="rounded-3xl border border-white/15 bg-black/15 p-6">
          <p class="text-sm font-black text-[#F6D98C]">نقاط الظل والراحة</p>
          <p class="mt-3 text-[#e6f2ef]">الأزقة المسقوفة توفّر ظلاً داخل السوق، لكنها تضيق في الازدحام. المساحة المفتوحة على الكورنيش والحديقة القريبة أنسب لجلسة راحة وراحة الأطفال قبل استئناف الجولة.</p>
        </div>
        <div class="rounded-3xl border border-white/15 bg-black/15 p-6">
          <p class="text-sm font-black text-[#F6D98C]">الماء والاستعداد</p>
          <p class="mt-3 text-[#e6f2ef]">احمل ماءً كافياً وواقياً للشمس، وارتدِ ملابس مريحة. تُراجَع ملاءمة عربة الأطفال وتوفر الدورات والمرافق ميدانياً، فهي غير مؤكدة من المصادر.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell rounded-[2rem] border border-[#B98739]/30 bg-[#fffaf0] p-6 text-sm text-[#66574e]">
      <p><b class="text-[#18110d]">ملاحظة التحقق:</b> روجعت إرشادات هذا المسار بتاريخ <bdi dir="ltr">2 نوفمبر 2026</bdi>. الحرارة والازدحام وتوفر المرافق تتغير بتغير الموسم والوقت، لذا راجعها ميدانياً وعدّل الأقسام بما يناسب عمر الأطفال وحالتهم.</p>
    </div>
  </section>
</GuideLayout>
