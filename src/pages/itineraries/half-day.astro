---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة', href: '/itineraries/half-day/' },
  { name: 'برنامج نصف يوم' },
];

const quickFacts = [
  { label: 'مدة البرنامج', value: 'أربع إلى خمس ساعات' },
  { label: 'الأنشطة المشمولة', value: 'السوق والكورنيش والقلعة وسوق السمك' },
  { label: 'بداية موصى بها', value: 'صباحاً للأسواق أو بعد العصر للأجواء' },
  { label: 'ملاحظة الطقس', value: 'قلّل المشي في الظهيرة صيفاً' },
];

const faq = [
  { q: 'هل يكفي نصف يوم لتغطية كل معالم مطرح؟', a: 'يكفي نصف يوم لتغطية السوق والكورنيش والقلعة وسوق السمك مع توقف للطعام، لكنه نصف يوم مزدحم. إن أردت تأنّياً في الشراء أو جلسة طويلة على الواجهة فقسّم الزيارة على يومين.' },
  { q: 'أبدأ صباحاً أم بعد العصر؟', a: 'الصباح الباكر يمنحك سوق السمك في أنشط حالاته وحرارة أقل، لكنه يعني صعود القلعة في حرارة مرتفعة نسبياً. البدء بعد العصر يعطيك أضواءً مسائية وسوقاً أكثر حيوية مقابل ازدحام أكبر.' },
  { q: 'هل أحتاج سيارة خلال نصف اليوم؟', a: 'الجزء الأكبر داخل مطرح يمكن مشيه، والانتقال بين السوق والكورنيش والقلعة قصير. السيارة أو سيارة الأجرة مفيدة فقط إن أضفت انتقالاً إلى مسقط القديمة أو أردت تقليل المشي في الحرارة.' },
  { q: 'أين أتوقف للطعام في البرنامج؟', a: 'اجعل التوقف بعد الجزء الأول من السوق أو بعد الكورنيش، حيث تتجمّع عادةً خيارات الأكل العُماني والخليجي والبحري. اختر بحسب النظافة والقائمة والسعر وقت الزيارة دون الاعتماد على اسم بعينه.' },
  { q: 'هل البرنامج مناسب في الصيف؟', a: 'صيف مسقط حار ورطب، لذا صمّم النصف يوم على شكل فترات قصيرة متقطعة مع راحة في الظل، وابدأ مبكراً أو بعد الغروب، واحمل الماء باستمرار. راجع صفحة الزيارة في الصيف للتفاصيل.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف بالمكان وفترة الزيارة المناسبة من سبتمبر إلى مايو.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف السوق وسياقه في الواجهة البحرية وعلاقته بالميناء.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع وساعات القائمة قبل تخطيط البرنامج.' },
];

const related = [
  { href: '/itineraries/2-hour-walk/', label: 'جولة مشي ساعتين', desc: 'نسخة أقصر مركّزة على السوق والكورنيش فقط.' },
  { href: '/around/fish-market/', label: 'سوق السمك', desc: 'أفضل في الصباح؛ نقطة بداية منطقية لنصف يوم.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'إضافة الإطلالة والصعود ضمن البرنامج.' },
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'خيارات توقف الطعام حول الكورنيش.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'اختيار الصباح أو المساء بحسب الموسم.' },
];
---
<GuideLayout
  title="برنامج نصف يوم في مطرح: السوق والكورنيش والقلعة | دليل سوق مطرح"
  h1="برنامج نصف يوم في مطرح من أربع إلى خمس ساعات"
  description="برنامج نصف يوم في مطرح يجمع سوق مطرح والكورنيش وسوق السمك وقلعة مطرح مع توقف للطعام، وترتيب زمني مرن بحسب الطقس والموسم وملاحظات النقل."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">برنامج موسّع</p>
      <h2 class="display mt-3 max-w-3xl text-4xl font-black text-[#18110d] md:text-5xl">نصف يوم يجمع السوق بالميناء والقلعة</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="يختلف نصف اليوم عن جولة الساعتين في أنه يخرج من أزقة السوق إلى محيطه: سوق السمك النشِط صباحاً، وممشى الكورنيش، وإطلالة قلعة مطرح، وتوقف هادئ للطعام. الفكرة أن تتوزّع الأربع إلى خمس ساعات بين التنقل الخفيف والمشاهدة والاستراحة بدل البقاء في مكان واحد." /></p>
        <p><BidiText text="رتّبنا البرنامج في مسارين بحسب وقت البداية، ليعطيك كل مسار تجربة مختلفة مع الحفاظ على نفس العناصر. اختر المسار بحسب الموسم والطقس ووقت وصولك إلى مطرح." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">المسار الصباحي</p>
          <h3 class="mt-2 text-xl font-black text-[#18110d]">يبدأ مع نشاط السوق والميناء</h3>
          <ol class="mt-4 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الافتتاح:</b> سوق السمك في أول الصباح حيث حركة البيع أقوى.</li>
            <li><b class="text-[#18110d]">ثم:</b> دخول سوق مطرح قبل اشتداد الحرارة والازدحام.</li>
            <li><b class="text-[#18110d]">قبل الظهيرة:</b> صعود قلعة مطرح أو المشي على الكورنيش.</li>
            <li><b class="text-[#18110d]">الختام:</b> توقف للطعام قبل مغادرة مطرح.</li>
          </ol>
        </div>
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">المسار المسائي</p>
          <h3 class="mt-2 text-xl font-black text-[#18110d]">يبدأ بعد العصر وينتهي مع الأضواء</h3>
          <ol class="mt-4 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الافتتاح:</b> الكورنيش والقلعة بضوء النهار المتأخر.</li>
            <li><b class="text-[#18110d]">ثم:</b> دخول السوق عند عودة الحركة المسائية.</li>
            <li><b class="text-[#18110d]">المتعة:</b> الأزقة المسقوفة تحت الإضاءة المسائية.</li>
            <li><b class="text-[#18110d]">الختام:</b> المشي على الواجهة بعد الخروج من السوق.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
      <div>
        <p class="kicker">المرونة والمواسم</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">تكييف البرنامج مع الطقس والازدحام</h2>
        <div class="mt-5 space-y-4 text-[#58483e]">
          <p>الفترة من سبتمبر إلى مايو ألطف عموماً للتجول الطويل، بينما يجعل صيف مسقط الحار والرطب المشي الطويل متعباً؛ حينها افصل البرنامج إلى فترتين قصيرتين مع راحة في الظل.</p>
          <p>في العطلات والمناسبات يرتفع الازدحام حول الكورنيش والمداخل، لذا قدّم السوق على الكورنيش أو العكس بحسب اتجاه الحركة، واحسب وقتاً إضافياً للوصول والخروج.</p>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">ملاحظات النقل</p>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>أقرب نقطة نزول عادةً هي محيط الكورنيش والمداخل القريبة منه.</li>
            <li>المواقف قد تكون مزدحمة في الذروة؛ اترك هامشاً للبحث عن موقف.</li>
            <li>الانتقال إلى مسقط القديمة يحتاج سيارة أو سيارة أجرة قصيرة.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> لا نفترض توفّر موقف أو سعر معيّن؛ تحقّق من اللوحات وشروط الدفع المحلية في يوم الزيارة.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا معلومات هذا البرنامج في 2 نوفمبر 2026. ساعات القلعة وسوق السمك والمطاعم وأعمال الطرق حول الكورنيش قابلة للتغيير، خصوصاً في العطلات والمناسبات." /></p>
        <p>هذا البرنامج اقتراح تنظيمي من دليل مستقل وغير رسمي، ولا يمثّل جولة رسمية بمواعيد مضمونة. أكّد ما تحتاجه عبر القنوات الرسمية وخرائط جوجل قبل الانطلاق.</p>
      </div>
    </div>
  </section>
</GuideLayout>
