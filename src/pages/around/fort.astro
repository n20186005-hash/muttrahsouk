---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'قلعة مطرح' },
];

const quickFacts = [
  { label: 'ساعات الزيارة', value: 'وفق الجهة الرسمية: يومياً 8:00–23:00' },
  { label: 'رسوم الدخول', value: 'وفق الجهة الرسمية؛ فئات للمقيمين وغير المقيمين' },
  { label: 'أفضل وقت', value: 'من أكتوبر إلى أبريل، وآخر النهار' },
  { label: 'الوصول', value: 'صعود بدرجات حادّة؛ غير مناسب للجميع' },
];

const fees = [
  { group: 'المقيم البالغ', value: '1.000 ريال عماني' },
  { group: 'المقيم الطفل', value: '0.500 ريال عماني' },
  { group: 'غير المقيم البالغ', value: '3.000 ريال عماني' },
  { group: 'غير المقيم الطفل', value: '2.000 ريال عماني' },
];

const faq = [
  { q: 'ما ساعات زيارة قلعة مطرح؟', a: 'تذكر الصفحة الرسمية لوزارة التراث والسياحة أن القلعة مفتوحة يومياً من الثامنة صباحاً حتى الحادية عشرة مساءً، ويطابق ذلك الموقع الرسمي للقلعة. هذه قيم منقولة عن الجهة الرسمية ويجب تأكيدها في يوم زيارتك.' },
  { q: 'كم رسوم دخول قلعة مطرح؟', a: 'تسرد الصفحة الرسمية فئات مختلفة: نحو ريال واحد للبالغ المقيم، ونصف ريال للطفل المقيم، وثلاثة ريالات للبالغ غير المقيم، وريالان للطفل غير المقيم. الرسوم منقولة عن الجهة الرسمية وليست من تقديرنا، وتُتحقق قبل الصعود.' },
  { q: 'هل تحققت من الرسوم والساعات بنفسك؟', a: 'لا نقدّمها كتأكيد شخصي؛ بل ننسبها إلى الصفحة الرسمية لوزارة التراث والسياحة والموقع الرسمي للقلعة، مع دعوة صريحة لتأكيدها عبر القنوات الرسمية قبل الزيارة لأنها قابلة للتغيّر.' },
  { q: 'هل صعود القلعة مناسب للأطفال وكبار السن؟', a: 'يعتمد الصعود على درجات حادّة قد تكون متعبة، وتذكر الصفحة الرسمية إتاحة الوصول مع محدودية في بعض الأقسام. لذلك يجب تأكيد مدى ملاءمة المسار لاحتياجك ميدانياً أو عبر الجهة المختصة.' },
  { q: 'هل التصوير مسموح في القلعة؟', a: 'تشير الصفحة الرسمية إلى السماح بالتصوير مع مناسبة المكان للصور البانورامية والمعمارية. احترم أي لوحات إرشادية داخل الموقع واستأذن قبل تصوير الأشخاص.' },
];

const sources = [
  { label: 'Muttrah Fort', org: 'وزارة التراث والسياحة — تجربة عُمان (رسمي)', url: 'https://experienceoman.om/destinations/muscat/muttrah-fort', desc: 'ساعات الزيارة ورسوم الدخول والتاريخ المعماري للقلعة وفق الجهة الرسمية.' },
  { label: 'الموقع الرسمي لقلعة مطرح', org: 'قلعة مطرح (رسمي)', url: 'https://www.muttrahfort.om/', desc: 'يوضح أن أوقات القلعة من الثامنة صباحاً حتى الحادية عشرة مساءً يومياً.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق منطقة مطرح والسوق المجاور للقلعة.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لتقدير المسار نحو القلعة؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى البحري أسفل القلعة وأفضل أوقات التنزّه.' },
  { href: '/around/fish-market/', label: 'سوق السمك في مطرح', desc: 'النشاط الصباحي في المبنى الحديث قرب الميناء.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'كيف توازن بين الوقت المناسب وحرارة النهار.' },
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'دمج السوق والكورنيش والقلعة في جولة واحدة.' },
];
---
<GuideLayout
  title="قلعة مطرح: الساعات والرسوم والإطلالة"
  h1="قلعة مطرح: التاريخ والرسوم وطريقة الزيارة"
  description="دليل قلعة مطرح: دورها في حماية الميناء، والإطلالة على الكورنيش، وساعات الزيارة والرسوم وفق الجهة الرسمية، والصعود بالدرج، وأفضل توقيت لتفادي الحرارة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <p class="kicker">معلم تاريخي</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d]">دور القلعة في حماية الميناء</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="تقع قلعة مطرح على تلال صخرية تطلّ على الميناء القديم، وكانت تاريخياً حصناً استراتيجياً لحماية المرفأ والمدينة من الغزاة. وتذكر الجهة الرسمية أن البرتغاليين بنوها في خمسينيات القرن السادس عشر، ثم أعاد حكام اليعاربة بناءها بين عامي 1624 و1742." /></p>
            <p><BidiText text="تتميّز القلعة بثلاثة أبراج دائرية: برج مركزي كبير في القمة، وبرجان أصغر إلى الغرب والشمال، مع أسوار قوية وأفنية داخلية وتحصينات منحدرة تعكس العمارة العسكرية العُمانية التقليدية." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">الموقع والإطلالة</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="تمنح القلعة منظراً بانورامياً واسعاً على كورنيش مطرح والميناء القديم وشوارع الحي، وهي من أفضل نقاط المشاهدة في المنطقة. يتجلى جمال الموقع خاصة قبيل الغروب حين يهبط الضوء على الماء والأزقة." /></p>
            <p><BidiText text="للاستفادة من الإطلالة، اختر وقتاً معتدلاً نهاراً أو بعد العصر، وتجنّب ساعات الظهيرة الحارة خصوصاً صيفاً حين يرتفع الإحساس بالحرارة على القمة المكشوفة." /></p>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">نقاط سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الأبراج:</b> برج مركزي وبرجان جانبيان.</li>
            <li><b class="text-[#18110d]">الإطلالة:</b> الميناء والكورنيش والحي.</li>
            <li><b class="text-[#18110d]">التصوير:</b> مناسب للصور البانورامية وفق الجهة الرسمية.</li>
            <li><b class="text-[#18110d]">الجوار:</b> سوق مطرح والكورنيش قريبان.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه مهم:</b> الساعات والرسوم الواردة هنا منقولة عن الجهة الرسمية وليست تأكيداً شخصياً؛ تحقّق من القنوات الرسمية وخرائط جوجل قبل الصعود، فهي قابلة للتغيّر. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">الرسوم والساعات</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">ما تنقله الجهة الرسمية</h2>
      <p class="mt-4 max-w-3xl text-sm text-[#66574e]"><BidiText text="حسب الصفحة الرسمية لوزارة التراث والسياحة، تكون القلعة مفتوحة يومياً من الثامنة صباحاً حتى الحادية عشرة مساءً، وتُسرّد رسوم الدخول على فئات بحسب الإقامة والعمر على النحو التالي. هذه القيم منقولة عن الجهة الرسمية ويجب تأكيدها في يوم الزيارة." /></p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#176b68] text-white">
              <th class="p-4">الفئة</th>
              <th class="p-4">الرسوم (منقولة عن الجهة الرسمية)</th>
            </tr>
          </thead>
          <tbody>
            {fees.map((f) => (
              <tr class="border-b border-[#B98739]/25">
                <td class="p-4 font-black text-[#18110d]">{f.group}</td>
                <td class="p-4 text-[#58483e]"><BidiText text={f.value} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">لا نقدّم هذه الأرقام كتأكيد:</b> هي منقولة عن المصدر الرسمي وقد تتغيّر مع الوقت أو في المناسبات؛ تأكّد منها عبر القنوات الرسمية أو عند شبّاك الدخول قبل الصعود.
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="display text-3xl font-black text-[#18110d]">الصعود والدرج وحدود الوصول</h2>
        <div class="mt-4 space-y-4 text-[#58483e]">
          <p><BidiText text="تعتمد الزيارة على صعود درجات ومسارات قد تكون حادّة، وتذكر الصفحة الرسمية إتاحة الوصول لبعض الأقسام مع محدودية في أجزاء أخرى. لذلك قد يكون المسار متعباً لكبار السن أو من لديهم صعوبة في الحركة." /></p>
          <p><BidiText text="قبل التخطيط، أكّد حالة المسار وملاءمته لاحتياجك ميدانياً أو عبر الجهة المختصة، وارتدِ حذاءً مريحاً، وحمّل معك ماءً كافياً وواقي شمس. هذه تفاصيل متغيّرة ولا نضمن إتاحة كاملة للجميع." /></p>
        </div>
      </div>
      <div>
        <h2 class="display text-3xl font-black text-[#18110d]">الحرارة وقت الظهيرة</h2>
        <div class="mt-4 space-y-4 text-[#58483e]">
          <p><BidiText text="بما أن القلعة مكشوفة على قمة مرتفعة، يشتدّ الإحساس بالحرارة وقت الظهيرة، خاصة بين يونيو وأغسطس. الأنسب الزيارة صباحاً مبكراً أو في آخر النهار حين يلطف الجو." /></p>
          <p><BidiText text="تجد على القمة بعض مواضع الاستراحة وفق الجهة الرسمية، لكن الظل قد يكون محدوداً؛ لذا خذ فترات راحة قصيرة وترطيباً كافياً، وتجنّب الوقوف الطويل تحت الشمس المباشرة." /></p>
        </div>
      </div>
    </div>
  </section>
</GuideLayout>
