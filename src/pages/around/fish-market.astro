---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'سوق السمك' },
];

const quickFacts = [
  { label: 'الموقع', value: 'غرب كورنيش مطرح قرب الميناء' },
  { label: 'أفضل توقيت', value: 'الصباح الباكر عند ذروة النشاط' },
  { label: 'المبنى', value: 'مبنى حديث حلّ محل السوق القديم' },
  { label: 'الأنواع', value: 'أسماك متنوعة بحسب الموسم' },
];

const faq = [
  { q: 'أين يقع سوق السمك في مطرح؟', a: 'يقع على الواجهة البحرية غرب كورنيش مطرح قرب الميناء، على مسافة مشي قصيرة من سوق مطرح. استخدم رابط الخريطة لتحديد المدخل المقصود.' },
  { q: 'ما أفضل وقت لزيارة سوق السمك؟', a: 'الصباح الباكر هو الأنسب لمشاهدة ذروة النشاط ووصول الصيد، وقبل اشتداد الحرارة. بعد ذلك يهدأ السوق تدريجياً، وقد تنتهي الكميات الأجود مبكراً.' },
  { q: 'هل يمكن التصوير في سوق السمك؟', a: 'إن أردت تصوير الأشخاص أو الباعة فاستأذنهم أولاً واحترم الرفض. تجنّب سدّ الممرات وتعطيل حركة البيع، ولا تصوّر عن قرب دون موافقة.' },
  { q: 'هل توجد رسوم دخول لسوق السمك؟', a: 'لم نجد في المصادر التي اطّلعنا عليها إشارة إلى تعريفة دخول منشورة لزيارة السوق. إن ظهرت أي رسوم فهي غير مؤكدة وتجب مراجعتها ميدانياً أو عبر الجهة المختصة.' },
  { q: 'هل أستطيع شراء السمك للطهي؟', a: 'نعم، السوق مخصّص للبيع للأفراد والمطاعم والتجّار، ويمكن الشراء للطهي المنزلي، لكن تحقّق من النظافة والتخزين، وانقل السمك سريعاً في جو بارد.' },
];

const sources = [
  { label: 'Muttrah Fish Market', org: 'Snøhetta (الجهة المصمّمة)', url: 'https://old.snohetta.com/projects/359-muttrah-fish-market', desc: 'وصف المبنى الحديث: تصميم يتسع لأكثر من مئة بائع، وحلّ محل سوق يعود إلى الستينيات، والعميل بلدية مسقط.' },
  { label: 'بلدية مسقط', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/', desc: 'الجهة البلدية المرتبطة بمرفق السوق وفق الجهة المصمّمة.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق محافظة مسقط وواجهتها البحرية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لتحديد المسار نحو السوق والميناء؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/food/seafood/', label: 'مطاعم السمك في مطرح', desc: 'الطزاجة وأطباق السمك وصلتها بسوق السمك.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى البحري الذي يصل السوق بالميناء.' },
  { href: '/souq/wholesale-vs-main/', label: 'سوق الجملة والسوق التقليدي', desc: 'الفرق بين القسم التجاري والقسم الموجّه للزوار.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'كيف توازن بين النشاط الصباحي وحرارة النهار.' },
];
---
<GuideLayout
  title="سوق السمك في مطرح: النشاط الصباحي وطريقة الزيارة"
  h1="سوق السمك في مطرح: مبنى حديث ونشاط صباحي"
  description="دليل سوق السمك في مطرح: المبنى الحديث قرب الميناء، والنشاط الصباحي والمواعيد، وما يمكن مشاهدته، وآداب التصوير وسؤال الباعة، والربط بالمطاعم القريبة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <p class="kicker">الميناء والحياة اليومية</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d]">المبنى الحديث قرب الميناء</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="يقع سوق السمك على الواجهة البحرية في قلب مطرح، في مبنى حديث صُمّم ليكون نقطة لقاء ومركزاً لصناعة الصيد في المنطقة. وقد حلّ هذا المبنى محلّ سوق قديم يعود إلى الستينيات، ليمنح المكان مساحة أوسع ومنظماً أفضل." /></p>
            <p><BidiText text="وفق الجهة المصمّمة، تبلغ مساحة المبنى نحو 4,000 متر مربع، ويتسع لأكثر من مئة بائع ومقطّع للسمك، مع مرافق للتخزين والتبريد ومساحات للبيع وأخرى مخصّصة للجمهور." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">نشاط الصباح والتوقيت</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="يبلغ السوق ذروة نشاطه في الصباح الباكر حين يصل الصيد المتنوّع من القوارب، فتزدحم حركة البيع بين التجّار والأفراد والمطاعم. هذا هو الوقت الأمثل لمشاهدة الحياة اليومية للميناء قبل أن تهدأ الحركة." /></p>
            <p><BidiText text="تختلف الأجواء بحسب الأيام والمواسم؛ فبعض المواسم يزيد فيها حجم الصيد وتنوّعه. ونظراً لتغيّر أوقات النشاط، تحقّق ميدانياً في يوم زيارتك بدلاً من الاعتماد على توقيت ثابت." /></p>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">ما يمكن مشاهدته</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><BidiText text="حركة البيع والمقطّعين في صالة السوق." /></li>
            <li><BidiText text="الأسماك المتنوعة المعروضة طازجة." /></li>
            <li><BidiText text="قسم الخضروات والفواكه المجاور." /></li>
            <li><BidiText text="باعة ومنطقة جلوس علوية وفق المبنى." /></li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه للتحقق:</b> أوقات النشاط وأيامه ووجود أي رسوم غير مؤكدة وتتغيّر؛ تحقّق ميدانياً أو عبر الجهة المختصة. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-10 lg:grid-cols-2">
      <div class="card rounded-3xl p-6">
        <h2 class="display text-2xl font-black text-[#18110d]">آداب التصوير وسؤال الباعة</h2>
        <div class="mt-4 space-y-4 text-sm text-[#58483e]">
          <p><BidiText text="السوق مكان عمل حيّ لا معرض، لذلك من الأدب أن تستأذن قبل تصوير الأشخاص أو الباعة، وأن تتقبّل الرفض بصدر رحب. تجنّب الاقتراب الشديد أو استخدام الفلاش في وجوه العاملين." /></p>
          <p><BidiText text="احرص على عدم سدّ الممرات أو تعطيل حركة البيع، واسأل بأدب عن أي شيء تريد معرفته عن الأسماك أو طريقة الشراء. هذا يحفظ لك تجربة مريحة وللأهل هناك احتراماً لخصوصيتهم." /></p>
        </div>
      </div>
      <div class="card rounded-3xl p-6">
        <h2 class="display text-2xl font-black text-[#18110d]">الربط بالمطاعم القريبة</h2>
        <div class="mt-4 space-y-4 text-sm text-[#58483e]">
          <p><BidiText text="قرب السوق من الميناء يجعل المطاعم المجاورة وجهة طبيعية لتناول المأكولات البحرية الطازجة. يمكن دمج جولة صباحية في السوق مع وجبة غداء بحرية قريبة." /></p>
          <p><BidiText text="المشوار قصير سيراً من سوق مطرح نحو الكورنيش ثم إلى السوق؛ لذا يمكن ترتيب الجولة بالترتيب: السوق التقليدي، ثم الكورنيش، ثم سوق السمك، ثم وجبة قريبة." /></p>
        </div>
      </div>
    </div>
  </section>
</GuideLayout>
