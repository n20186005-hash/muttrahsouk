---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'مسقط القديمة' },
];

const quickFacts = [
  { label: 'المسافة من مطرح', value: 'نحو 3 كم شرق السوق على الطريق الساحلي' },
  { label: 'الانتقال', value: 'سيارة أو سيارة أجرة قصيرة، والمشي خيار أطول' },
  { label: 'مشاهدة داخلية', value: 'المتحف الوطني وبيت الزبير (تحقّق من الساعات)' },
  { label: 'مشاهدة خارجية', value: 'قصر العلم وحصنا الجلالي والميراني' },
];

const sections = [
  {
    heading: 'الانتقال القصير من مطرح إلى مسقط القديمة',
    body: [
      'تفصل مسقط القديمة عن مطرح مسافة قصيرة على الطريق الساحلي تُقدّر بنحو ثلاثة كيلومترات شرقاً. الانتقال الأسهل بالسيارة أو سيارة الأجرة، ويستغرق دقائق في غير أوقات الزحام. المشي ممكن على الكورنيش لكنه أطول وأقل راحة في الحرارة والرطوبة.',
      'من العملي أن تجعل مسقط القديمة محطة تالية مباشرةً بعد جولة السوق، لأن المسار بين الاثنين لا يحتاج التواءً طويلاً. خصّص لها ساعتين إلى ثلاث ساعات لتغطية الوقفات الأساسية بلا استعجال.',
    ],
  },
  {
    heading: 'قصر العلم والحصون: المشاهدة من الخارج',
    body: [
      'قصر العلم مقر تشريفي رسمي وغير مفتوح للزوار من الداخل، لكن الساحة الأمامية والممشى المحيط به عامان ومتاحان للمشاهدة والتصوير. يجذب الأنظار الواجهة البيضاء والأعمدة المزركشة باللونين الأزرق والذهبي.',
      'يحيط بالقصر حصنان تاريخيان: الجلالي والميراني، وهما يُشاهدان من الخارج فقط وفق المصادر المتاحة؛ فالمصادر تذكر أن الجلالي لا يُعد مفتوحاً للزوار. أفضل زوايا المشاهدة على الطريق الساحلي المحيط بالميناء الصغير، ويمكن دمج الحصنين مع القصر في وقفة واحدة قصيرة.',
    ],
  },
  {
    heading: 'المتحف الوطني وبيت الزبير: الزيارة الداخلية',
    body: [
      'المتحف الوطني هو الوجهة المتحفية الأبرز في مسقط القديمة، ويقدّم عرضاً لتاريخ عُمان وحضارتها. تسرد القناة الرسمية ساعات العمل بأنها من العاشرة صباحاً حتى الخامسة مساءً مع إغلاق شبّاك التذاكر قبلها بقليل، وقد تختلف التوقيتات في الجُمَع والعطلات والمناسبات.',
      'بيت الزبير متحف تراثي خاص في مبنى تقليدي يعرض مقتنيات عُمانية من بينها أسلحة ومنسوجات ومقتنيات بحرية. تذكر المواد الرسمية للمؤسسة ساعات نهارية من السبت إلى الخميس مع توقيتات خاصة في العطلات ورمضان، ورسم دخول رمزي ودخول مجاني لصغار السن. تُراجَع الساعات والرسوم الحالية من الموقع الرسمي مباشرةً.',
    ],
  },
];

const halfDay = [
  { t: 'المحطة الأولى', what: 'الانتقال من مطرح إلى مسقط القديمة بالسيارة أو سيارة الأجرة.' },
  { t: 'المحطة الثانية', what: 'وقفة قصيرة أمام قصر العلم والتصوير من الساحة العامة.' },
  { t: 'المحطة الثالثة', what: 'مشاهدة حصني الجلالي والميراني من الخارج على الطريق الساحلي.' },
  { t: 'المحطة الرابعة', what: 'زيارة المتحف الوطني مع التحقق من الساعات ووقت الإغلاق.' },
  { t: 'المحطة الخامسة', what: 'زيارة بيت الزبير إن كان الوقت والإغلاق يسمحان بذلك.' },
  { t: 'العودة', what: 'رجوع إلى مطرح أو مواصلة بقية اليوم في المنطقة بحسب الوقت.' },
];

const faq = [
  {
    q: 'هل يمكن دخول قصر العلم؟',
    a: 'لا. القصر مقر تشريفي رسمي وغير مفتوح للزوار من الداخل، لكن الساحة والممشى الأمامي عامان ومتاحان للمشاهدة والتصوير من الخارج.',
  },
  {
    q: 'هل حصنا الجلالي والميراني مفتوحان للزوار؟',
    a: 'وفق المصادر المتاحة يُشاهَد الحصنان من الخارج فقط، ويُذكر أن الجلالي لا يُعد مفتوحاً للزيارة. تحقق من الجهات المختصة إن أردت معلومة محدّثة.',
  },
  {
    q: 'ما ساعات المتحف الوطني؟',
    a: 'تسرد القناة الرسمية ساعات من العاشرة صباحاً حتى الخامسة مساءً مع إغلاق شبّاك التذاكر قبلها بقليل. قد تختلف التوقيتات في الجُمَع والعطلات والمناسبات، فتحقق قبل الانطلاق.',
  },
  {
    q: 'كم تبعد مسقط القديمة عن سوق مطرح؟',
    a: 'نحو ثلاثة كيلومترات شرق السوق على الطريق الساحلي، وتستغرق الرحلة بالسيارة دقائق في غير أوقات الزحام، ويمكن المشي لكنه أطول وأكثر مشقّة في الحرارة.',
  },
  {
    q: 'هل توجد رسوم دخول؟',
    a: 'تتفاوت الرسوم بين المعالم، فبعضها مجاني للتنزّه في الساحات، وبعضها يرسم دخولاً رمزياً. لا نؤكد أي سعر هنا، ويجب التحقق من الرسوم الحالية لكل معلم على حدة.',
  },
];

const sources = [
  {
    label: 'المتحف الوطني — ساعات العمل',
    org: 'المتحف الوطني (رسمي)',
    url: 'https://www.nm.gov.om/en/working-hours',
    desc: 'المرجع الرسمي لساعات الزيارة وإغلاق شبّاك التذاكر في مسقط القديمة.',
  },
  {
    label: 'بيت الزبير — الموقع الرسمي',
    org: 'مؤسسة بيت الزبير (رسمي)',
    url: 'https://www.baitalzubair.com/',
    desc: 'القناة الرسمية للمتحف التراثي في مسقط القديمة وساعاته وتذاكره.',
  },
  {
    label: 'Muscat Old Town and Mutrah: A Practical Guide',
    org: 'Oman Unlock',
    url: 'https://omanunlock.com/muscat-old-town-guide/',
    desc: 'وصف عملي لجغرافية مسقط القديمة ومطرح ومسافة الانتقال بينهما.',
  },
  {
    label: 'تجربة عُمان — محافظة مسقط',
    org: 'وزارة التراث والسياحة (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat',
    desc: 'سياق رسمي عام لمعالم محافظة مسقط ومنها مسقط القديمة.',
  },
];

const related = [
  { href: '/around/place-people-museum/', label: 'متحف المكان والناس', desc: 'حالة غير مؤكدة وبدائل مؤكدة في مسقط القديمة.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'نقطة البداية على الواجهة البحرية قبل المغادرة.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'معلم مطرح المطل على الميناء.' },
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'دمج السوق والمنطقة المحيطة في برنامج واحد.' },
];
---
<GuideLayout
  title="من مطرح إلى مسقط القديمة: قصر العلم والمتاحف | دليل سوق مطرح"
  h1="من مطرح إلى مسقط القديمة: قصر العلم والحصون والمتاحف"
  description="الانتقال القصير من سوق مطرح إلى مسقط القديمة: قصر العلم والحصنان من الخارج، والمتحف الوطني وبيت الزبير، مع تنبيه لتفاوت الساعات والرسوم."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">لمحة سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">المسافة:</b> نحو <bdi dir="ltr">3</bdi> كم شرق مطرح.</li>
            <li><b class="text-[#18110d]">الوقت المقترح:</b> ساعتان إلى ثلاث ساعات.</li>
            <li><b class="text-[#18110d]">الأفضل للتأخير:</b> تجنّب الظهيرة صيفاً.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة التحقق:</b> روجعت المعلومات بتاريخ <bdi dir="ltr">2 نوفمبر 2026</bdi>؛ ساعات المتاحف والرسوم قابلة للتغيير، فأكّدها من القنوات الرسمية قبل الانطلاق.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell">
      <p class="text-sm font-bold text-[#F6D98C]">ترتيب مقترح</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">نصف يوم من مطرح إلى مسقط القديمة</h2>
      <p class="mt-5 max-w-3xl text-[#d8eee9]">هذا الترتيب يفترض أنك بدأت من مطرح في الصباح أو بعد العصر؛ وهو مرن بحسب ساعات المتاحف وحالة الازدحام.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {halfDay.map((s) => (
          <div class="rounded-3xl border border-white/15 bg-black/15 p-5">
            <p class="text-xs font-black text-[#F6D98C]">{s.t}</p>
            <p class="mt-2 text-[#e6f2ef]"><BidiText text={s.what} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</GuideLayout>
