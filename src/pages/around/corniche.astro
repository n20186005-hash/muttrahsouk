---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'كورنيش مطرح' },
];

const quickFacts = [
  { label: 'الموقع', value: 'الواجهة البحرية بمطرح' },
  { label: 'العلاقة بالسوق', value: 'مشي قصير إلى مداخل السوق' },
  { label: 'مناسب لـ', value: 'العائلات والمشي والتصوير' },
  { label: 'أفضل الأوقات', value: 'الصباح الباكر والمساء' },
];

const sections = [
  {
    heading: 'الممشى البحري وعلاقته بالسوق والميناء',
    body: [
      'كورنيش مطرح هو الممشى البحري الممتد على واجهة مطرح، ويجاور سوق مطرح والميناء في المشهد نفسه. هذا التجاور يجعل الكورنيش النقطة الطبيعية للبدء أو الإنهاء: تمشي على الواجهة ثم تدخل السوق، أو تتسوّق أولاً ثم تستريح على البحر.',
      'تذكر المصادر الرسمية أن السوق يقع على الواجهة البحرية من جانب مدينة مطرح، وهذا يعني أن العلاقة بين الكورنيش والسوق ليست علاقة جوار عابرة، بل جزء من هوية المكان الواحدة.',
    ],
  },
  {
    heading: 'إطلالات القوارب والسفن',
    body: [
      'من الكورنيش يمكن مشاهدة حركة الميناء: قوارب تقليدية وسفن على الواجهة، ومشهد بحري يتغير بحسب الوقت. هذا المشهد هو ما يجعل الممشى مناسباً للتصوير وللتأمل، ويمنح الزيارة بعداً بصرياً لا نجده داخل الأزقة المسقوفة.',
      'المشهد يختلف صباحاً ومساءً: في الصباح ضوء ناعم وحركة هادئة، وفي المساء إضاءة دافئة وانعكاسات على الماء. جرّب النظر إلى الميناء من زوايا مختلفة على امتداد الممشى.',
    ],
  },
  {
    heading: 'أماكن الجلوس والراحة',
    body: [
      'على امتداد الكورنيش توجد مساحات للتنزّه والجلوس، ما يجعله مكاناً مناسباً لالتقاط الأنفاس بين جولتين أو للاستراحة بعد المشي في السوق. كما تشمل أعمال تطوير السوق إضافة كراسي وإنارة داخلية للممرات، ما يعكس اهتماماً عاماً بمناطق الراحة.',
      'بما أن الكورنيش مفتوح، فهو يفيد أيضاً كمساحة انتظار لأفراد المجموعة الذين يفضّلون الجلوس بدلاً من الاستمرار في التسوّق.',
    ],
  },
  {
    heading: 'مناسب للعائلات',
    body: [
      'الواجهة البحرية بمساحتها المفتوحة تجعل الكورنيش خياراً مريحاً للعائلات مع الأطفال، إذ يمكنهم التحرك واللعب في مساحة أوسع مما هو متاح داخل الأزقة الضيقة. هذا لا يعني أن الكورنيش أعيد تصميمه كملعب، بل إن طبيعته المفتوحة تمنح مرونة أكبر.',
      'مع ذلك، يجب الانتباه للأطفال قرب حافة الماء والطرق القريبة، خصوصاً في أوقات الازدحام. اجعل يد الطفل قريبة وحدّد نقطة تجمّع واضحة.',
    ],
  },
  {
    heading: 'أفضل الأوقات للزيارة',
    body: [
      'الصباح الباكر من ألطف الأوقات للمشي على الكورنيش، خصوصاً في الأشهر الحارة، لأن الحرارة لم تشتد بعد. أما المساء فهو وقت اجتماعي وإضاءة جميلة، لكنه أكثر ازدحاماً خصوصاً في العطلات والمناسبات.',
      'الفترة الأمثل قد تكون وقت الغروب، حين يلطُف الجو ويتحوّل ضوء الواجهة إلى مشهد دافئ. راجع صفحة أفضل وقت للزيارة لموازنة الخيارات بحسب الموسم.',
    ],
  },
  {
    heading: 'الربط سيراً بالقلعة وسوق السمك',
    body: [
      'من الكورنيش يمكن ترتيب جولة سيراً تربط عدة معالم: القلعة المطلة على الميناء، وسوق السمك القريب، وسوق مطرح نفسه. المسافات بينها قصيرة عادةً، ما يسمح بدمجها في جولة واحدة ضمن نصف يوم.',
      'هذا الترتيب مفيد لأنه يوزّع الزيارة بين المشي في الهواء الطلق والدخول إلى الأسواق المسقوفة، فتقلّ فترات الجهد المتواصل وتتنوّع التجربة.',
    ],
  },
];

const faq = [
  { q: 'أين يقع كورنيش مطرح؟', a: 'يمتد على الواجهة البحرية لمطرح، مجاوراً لسوق مطرح والميناء، ويصلح كنقطة بدء أو إنهاء لزيارة السوق.' },
  { q: 'هل يمكن الجمع بين السوق والكورنيش؟', a: 'نعم، المسافة بينهما مشي قصير عادةً؛ يمكنك المشي على الواجهة ثم الدخول إلى السوق أو العكس.' },
  { q: 'هل الكورنيش مناسب للعائلات؟', a: 'طبيعته المفتوحة تجعله مناسباً للعائلات والأطفال، مع الانتباه قرب حافة الماء والطرق وأوقات الازدحام.' },
  { q: 'ما أفضل وقت للمشي على الكورنيش؟', a: 'الصباح الباكر من الأوقات الألطف، والمساء أكثر حيوية، ووقت الغروب يجمع بين لطف الجو وجمال الضوء.' },
  { q: 'هل يمكن زيارة القلعة وسوق السمك من الكورنيش؟', a: 'نعم، المعالم قريبة عادةً ويمكن ربطها سيراً ضمن جولة واحدة، مع التحقق من ساعات القلعة قبل الصعود.' },
];

const sources = [
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق عام لمحافظة مسقط وموقع مطرح على الواجهة البحرية.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'يصف موقع السوق على الواجهة البحرية وأعمال التطوير المحيطة.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة المكان لتقدير مسار المشي بين الكورنيش والمداخل.' },
];

const related = [
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'المعلم التاريخي المطل على الميناء والكورنيش.' },
  { href: '/around/fish-market/', label: 'سوق السمك في مطرح', desc: 'نشاط الصباح قرب الميناء وأدب التصوير.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'كيف ارتبط السوق بالميناء والواجهة البحرية.' },
  { href: '/itineraries/sunset-photo/', label: 'التصوير والغروب في مطرح', desc: 'أفضل توقيتات الضوء على الواجهة البحرية.' },
];
---
<GuideLayout
  title="كورنيش مطرح: الممشى البحري والإطلالات ونصائح الزيارة | دليل سوق مطرح"
  h1="كورنيش مطرح: الممشى البحري"
  description="كورنيش مطرح: الممشى البحري وعلاقته بسوق مطرح والميناء، وإطلالات القوارب، وأماكن الجلوس، وملاءمته للعائلات، وأفضل أوقات المشي وربطه بالقلعة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">حول السوق</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">واجهة بحرية… بمحاذاة السوق</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="كورنيش مطرح هو المساحة المفتوحة المقابلة لسوق مطرح، حيث يلتقي المشي بالبحر بالميناء. يمنحك هذا الممشى تجربة مكمّلة للزيارة: بعد الأزقة الضيقة والظل، تخرج إلى الهواء والضوء والمساحة الواسعة." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">المشي</b>
          <p class="mt-3 text-sm text-[#66574e]">مسار ممتد على الواجهة يناسب المشي الهادئ والاسترخاء.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الإطلالات</b>
          <p class="mt-3 text-sm text-[#66574e]">مشهد القوارب وحركة الميناء يمنح المشي بعداً بصرياً.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الراحة</b>
          <p class="mt-3 text-sm text-[#66574e]">مساحات للجلوس والتنزّه تشكّل محطة راحة بين جولتين.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الربط</b>
          <p class="mt-3 text-sm text-[#66574e]">نقطة انطلاق سيراً نحو السوق والقلعة وسوق السمك.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">ترتيب مقترح لزيارة الكورنيش</p>
          <ol class="mt-3 list-decimal space-y-2 pr-5 text-sm text-[#66574e]">
            <li>ابدأ مشياً على الواجهة البحرية.</li>
            <li>توقّف عند إطلالة على القوارب والميناء.</li>
            <li>ادخل السوق من المدخل القريب من الكورنيش.</li>
            <li>اختم بالجلوس على الواجهة للراحة.</li>
          </ol>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> أعمال التطوير والصيانة المحيطة بالواجهة قد تغيّر المسارات أو مناطق الجلوس. تحقّق ميدانياً عند الوصول، وتحقق من ساعات أي معلم قبل دمجه في الجولة.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
