---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'متحف المكان والناس' },
];

const quickFacts = [
  { label: 'الموقع', value: 'مطرح، بمحاذاة قلعة مطرح' },
  { label: 'المبنى', value: 'مجموعة من البيوت العُمانية القديمة' },
  { label: 'الموضوع', value: 'الحياة اليومية العُمانية من خمسينيات القرن الماضي إلى منتصف السبعينيات' },
  { label: 'حالة التشغيل', value: 'غير مؤكدة — تحقّق قبل الزيارة' },
];

const sections = [
  {
    heading: 'قبل أن تُخطّط: حالة المتحف غير مؤكدة',
    body: [
      'متحف المكان والناس معلم ثقافي في مطرح، لكن حالة تشغيله الحالية وساعات الزيارة والرسوم — إن وُجدت — غير مؤكدة. نكتب هذه الصفحة كتنبيه للتحقق لا كدليل مؤكد للزيارة، وننصح بمراجعة الجهة المختصة قبل تخصيص وقت له.',
      'سبب عدم الجزم واضح: تقرير صحفي في عُمان بتاريخ 19 مايو 2026 أفاد بأن المتحف كان يخضع لسلسلة من أعمال التطوير والصيانة والتجديد الشاملة، وأنه سيستقبل زواره «بحلّة جديدة» عقب انتهاء الأعمال. لذلك لا يمكن تأكيد ما إذا كانت أبوابه مفتوحة فعلاً في يوم زيارتك.',
    ],
  },
  {
    heading: 'ما هو متحف المكان والناس؟',
    body: [
      'يقع المتحف في ولاية مطرح بمحاذاة قلعة مطرح، ويتكوّن من مجموعة من البيوت العُمانية القديمة، وهو ما يمنح الزيارة طابعاً منزلياً وضواحياً بدلاً من طابع صالة العرض الحديثة. هذا الطابع المعماري هو ما يجعل موقع المبنى نفسه جزءاً من التجربة.',
      'تشير المصادر المتاحة إلى أن المتحف أُسّس عام 2011 بمبادرة من صاحبة السمو السيدة الدكتورة غالية بنت فهر بن تيمور آل سعيد، وأنه يوثّق تفاصيل الحياة اليومية العُمانية خلال الفترة الممتدة من خمسينيات القرن الماضي حتى منتصف السبعينيات، من خلال فضاءات منزلية تعكس الحياة الاجتماعية وتحوّلات تلك الحقبة.',
    ],
  },
  {
    heading: 'لماذا تتعارض المصادر حول الحالة؟',
    body: [
      'بعض المواقع الوسيطة وبعض الصفحات القديمة تذكر ساعات زيارة ورسوماً تقديرية للمتحف، لكنها تعود إلى فترات سابقة وإلى تسمية أقدم للمكان، ولا تعكس بالضرورة وضعه بعد أعمال التطوير المذكورة. لهذا نتجنّب في هذه الصفحة تأكيد أي ساعة أو سعر، ونكتبها جميعاً كغير مؤكدة.',
      'القاعدة العملية: لا تبنِ خطتك على رقم ساعات أو رسوم مأخوذ من موقع وسيط أو من صفحة قديمة. تحقّق من الجهة المختصة مباشرةً في يوم الزيارة، أو اختر بديلاً مؤكداً حتى تتضح الحالة.',
    ],
  },
];

const alternatives = [
  {
    name: 'المتحف الوطني',
    text: 'يقع في مسقط القديمة، وتُسرد ساعات العمل على موقعه الرسمي بأنها من العاشرة صباحاً حتى الخامسة مساءً مع إغلاق شبّاك التذاكر قبل ذلك بقليل. التوقيتات الخاصة بالجُمَع والعطلات والمناسبات تُراجَع من نفس القناة الرسمية قبل الانطلاق.',
  },
  {
    name: 'بيت الزبير',
    text: 'متحف تراثي خاص في مسقط القديمة يعرض مقتنيات عُمانية في مبنى تقليدي. تذكر المواد الرسمية للمؤسسة ساعات نهارية من السبت إلى الخميس وتوقيتات خاصة في العطلات ورمضان، مع وجود رسم دخول رمزي ودخول مجاني للأطفال الصغار. تُراجَع الساعات والرسوم الحالية من الموقع الرسمي.',
  },
];

const verifySteps = [
  'ابحث عن القناة الرسمية أو صفحة الجهة المشغّلة للمتحف واحتفظ بالتاريخ الذي راجعت فيه المعلومة.',
  'اتصل أو راسل الجهة للتأكد من حالة الفتح الحالية وساعات الزيارة قبل تخصيص وقت لها.',
  'إن لم تحصل على تأكيد واضح، اعتبر المتحف غير جاهز للزيارة ووجّه وقتك إلى بديل مؤكد في مسقط القديمة.',
  'عند الوصول إلى مطرح، يمكنك المرور قرب موقع المتحف بمحاذاة قلعة مطرح للاستفسار ميدانياً، دون افتراض أنه مفتوح.',
];

const faq = [
  {
    q: 'هل متحف المكان والناس مفتوح الآن؟',
    a: 'لا يمكن تأكيد الحالة من المصادر المتاحة. أفادت تغطية صحفية في 19 مايو 2026 بأن المتحف يخضع لأعمال تطوير وتجديد شاملة وأنه سيُعاد افتتاحه عقب انتهائها. راجع الجهة المختصة قبل التخطيط للزيارة.',
  },
  {
    q: 'ما الذي يعرضه المتحف؟',
    a: 'وفق المصادر، يوثّق المتحف الحياة اليومية العُمانية من خمسينيات القرن الماضي إلى منتصف السبعينيات داخل فضاءات منزلية في مجموعة من البيوت العُمانية القديمة بمحاذاة قلعة مطرح.',
  },
  {
    q: 'كم تبلغ رسوم الدخول؟',
    a: 'بعض المواقع الوسيطة تذكر رسوماً تقديرية، لكنها غير رسمية وقد تكون قديمة. لا نؤكد أي سعر في هذه الصفحة، ويجب التحقق من الرسوم الحالية — إن وُجدت — قبل الزيارة.',
  },
  {
    q: 'ما البدائل المؤكدة القريبة؟',
    a: 'خياران موثّقان في مسقط القديمة: المتحف الوطني وبيت الزبير. تفاصيل الانتقال والساعات متاحة في صفحة مسقط القديمة على هذا الدليل.',
  },
  {
    q: 'أين يقع المتحف بالنسبة إلى السوق؟',
    a: 'يقع في حي مطرح بمحاذاة قلعة مطرح، على مسافة قصيرة من سوق مطرح وكورنيش مطرح، ويمكن دمجه ضمن جولة في المنطقة عند التأكد من حالة الفتح.',
  },
];

const sources = [
  {
    label: 'متحف «المكان والناس» يستعيد ذاكرة المكان بحلّة جديدة',
    org: 'صحيفة عمان',
    url: 'https://www.omandaily.om/%D8%AB%D9%82%D8%A7%D9%81%D8%A9/na/%D9%85%D8%AA%D8%AD%D9%81-%D8%A7%D9%84%D9%85%D9%83%D8%A7%D9%86-%D9%88%D8%A7%D9%84%D9%86%D8%A7%D8%B3-%D9%8A%D8%B3%D8%AA%D8%B9%D9%8A%D8%AF-%D8%B0%D8%A7%D9%83%D8%B1%D8%A9-%D8%A7%D9%84%D9%85%D9%83%D8%A7%D9%86-%D8%A8%D8%AD%D9%84%D8%A9-%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9-%D8%AA%D8%AD%D8%A7%D9%81%D8%B8-%D8%B9%D9%84%D9%89-%D8%B1%D9%88%D8%AD-%D8%A7%D9%84%D8%B9%D9%85%D8%A7%D8%B1%D8%A9-%D8%A7%D9%84%D8%B9%D9%85%D8%A7%D9%86%D9%8A%D8%A9',
    desc: 'تقرير بتاريخ 19 مايو 2026 عن أعمال التطوير والصيانة وانتظار إعادة الافتتاح بمحاذاة قلعة مطرح.',
  },
  {
    label: 'Place and People Museum — نبذة المكان',
    org: 'Ryo',
    url: 'https://ryo.co/en/destinations/oman/places/place-and-people-museum',
    desc: 'نبذة عن الموقع عند سفح قلعة مطرح وتأسيسه عام 2011 وفكرته حول الحياة اليومية العُمانية.',
  },
  {
    label: 'المتحف الوطني — ساعات العمل',
    org: 'المتحف الوطني (رسمي)',
    url: 'https://www.nm.gov.om/en/working-hours',
    desc: 'المرجع الرسمي لساعات زيارة المتحف الوطني في مسقط القديمة؛ راجعها قبل الانطلاق.',
  },
  {
    label: 'بيت الزبير — الموقع الرسمي',
    org: 'مؤسسة بيت الزبير (رسمي)',
    url: 'https://www.baitalzubair.com/',
    desc: 'القناة الرسمية للمتحف البديل في مسقط القديمة، ومنها تُراجَع الساعات والرسوم والتذاكر.',
  },
];

const related = [
  { href: '/around/old-muscat/', label: 'مسقط القديمة', desc: 'المتحف الوطني وبيت الزبير، البديلان المؤكدان.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'المعلم المجاور مباشرةً لموقع المتحف.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'ممشى الواجهة البحرية القريب من المتحف.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'سياق تاريخي أوسع لمنطقة مطرح ومينائها.' },
];
---
<GuideLayout
  title="متحف المكان والناس في مطرح: حالة التشغيل وبدائل مؤكدة | دليل سوق مطرح"
  h1="متحف المكان والناس في مطرح: ما نعرفه وما يجب التحقق منه"
  description="دليل حذر لمتحف المكان والناس بجانب قلعة مطرح: حالة التشغيل والساعات غير مؤكدة، مع بدائل مؤكدة في مسقط القديمة هما المتحف الوطني وبيت الزبير."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="rounded-3xl border border-[#B98739]/40 bg-[#fffaf0] p-6">
          <p class="text-xs font-black text-[#176b68]">تنبيه أساسي</p>
          <p class="mt-3 text-sm text-[#66574e]">حالة التشغيل وساعات الزيارة والرسوم غير مؤكدة. لا تبنِ خطتك على ساعات أو أسعار منشورة على مواقع وسيطة أو صفحات قديمة.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">ما هو مؤكد</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الموقع:</b> مطرح، بمحاذاة قلعة مطرح.</li>
            <li><b class="text-[#18110d]">الطابع:</b> مجموعة بيوت عُمانية قديمة.</li>
            <li><b class="text-[#18110d]">الموضوع:</b> الحياة اليومية العُمانية من الخمسينيات إلى منتصف السبعينيات.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#f7f0df] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة التحقق:</b> روجعت المعلومات المتاحة بتاريخ <bdi dir="ltr">2 نوفمبر 2026</bdi>، ولا تزال الحالة المتغيرة بحاجة إلى تأكيد من الجهة المختصة قبل الزيارة.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">إن لم يتأكد المتحف</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">بدائل مؤكدة في مسقط القديمة</h2>
      <p class="mt-5 max-w-3xl text-[#58483e]">بدلاً من تعليق خطتك على معلم غير مؤكد، يمكنك توجيه الوقت إلى معلمين موثّقين في مسقط القديمة على مسافة انتقال قصيرة من مطرح. تفاصيل المسار في صفحة مسقط القديمة.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {alternatives.map((a) => (
          <article class="card rounded-3xl p-6">
            <h3 class="text-xl font-black text-[#18110d]">{a.name}</h3>
            <p class="mt-3 text-[#66574e]"><BidiText text={a.text} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="kicker">قبل الحجز</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">كيف تتحقق من حالة المتحف</h2>
        <p class="mt-4 text-[#58483e]">اتبع هذه الخطوات بالترتيب؛ فخطوة تحقق واحدة توفّر عليك رحلة قد لا تجد فيها المبنى مفتوحاً.</p>
      </div>
      <ol class="grid content-start gap-4">
        {verifySteps.map((step, i) => (
          <li class="card flex items-start gap-4 rounded-3xl p-5">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#176b68] text-sm font-black text-white"><BidiText text={String(i + 1)} /></span>
            <p class="text-[#66574e]"><BidiText text={step} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</GuideLayout>
