---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'حول السوق', href: '/around/corniche/' },
  { name: 'حديقة ريام' },
];

const quickFacts = [
  { label: 'الموقع', value: 'على الساحل بين مطرح ومسقط القديمة' },
  { label: 'المعلم الأشهر', value: 'مجسّمة المبخرة البيضاء الكبيرة' },
  { label: 'المرافق', value: 'مساحات خضراء ومرافق للأطفال (تحقّق ميدانياً)' },
  { label: 'أفضل وقت', value: 'العصر والغروب لاعتدال الجو' },
];

const faq = [
  { q: 'أين تقع حديقة ريام؟', a: 'تقع في منطقة ريام على الساحل بين مطرح ومسقط القديمة، على مقربة من الكورنيش والميناء. الوصول إليها ممكن سيراً على امتداد الواجهة أو بالسيارة عبر الطريق الساحلي.' },
  { q: 'ما هي مجسّمة المبخرة؟', a: 'معلم بصري كبير على تلة مطلة، صُمّم على هيئة مبخرة عُمانية تقليدية، ويُعدّ من أشهر معالم المنطقة ويظهر من مسافة بعيدة على امتداد الكورنيش.' },
  { q: 'هل الحديقة مناسبة للأطفال؟', a: 'تحتوي عادةً على مساحات خضراء ومرافق ترفيهية للأطفال، لكن حالة هذه المرافق وإتاحتها تتغيّر؛ لذلك تحقّق ميدانياً من توفّرها قبل التخطيط لزيارة عائلية.' },
  { q: 'ما أفضل وقت لزيارة الحديقة؟', a: 'العصر والغروب هما الأنسب لقرب الحديقة من الماء واعتدال الجو، مع إمكانية التصوير في الضوء الذهبي. تجنّب ساعات الظهيرة الحارة خاصة صيفاً.' },
  { q: 'هل الدخول مجاني وهل ساعات العمل مؤكدة؟', a: 'لم نجد مصدراً رسمياً يثبت تعريفة دخول أو ساعات محدّدة بشكل مؤكّد؛ لذلك نعتبرها غير مؤكدة وتجب مراجعتها ميدانياً أو عبر الجهة المختصة قبل التخطيط لزيارة.' },
];

const sources = [
  { label: 'بلدية مسقط', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/', desc: 'الجهة البلدية المسؤولة عن الحدائق والمرافق العامة في مسقط.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق محافظة مسقط والمعالم الساحلية المحيطة بمطرح.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لتقدير المسار نحو الحديقة والساحل؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى البحري الذي يصل الحديقة بالسوق والميناء.' },
  { href: '/around/old-muscat/', label: 'من مطرح إلى مسقط القديمة', desc: 'الطريق والمعالم بين مطرح ومسقط القديمة.' },
  { href: '/itineraries/family/', label: 'مسار عائلي', desc: 'مسار مشي أقصر بفواصل راحة يناسب الأطفال.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'كيف توازن بين الوقت المناسب وحرارة النهار.' },
];
---
<GuideLayout
  title="حديقة ريام في مطرح: المساحة الخضراء ومجسّمة المبخرة"
  h1="حديقة ريام: مساحة خضراء على ساحل مطرح"
  description="دليل حديقة ريام في مطرح: مساحة خضراء على الساحل، ومجسّمة المبخرة كمعلم بصري، والمرافق والأنشطة بحسب المتاح، وأفضل الأوقات، والربط بالكورنيش ومسقط القديمة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <p class="kicker">مساحة خضراء</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d]">حديقة على الساحل في منطقة ريام</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="تقع حديقة ريام في منطقة ريام بين مطرح ومسقط القديمة، وهي إحدى المساحات الخضراء العامة المطلة على الماء. تمنح الحديقة زوارها تنوّعاً بين المرتفعات الصخرية والخضرة والإطلالة على الخليج، ما يجعلها محطة مريحة بعد جولة السوق." /></p>
            <p><BidiText text="يمكن الوصول إليها سيراً على امتداد الواجهة البحرية أو بالسيارة عبر الطريق الساحلي. ونظراً لقربها من الكورنيش، يمكن دمجها بسهولة مع جولة على الممشى." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">مجسّمة المبخرة كمعلم بصري</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="أبرز ما يميّز المنطقة مجسّمة كبيرة على هيئة مبخرة عُمانية تقليدية، تقف على تلة وتظهر من مسافة بعيدة على امتداد الكورنيش. وقد صارت المجسّمة أحد أشهر المعالم البصرية في مسقط." /></p>
            <p><BidiText text="المجسّمة تُشاهد عادةً من الحديقة ومن الطريق المحيط أكثر من الدخول إليها؛ ولذلك تُعدّ نقطة مناسبة للتصوير، لا سيّما في ضوء العصر والغروب." /></p>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">مرافق قد تجدها</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><BidiText text="مساحات خضراء للمشي والجلوس." /></li>
            <li><BidiText text="مرافق ترفيهية للأطفال (تحقّق من إتاحتها)." /></li>
            <li><BidiText text="إطلالة على الماء والمرتفعات." /></li>
            <li><BidiText text="نقاط مناسبة للتصوير عند الغروب." /></li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه للتحقق:</b> حالة المرافق وساعات العمل ووجود أي رسوم غير مؤكدة وتتغيّر؛ تحقّق ميدانياً أو عبر الجهة المختصة. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-10 lg:grid-cols-2">
      <div class="card rounded-3xl p-6">
        <h2 class="display text-2xl font-black text-[#18110d]">مرافق الأنشطة والأطفال (بحسب المتاح)</h2>
        <div class="mt-4 space-y-4 text-sm text-[#58483e]">
          <p><BidiText text="تحتوي الحديقة عادةً على مساحات مفتوحة ومناطق للجلوس ومتنزّه، وأحياناً مرافق ترفيهية للأطفال. لكن حالة هذه المرافق قابلة للتغيّر بحسب أعمال الصيانة أو التطوير." /></p>
          <p><BidiText text="قبل زيارة عائلية، تأكّد ميدانياً من توفّر المرافق التي تحتاجها، مثل مناطق الأطفال والمقاعد المظللة ودورات المياه. لا نضمن إتاحة أي مرفق دون تحقق." /></p>
        </div>
      </div>
      <div class="card rounded-3xl p-6">
        <h2 class="display text-2xl font-black text-[#18110d]">أفضل الأوقات والربط بالمحيط</h2>
        <div class="mt-4 space-y-4 text-sm text-[#58483e]">
          <p><BidiText text="العصر والغروب هما الأنسب للاستمتاع باعتدال الجو والإضاءة الجميلة، بينما تكون ساعات الظهيرة حارة خاصة صيفاً. ارتدِ حذاءً مريحاً للمشي على المنحدرات." /></p>
          <p><BidiText text="يمكن ربط الحديقة بكورنيش مطرح سيراً، ثم متابعة الطريق نحو مسقط القديمة لمشاهدة القصر والحصون من الخارج. راجع لدينا أدلة الكورنيش ومسقط القديمة لترتيب الجولة." /></p>
        </div>
      </div>
    </div>
  </section>
</GuideLayout>
