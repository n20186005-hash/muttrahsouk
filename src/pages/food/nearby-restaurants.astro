---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المطاعم والمقاهي', href: '/food/nearby-restaurants/' },
  { name: 'مطاعم قريبة من السوق' },
];

const quickFacts = [
  { label: 'المنطقة', value: 'كورنيش مطرح والشوارع المجاورة للميناء' },
  { label: 'أنواع المطبخ', value: 'عُماني وخليجي وهندي وبحري ومشاوٍ وعصائر' },
  { label: 'أوقات الذروة', value: 'منتصف النهار والمساء وبعد صلاة الجمعة' },
  { label: 'من المدخل', value: 'دقائق مشي على امتداد الكورنيش' },
];

const faq = [
  { q: 'أين تتجمّع المطاعم القريبة من سوق مطرح؟', a: 'أبرز تجمّع للمطاعم والمقاهي على امتداد كورنيش مطرح المواجه للميناء، إضافة إلى شوارع أصغر خلف مداخل السوق وبالقرب من سوق السمك حيث يزيد عرض المأكولات البحرية.' },
  { q: 'ما أنواع الطعام التي أتوقعها حول السوق؟', a: 'تشمل الأنواع الشائعة المأكولات العُمانية والخليجية، والمأكولات البحرية، والمأكولات الهندية والآسيوية، والمشاوي والوجبات السريعة، ومحال العصائر والمشروبات الطازجة.' },
  { q: 'ما أفضل وقت لتناول الطعام في مطرح؟', a: 'الغداء يقارب منتصف النهار والعشاء يمتد في المساء، ويختلف الإيقاع يوم الجمعة بسبب الصلاة. المواسم الباردة والعطلات ترفع الازدحام قرب الواجهة البحرية.' },
  { q: 'هل أسعار المطاعم قريبة من السوق مرتفعة؟', a: 'تتفاوت الأسعار بحسب نوع المكان وقربه من الواجهة وقائمة الطعام. لا ننشر أرقاماً ثابتة؛ اطّلع على القائمة المعروضة قبل الجلوس لتقدير التكلفة في يوم زيارتك.' },
  { q: 'هل أستطيع الدفع بالبطاقة؟', a: 'يختلف قبول البطاقات من مكان لآخر. من المفيد حمل بعض الريال العُماني للمبالغ الصغيرة، والسؤال عن وسيلة الدفع قبل الطلب.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق المكان والمعالم المجاورة التي تتوزّع حولها المطاعم.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف المنطقة التجارية المحيطة بالسوق على الواجهة البحرية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لاستكشاف الشوارع القريبة؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/food/omani-food/', label: 'الأكلات العُمانية', desc: 'أشهر الأطباق العُمانية وعادات الضيافة وتقديم القهوة.' },
  { href: '/food/cafes/', label: 'مقاهي كورنيش مطرح', desc: 'أنواع المقاهي وجلسات الممشى البحري وأفضل الأوقات.' },
  { href: '/food/seafood/', label: 'مطاعم السمك', desc: 'الطزاجة وأطباق السمك وصلتها بسوق السمك.' },
  { href: '/around/fish-market/', label: 'سوق السمك في مطرح', desc: 'النشاط الصباحي في المبنى الحديث قرب الميناء.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'أين توقف السيارة وكيف تستعد للازدحام.' },
];
---
<GuideLayout
  title="مطاعم قريبة من سوق مطرح: الأنواع والمناطق والأوقات"
  h1="مطاعم قريبة من سوق مطرح: أين تأكل وماذا تتوقع"
  description="دليل أنواع المطاعم حول كورنيش مطرح والشوارع المجاورة: مأكولات عُمانية وخليجية وهندية وبحرية، وأين تتجمّع، وأوقات الذروة، وكيف تختار دون أسماء تجارية."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">المطاعم والمقاهي</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">ما أنواع المطاعم القريبة من سوق مطرح؟</h2>
      <div class="mt-6 space-y-4 text-[#58483e]">
        <p><BidiText text="تتنوّع المطاعم المحيطة بسوق مطرح بحسب مطبخها ومناسبتها، ويمكن تصنيفها إلى أنواع عامة بدل تسمية محال بعينها: مطاعم المأكولات العُمانية والخليجية التي تقدّم الأرز واللحوم والأسماك، ومطاعم المأكولات البحرية القريبة من الميناء وسوق السمك، ومطاعم المأكولات الهندية والآسيوية، ومطاعم المشاوي والوجبات السريعة، ومحال العصائر والمشروبات الطازجة." /></p>
        <p><BidiText text="لا يعني هذا التصنيف وجود كل نوع في كل شارع؛ بل يتغيّر العرض من منطقة لأخرى. الأنسب أن تتوجّه نحو المنطقة التي تناسب نوع الطعام الذي تريده: الواجهة البحرية للجلسات والمأكولات البحرية، والشوارع الداخلية للخيارات السريعة وبأسعار معتدلة." /></p>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">أين تتجمّع؟</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">المناطق التي تتوزّع فيها المطاعم</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">كورنيش مطرح</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="أوسع تجمّع للمطاعم والمقاهي، بجلسات قريبة من الماء ومساحات للمشي قبل الطعام أو بعده." /></p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">الشوارع المجاورة للأسواق</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="مطاعم أصغر ووجبات سريعة قريبة من مداخل السوق، مناسبة للتوقف القصير ضمن الجولة." /></p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">قرب سوق السمك والميناء</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="تركّز أكبر للمأكولات البحرية بسبب قرب المصدر، وتنشط عادةً في أوقات الغداء والعشاء." /></p>
        </div>
      </div>
      <p class="mt-8 max-w-3xl text-[#58483e]"><BidiText text="للتوجّه نحو أقرب حيّ مطاعم استخدم رابط الخريطة، ثم امشِ نحو الواجهة البحرية أو الشوارع الداخلية بحسب نوع الطعام المطلوب." /></p>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">أوقات الوجبات والذروة</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="يتوزّع الإقبال على أوقات محددة: الغداء يقارب منتصف النهار، والعشاء يمتد من المساء حتى وقت متأخر في الكورنيش. يوم الجمعة يختلف الإيقاع بسبب صلاة الجمعة، فينشط الإقبال بعد الصلاة وكذلك في المساء." /></p>
            <p><BidiText text="في المواسم الباردة والعطلات يزداد الازدحام حول المطاعم القريبة من الواجهة، وقد تحتاج وقتاً للانتظار أو البحث عن بديل أبعد قليلاً. تحقّق من ساعات المكان نفسه في يوم زيارتك بدلاً من الاعتماد على ساعات عامة." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">كيف تختار مطعماً من دون أسماء تجارية؟</h2>
          <ol class="mt-4 space-y-3 text-[#58483e]">
            <li><BidiText text="1. اقرأ القائمة المعروضة قبل الجلوس للتأكد من نوع الطعام والتكلفة." /></li>
            <li><BidiText text="2. تأكد من مستوى النظافة العام للمكان ومن ترتيب الطاولات والخدمة." /></li>
            <li><BidiText text="3. اسأل عن مكوّنات الطبق إن كانت لديك حساسية غذائية أو تفضيلات معيّنة." /></li>
            <li><BidiText text="4. اعرف وسيلة الدفع المقبولة قبل الطلب لتجنّب الحرج." /></li>
            <li><BidiText text="5. اختر الأقرب لموقعك إن كان الوقت ضيقاً، أو الأبعد عن الزحام إن أردت الهدوء." /></li>
          </ol>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">خطة وجبة سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الوصول:</b> انزل قرب الكورنيش وامشِ نحو المطاعم.</li>
            <li><b class="text-[#18110d]">التوقيت:</b> تجنّب ذروة منتصف النهار في الحرّ.</li>
            <li><b class="text-[#18110d]">الاختيار:</b> راجع القائمة والنظافة والسعر.</li>
            <li><b class="text-[#18110d]">الربط:</b> أضف جولة قصيرة على سوق السمك بعد الأكل.</li>
          </ul>
          <a class="mt-5 inline-flex rounded-full bg-[#E2A52E] px-5 py-2.5 font-black text-[#18110d]" href={mapUrl} target="_blank" rel="nofollow noopener">افتح الخريطة</a>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه للتحقق:</b> هذا الدليل وصفي لأنواع المطاعم ولا يوصي بأي اسم تجاري. تتفاوت الأسعار وساعات العمل وجودة الخدمة من مكان لآخر؛ تحقّق ميدانياً أو عبر خرائط جوجل قبل الزيارة. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
