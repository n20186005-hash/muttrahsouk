---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المطاعم والمقاهي', href: '/food/nearby-restaurants/' },
  { name: 'مقاهي كورنيش مطرح' },
];

const quickFacts = [
  { label: 'الموقع', value: 'على الممشى البحري في كورنيش مطرح' },
  { label: 'النوعان الأساسيان', value: 'القهوة العُمانية التقليدية والقهوة المختصة' },
  { label: 'أفضل الأوقات', value: 'الصباح الباكر أو بعد العصر' },
  { label: 'الملاءمة', value: 'جلسات عائلية؛ تتفاوت الساعات مكاناً بمكان' },
];

const faq = [
  { q: 'ما أنواع المقاهي على كورنيش مطرح؟', a: 'يمكن تقسيمها إلى نوعين عامين: مقاهٍ تقدم القهوة العُمانية التقليدية والمشروبات المحلية، ومقاهٍ حديثة تقدم القهوة المختصة والمشروبات الباردة. وتوجد مساحات صغيرة للوجبات الخفيفة.' },
  { q: 'ما الفرق بين القهوة العُمانية والقهوة المختصة؟', a: 'القهوة العُمانية مشروب تقليدي يُبهّر بالهيل ويُقدَّم في فنجان صغير مع التمر غالباً. أما القهوة المختصة فتعتمد على تحميص حبوب مختارة وأساليب تحضير حديثة تناسب محبي الإسبريسو والمقطّر.' },
  { q: 'ما أفضل وقت للجلوس في مقاهي الكورنيش؟', a: 'الصباح الباكر أهدأ وأبرد، وبعد العصر وقت ممتع للإطلالة على الماء عند انخفاض الحرارة. المساء يشهد ازدحاماً أكبر خاصة في المواسم والعطلات.' },
  { q: 'هل المقاهي مناسبة للعائلات؟', a: 'توجد جلسات عائلية ومفتوحة، لكن تنظيم الجلسات يختلف من مقهى لآخر؛ راجع توزيع الطاولات والمساحات المظللة قبل الجلوس. تتوفر عادةً خيارات مشروبات للأطفال.' },
  { q: 'هل توجد مقاهٍ داخل السوق نفسه؟', a: 'يتركّز معظم المقاهي على الممشى والمناطق المحيطة بالسوق؛ وقد تجد أماكن للمشروبات داخل الأزقة أو قريباً من المداخل، لكن التوفّر يختلف بحسب أوقات اليوم.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق المكان والمنطقة المحيطة بالكورنيش والسوق.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف المنطقة التجارية والواجهة البحرية حول السوق.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لاستكشاف المواقع القريبة؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'أنواع المطاعم حول الكورنيش وكيف تختار بينها.' },
  { href: '/food/quick-drinks/', label: 'الشاي والكرك والوجبات الخفيفة', desc: 'مشروبات سريعة وتوقف خفيف ضمن الجولة.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى البحري وجلسته وأفضل أوقات التنزّه.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'كيف توازن بين الهدوء والحركة وحرارة النهار.' },
];
---
<GuideLayout
  title="مقاهي كورنيش مطرح: القهوة العُمانية والمختصة"
  h1="مقاهي كورنيش مطرح: أنواع القهوة وأفضل الجلسات"
  description="دليل مقاهي كورنيش مطرح: القهوة العُمانية التقليدية مقابل القهوة المختصة، الجلسات والإطلالات البحرية، تفاوت الساعات، والأوقات الأفضل للعائلات."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <p class="kicker">المقاهي</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d]">ما أنواع المقاهي على الممشى؟</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="على امتداد الممشى البحري في كورنيش مطرح تنتشر مقاهٍ تناسب أذواقاً مختلفة: أماكن بسيطة تقدّم القهوة العُمانية والشاي والمشروبات المحلية، وأماكن حديثة تتخصّص في القهوة المختصة والمشروبات الباردة، إضافة إلى مساحات صغيرة لبيع الوجبات الخفيفة." /></p>
            <p><BidiText text="لا نذكر أسماء محال؛ والأنسب أن تتنزّه على الممشى ثم تختار الجلسة التي تلائم وقتك ومزاجك، فتكون الواجهة البحرية أحياناً معياراً أفضل من نوع المشروب نفسه." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">القهوة العُمانية مقابل القهوة المختصة</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="القهوة العُمانية مشروب تقليدي يُبهّر بالهيل ويُقدَّم في فنجان صغير مع التمر غالباً، وهي جزء من ثقافة الضيافة المحلية. أما القهوة المختصة فتعتمد على حبوب مختارة وأساليب تحضير حديثة تناسب من يفضّل الإسبريسو أو المشروبات الباردة." /></p>
            <p><BidiText text="إن أردت تجربة الطابع المحلي فاختر القهوة التقليدية مع الحلوى أو التمر، وإن كنت تبحث عن جلسة عمل أو قراءة فالمقاهي الحديثة توفر عادةً مقاعد وطاولات مناسبة." /></p>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">اختيار سريع</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">للتراث:</b> قهوة عُمانية مع التمر وحلوى محلية.</li>
            <li><b class="text-[#18110d]">للعمل:</b> مقعد وطاولة ومشروب مختص.</li>
            <li><b class="text-[#18110d]">للإطلالة:</b> جلسة على الممشى قبيل الغروب.</li>
            <li><b class="text-[#18110d]">للأطفال:</b> مشروبات باردة ومساحة مظللة.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه للتحقق:</b> تتفاوت ساعات المقاهي وقوائمها من مكان لآخر وتتغيّر بحسب الموسم؛ هذا الدليل وصفي بلا أسماء ولا توصيات. تحقّق ميدانياً أو عبر خرائط جوجل. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">الجلسات والإطلالات</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">كيف تختار الجلسة المناسبة؟</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">الإطلالة على الماء</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="الجلسات المواجهة للبحر تولّد إحساساً بالانفتاح، وهي الأجمل في الصباح أو قبيل الغروب حين تخفّ الحرارة. احجز وقتاً أبكر إن أردت مقعداً قريباً من الحافة في الموسم المزدحم." /></p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">الجلسات الداخلية والمظلّلة</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="الظل مهم عند الظهيرة؛ لذا تفضّل الجلسات المظلّلة أو الداخلية في ساعات الحرّ، خاصة مع وجود أطفال أو عند انتظار الطعام." /></p>
        </div>
      </div>
      <p class="mt-8 max-w-3xl text-[#58483e]"><BidiText text="الأوقات الأفضل للجلوس: صباحاً قبل اشتداد الحرارة، أو بعد العصر حتى حلول المساء. تجنّب ذروة الظهيرة صيفاً لارتفاع الحرارة والرطوبة." /></p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="display text-3xl font-black text-[#18110d]">قبل أن تجلس</h2>
      <ol class="mt-4 max-w-3xl space-y-3 text-[#58483e]">
        <li><BidiText text="1. راجع القائمة المعروضة والأسعار قبل الاختيار." /></li>
        <li><BidiText text="2. تحقّق من النظافة العامة وترتيب الطاولات والخدمة." /></li>
        <li><BidiText text="3. اسأل عن ساعات الإغلاق إن كانت جلستك في وقت متأخر." /></li>
        <li><BidiText text="4. تأكّد من وسيلة الدفع المقبولة للمبالغ الصغيرة." /></li>
      </ol>
    </div>
  </section>
</GuideLayout>
