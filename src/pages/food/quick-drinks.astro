---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المطاعم والمقاهي', href: '/food/nearby-restaurants/' },
  { name: 'الشاي والكرك والوجبات الخفيفة' },
];

const quickFacts = [
  { label: 'القهوة العُمانية', value: 'قهوة بالهيل تُقدَّم مع التمر أو الحلوى' },
  { label: 'طريقة التقديم', value: 'أكواب صغيرة بلا عُرى تُملأ جزئياً' },
  { label: 'الكرك', value: 'شاي بالحليب والتوابل ذو أصل جنوب آسيوي' },
  { label: 'إشارة الاكتفاء', value: 'تحريك الكوب إشارة إلى عدم طلب المزيد' },
];

const sections = [
  {
    heading: 'القهوة العُمانية وآداب تقديمها',
    body: [
      'القهوة العُمانية، وتُسمى محلياً «القهوة» أو «الكهوة»، مشروب أصيل يُعدّ من حبوب البنّ ويُعطَّر بالهيل، وقد يُضاف إليه ماء الورد أو الزعفران. وهي مرتبطة بالكرم والضيافة، إذ تُقدَّم للأضياف في كل مناسبة اجتماعية داخل البيوت والمجالس وفي المحال كذلك.',
      'للمشروب آدابه: يُصبّ من إبريق معدني في أكواب صغيرة بلا عُرى تُملأ جزئياً كي يبقى الضيف قادراً على شربه ساخناً. ويُقدَّم عادةً مع التمر أو الحلوى العُمانية، ويُستحب قبول كوب واحد على الأقل إكراماً للمضيف. وعند الاكتفاء، تُحرَّك الكأس بلطف من جانب إلى آخر إشارة إلى عدم الحاجة لمزيد.',
    ],
  },
  {
    heading: 'الشاي والكرك: مشروب الجلسات اليومية',
    body: [
      'الكرك شاي قوي يُغلى مع الحليب والسكر والتوابل، وعلى رأسها الهيل، حتى يصبح كثيفاً وعطرياً. وأصل هذا النمط من الشاي يعود إلى جنوب آسيا، ثم انتشر وتطوّر في دول الخليج وصار جزءاً من ثقافتها اليومية، وله في عُمان طابع خاص يضيف أحياناً لمسات من ماء الورد أو الزعفران.',
      'تجده في كثير من المقاهي والبوفيهات البسيطة قرب السوق والكورنيش، وقد يفضّل البعض شربه مع وجبة خفيفة أو قطعة حلو. لا نسمّي هنا أي محل ولا نؤكد وصفة بعينها، لأن النسب والمذاق تختلف بين مكان وآخر، ومع ذلك يبقى الكرك أحد أسهل الطرق لتجربة مزاج الجلسة اليومية في مطرح.',
    ],
  },
  {
    heading: 'وجبات خفيفة تناسب جولة قصيرة',
    body: [
      'إلى جانب المشروبات، تتوفر قطع خفيفة تناسب التوقف القصير: تمر وحلوى عُمانية، وخبز رقيق، وعصائر طازجة، ومكسّرات، وحلويات متنوعة. الحلوى العُمانية حلوى كثيفة بنية أو بزعفران تُعدّ بالعسل والسكر والمكسّرات، وتُعدّ رمزاً للضيافة وتُقدَّم عادةً مع القهوة.',
      'عند الاختيار، اعتمد على النظافة الظاهرة ووضوح القائمة والسعر بدل الاعتماد على أي اسم تجاري، وتذكّر أن الأسعار وساعات العمل تتغيّر بحسب المحل والموسم. إن كان لديك حساسية غذائية أو احتياج خاص، فاسأل عن المكوّنات قبل الشراء.',
    ],
  },
];

const faq = [
  { q: 'ما هي القهوة العُمانية وكيف تُقدَّم؟', a: 'هي قهوة تُعدّ من البنّ وتُعطَّر بالهيل، وقد يُضاف إليها ماء الورد أو الزعفران. تُصبّ في أكواب صغيرة بلا عُرى وتُملأ جزئياً، وتُقدَّم عادةً مع التمر أو الحلوى، وتُعدّ رمزاً للكرم العُماني.' },
  { q: 'ما الفرق بين الكرك والشاي العادي؟', a: 'الكرك يُغلى فيه الشاي مع الحليب والسكر والتوابل — وأهمها الهيل — فيصبح قوياً وكثيفاً وعطرياً، بخلاف الشاي الخفيف بماء ساخن. أصله من جنوب آسيا وانتشر في دول الخليج.' },
  { q: 'هل تحتوي القهوة العُمانية على الكافيين؟', a: 'نعم، لأنها تُعدّ من البنّ، وبالتالي تحتوي على كافيين. لا نقدّم أي إفادة صحية أو طبية، وإن كنت تتحسّس من الكافيين فاستفسر عن المكوّنات أو الشاي البديل.' },
  { q: 'أين أتذوّق هذه المشروبات دون توصية تاجر؟', a: 'تنتشر المقاهي والبوفيهات البسيطة حول السوق والكورنيش. اختر بحسب النظافة ووضوح القائمة والسعر وقت زيارتك؛ هذا الدليل لا يسمّي محالاً ولا يوصي بأي جهة تجارية.' },
  { q: 'هل توجد خيارات مناسبة للأطفال؟', a: 'غالباً تتوفر العصائر والمشروبات الحلوة والوجبات الخفيفة، لكن نسبة السكر والكافيين تختلف من مكان لآخر. اسأل عن المكوّنات إن كان معك أطفال.' },
];

const sources = [
  { label: 'دليل لاكتشاف عُمان (بدعم وزارة التراث والسياحة)', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/media/x2cd2gim/the-wanderlust-oman.pdf', desc: 'يذكر تقديم القهوة العُمانية بالهيل والتمر وارتباطها بالضيافة.' },
  { label: 'ثقافة عُمان — الطعام', org: 'ويكيبيديا', url: 'https://en.wikipedia.org/wiki/Culture_of_Oman', desc: 'وصف الحلوى العُمانية والخبز الرقيق وارتباط الحلويات بالضيافة.' },
  { label: 'الغاسترونومي في سلطنة عُمان', org: 'منظمة السياحة العالمية (تقرير)', url: 'https://pre-webunwto.s3.eu-west-1.amazonaws.com/s3fs-public/webimages/OMAN_web.pdf', desc: 'وصف القهوة العُمانية وحبوبها وإضافة الهيل وماء الورد، وإشارة الاكتفاء بتحريك الكوب.' },
  { label: 'أصل الشاي الكرك', org: 'مرجع عام حول الكرك', url: 'https://eathealthy365.com/the-origin-and-history-of-karak-chai-explained/', desc: 'جذور الكرك في جنوب آسيا وانتشاره في دول الخليج.' },
];

const related = [
  { href: '/food/cafes/', label: 'مقاهي كورنيش مطرح', desc: 'خيارات الجلوس القريبة من الواجهة البحرية.' },
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'أين تأكل قرب السوق بلا توصيات تجارية.' },
  { href: '/food/omani-food/', label: 'الأكلات العُمانية', desc: 'سياق أوسع للمطبخ العُماني.' },
  { href: '/souq/perfume-spices/', label: 'العطور والتوابل', desc: 'الهيل والتوابل التي تدخل في هذه المشروبات.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'مكان مناسب للجلسة القصيرة بعد الكرك.' },
];
---
<GuideLayout
  title="القهوة العُمانية والكرك والوجبات الخفيفة قرب سوق مطرح | دليل سوق مطرح"
  h1="الشاي والكرك والقهوة والوجبات الخفيفة"
  description="ماذا تشرب وتأكل قرب سوق مطرح: القهوة العُمانية بالهيل مع التمر والحلوى، الشاي والكرك، والوجبات الخفيفة، مع آداب الضيافة ونصائح اختيار محايدة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">آداب تناوُل القهوة العُمانية</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li>اقبل كوباً واحداً على الأقل إكراماً للمضيف إن قُدّمت لك القهوة.</li>
            <li>استلم الكوب بيدك اليمنى إن أمكن.</li>
            <li>القهوة تُقدَّم غير محلّاة تقريباً، والحلاوة تأتي من التمر أو الحلوى.</li>
            <li>عند الاكتفاء، حرّك الكوب برفق إشارة إلى عدم طلب المزيد.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة:</b> هذه الصفحة تشرح المشروبات والوجبات الخفيفة وأسماءها العامة، ولا تسمّي مطعماً أو مقهى ولا تنشر أسعاراً. الأسعار وساعات العمل قابلة للتغيير بحسب الموسم، فتحقّق وقت الزيارة.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
