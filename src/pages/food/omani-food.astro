---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المطاعم والمقاهي', href: '/food/nearby-restaurants/' },
  { name: 'الأكلات العُمانية' },
];

const quickFacts = [
  { label: 'أشهر الأطباق', value: 'الشواء والمجبوس والهريس والمشواي' },
  { label: 'حلوى تقليدية', value: 'الحلوى العُمانية وتُقدّم مع القهوة' },
  { label: 'عادات الضيافة', value: 'القهوة العُمانية مع التمر للترحيب' },
  { label: 'التوابل', value: 'تتفاوت درجة البهارات بحسب الطبق والمكان' },
];

const dishes = [
  { name: 'الشواء', desc: 'لحم متبّل يُطهى ببطء لفترة طويلة حتى يلين، ويُقدّم عادةً في المناسبات والأعياد والولائم.' },
  { name: 'المجبوس', desc: 'أرز بالبهارات مع لحم أو دجاج أو سمك؛ من الأطباق الأكثر شيوعاً على المائدة العُمانية.' },
  { name: 'الهريس', desc: 'طبق كثيف القوام من القمح المطحون مع اللحم، ويُقدّم بكثرة في رمضان والمناسبات.' },
  { name: 'المشواي', desc: 'سمك مشوي على الفحم، ويشتهر في المناطق الساحلية مثل مطرح لقربها من الصيد.' },
  { name: 'العرسية', desc: 'طبق من الأرز واللحم يُطهى حتى يتجانس قوامه، ويُقدّم في المناسبات والعزائم.' },
  { name: 'المضروبة', desc: 'عصيدة من الحبوب المطحونة مع اللحم، طعام تقليدي مشبع يظهر في الموائد المحلية.' },
  { name: 'الحلوى العُمانية', desc: 'حلوى عُمانية شهيرة بمكوّنات تتضمن السمن والبهارات، تُقدّم في الضيافة والمناسبات.' },
  { name: 'القهوة العُمانية', desc: 'قهوة بالهيل تُقدّم في فنجان صغير مع التمر عادةً؛ رمز أساسي للترحيب والضيافة.' },
];

const faq = [
  { q: 'ما أشهر الأكلات العُمانية التي أجرّبها في مطرح؟', a: 'من أبرزها الشواء والمجبوس والهريس والمشواي (السمك المشوي)، إضافة إلى العرسية والمضروبة والحلوى العُمانية، مع القهوة العُمانية مع التمر في الضيافة.' },
  { q: 'هل الطعام العُماني حار؟', a: 'ليس بالضرورة؛ يتراوح الطعم بين المعتدل والغني بالبهارات العطرية، وتتفاوت درجة الحرارة بحسب الطبق والمكان. اسأل عن درجة التوابل قبل الطلب إن كنت تفضّل طعماً أهدأ.' },
  { q: 'كيف تُقدَّم القهوة العُمانية؟', a: 'تُقدَّم عادةً في فنجان صغير مع التمر، وهي جزء من عادات الترحيب والضيافة. من الأدب أن تتناولها باليد اليمنى وأن تشكر المُضيف.' },
  { q: 'هل توجد خيارات نباتية في الأكل العُماني؟', a: 'توجد أطباق تعتمد على الأرز والخضروات والبقول والحبوب، لكن الخيارات تختلف من مكان لآخر. اسأل عن تفاصيل الطبق لإزالة أي مكوّن حيواني.' },
  { q: 'كيف يختلف الطعام في رمضان؟', a: 'تتغيّر ساعات تقديم الطعام وتتركّز الوجبات بعد الإفطار، وتظهر أطباق محدّدة بكثرة. تتحقق مواعيد المطاعم كل سنة لأنها تتغيّر بحسب الشهر.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق المكان والمنطقة التي تنتشر فيها المطاعم التقليدية.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف السوق والسلع ومنطقة مطرح التي تُقدّم فيها الأطباق المحلية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لاستكشاف أماكن الطعام القريبة؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'أنواع المطاعم حول الكورنيش وكيف تختار بينها.' },
  { href: '/food/seafood/', label: 'مطاعم السمك', desc: 'الطزاجة وأطباق السمك وصلتها بسوق السمك.' },
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري من السوق', desc: 'اللبان والتوابل والحلوى والهدايا التقليدية.' },
  { href: '/visit/ramadan/', label: 'السوق في رمضان', desc: 'تغيّر الساعات والذروة بعد الإفطار وآداب الصيام.' },
];
---
<GuideLayout
  title="الأكلات العُمانية في مطرح: أشهر الأطباق وعادات الضيافة"
  h1="الأكلات العُمانية في مطرح: أطباق ونكهات وعادات"
  description="تعرّف على أشهر الأكلات العُمانية المتوفرة حول سوق مطرح: الشواء والمجبوس والهريس والمشواي والحلوى العُمانية، مع عادات تقديم القهوة والضيافة وأثر رمضان."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">نكهات عُمانية</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">ما الذي يميّز المطبخ العُماني؟</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="يقوم المطبخ العُماني على الأرز واللحوم والأسماك والخضروات، مع بهارات عطرية وتوابل متوازنة بدل الحرارة العالية دائماً. وتدخل في كثير من الأطباق مكوّنات مثل الهيل والزعفران والليمون المجفف، ما يمنحها عمقاً في الطعم ورائحة مميزة." /></p>
        <p><BidiText text="قرب مطرح من البحر والميناء يجعل الأسماك الطازجة حاضرة بقوة على المائدة، بينما تحتفظ الأطباق ذات الأصل الحضري بطابع الاحتفال والولائم. ومن يرغب في فهم الثقافة العُمانية يجد في الطعام مدخلاً واضحاً إليها." /></p>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">أطباق قد تجدها</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">أشهر الأكلات العُمانية وأوصافها</h2>
      <p class="mt-4 max-w-3xl text-sm text-[#66574e]"><BidiText text="الجدول يصف أنواعاً عامة من الأطباق وليس أي قائمة بعينها؛ فقد يختلف التوفّر من مكان لآخر ومن موسم لآخر." /></p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#176b68] text-white">
              <th class="p-4">الطبق</th>
              <th class="p-4">وصف عام</th>
            </tr>
          </thead>
          <tbody>
            {dishes.map((d) => (
              <tr class="border-b border-[#B98739]/25">
                <td class="p-4 font-black text-[#18110d]">{d.name}</td>
                <td class="p-4 text-[#58483e]"><BidiText text={d.desc} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-2">
      <div>
        <p class="kicker">الضيافة</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d]">عادات تقديم القهوة والترحيب</h2>
        <div class="mt-4 space-y-4 text-[#58483e]">
          <p><BidiText text="تُعدّ القهوة العُمانية مع التمر رمزاً للترحيب في المجالس والمناسبات. تُقدَّم في فنجان صغير، وتُعرض على الضيف باليد اليمنى، وتتكرر تعبئته إشارةً إلى الكرم." /></p>
          <p><BidiText text="في المطاعم حول السوق، كثيراً ما تكون القهوة والحلوى مدخلاً بسيطاً لتجربة الضيافة المحلية. ومن الأدب احترام خصوصية الأشخاص وعدم تصويرهم دون استئذان أثناء تناولهم الطعام." /></p>
        </div>
      </div>
      <div>
        <p class="kicker">التوابل</p>
        <h2 class="display mt-3 text-3xl font-black text-[#18110d]">تتفاوت النكهة بحسب المكان</h2>
        <div class="mt-4 space-y-4 text-[#58483e]">
          <p><BidiText text="تختلف درجة التوابل من مطبخ لآخر ومن طبق لآخر؛ فبعض الأطباق عطرية معتدلة وبعضها أغنى بالحرارة. إن كنت حساساً تجاه البهارات فاطلب درجة أخفّ قبل الطهي أو اطلب الطبق على حدة." /></p>
          <p><BidiText text="الأطباق المحضّرة طازجة قد تستغرق وقتاً أطول في التحضير، خصوصاً أطباق اللحوم المطهوّة ببطء. خصّص وقتاً كافياً إن اخترت تجربة طبق تقليدي ثقيل." /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">رمضان</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">الطعام في الشهر الفضيل</h2>
      <div class="mt-5 space-y-4 text-[#d8eee9]">
        <p><BidiText text="في رمضان تتبدّل أوقات تقديم الطعام؛ إذ تتركز الوجبات بعد الإفطار، وتكثر أطباق محدّدة مثل الهريس والحلويات. كما تتنشّط المطاعم والأسواق في المساء وتخفت خلال النهار." /></p>
        <p><BidiText text="مواعيد الإفطار والسحور تتغيّر كل سنة بتغيّر التقويم، لذا تحقّق من ساعات المكان قبل الانطلاق. ويُنصح باحترام آداب الصيام وتجنّب تناول الطعام علناً خلال ساعات النهار." /></p>
      </div>
      <div class="mt-6 rounded-3xl border border-white/20 bg-black/20 p-5 text-sm">
        <b class="text-[#F6D98C]">تنبيه للتحقق:</b> هذه أوصاف عامة لأنواع الأطباق والعادات ولا تنسبها إلى مكان محدّد. التوفّر والتوابل والأسعار قابلة للتغيّر؛ تحقّق ميدانياً قبل الزيارة. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
      </div>
    </div>
  </section>
</GuideLayout>
