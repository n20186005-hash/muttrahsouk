---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'المطاعم والمقاهي', href: '/food/nearby-restaurants/' },
  { name: 'مطاعم السمك' },
];

const quickFacts = [
  { label: 'المصدر', value: 'الصيد اليومي من ميناء مطرح وسوق السمك' },
  { label: 'أنواع شائعة', value: 'الكنعد والهامور والتونة والسردين' },
  { label: 'طرق التحضير', value: 'مشوي أو مقلي أو ضمن أطباق الأرز' },
  { label: 'أوقات الذروة', value: 'الغداء والعشاء؛ والنشاط الصباحي في السوق' },
];

const faq = [
  { q: 'لماذا يشتهر مطرح بالمأكولات البحرية؟', a: 'لأن السوق يقع على الميناء مباشرةً، ويصل الصيد الطازج إلى سوق السمك الحديث صباحاً، فتكون المطاعم المجاورة قريبة من المصدر وممكّنة من الحصول على السمك الطازج.' },
  { q: 'كيف أختار السمك الطازج؟', a: 'ابحث عن عين صافية ولحم متماسك ورائحة بحرية نظيفة بلا زفارة، واطلب من البائع أن يريك المقطع لتفقد نضارة اللحم. عند الطهي في المطعم اسأل عن نوع السمك وطريقة تحضيره.' },
  { q: 'ما أشهر أطباق السمك في مطرح؟', a: 'يُقدَّم السمك مشوياً على الفحم (المشواي)، أو مقلياً، أو ضمن أطباق الأرز بالبهارات. وتشمل الأنواع الشائعة الكنعد والهامور والتونة والسردين بحسب الموسم.' },
  { q: 'هل أشتري السمك لأطبخه بنفسي؟', a: 'نعم، يمكن الشراء من السوق للطهي المنزلي، لكن تحقّق من نظافة العرض وطريقة التخزين ووجود الثلج، واحرص على نقل السمك سريعاً في جو بارد لتقليل تلفه في حرارة عُمان.' },
  { q: 'ما أفضل وقت لرؤية النشاط في سوق السمك؟', a: 'صباحاً مبكراً حين يصل الصيد وتزدحم حركة البيع، وقبل اشتداد الحرارة. بعد ذلك يهدأ السوق تدريجياً، وقد تنتهي الكميات الأجود مبكراً.' },
];

const sources = [
  { label: 'Muttrah Fish Market', org: 'Snøhetta (الجهة المصمّمة)', url: 'https://old.snohetta.com/projects/359-muttrah-fish-market', desc: 'وصف المبنى الحديث لسوق السمك: تصميم يتسع لأكثر من مئة بائع، ويقول إن العميل هو بلدية مسقط.' },
  { label: 'بلدية مسقط', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/', desc: 'الجهة البلدية المسؤولة عن المرافق العامة في مسقط.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق محافظة مسقط وواجهتها البحرية وسوقها التقليدي.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لاستكشاف السوق والميناء؛ تحقّق قبل الانطلاق.' },
];

const related = [
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'أنواع المطاعم حول الكورنيش وكيف تختار بينها.' },
  { href: '/around/fish-market/', label: 'سوق السمك في مطرح', desc: 'النشاط الصباحي في المبنى الحديث قرب الميناء.' },
  { href: '/food/omani-food/', label: 'الأكلات العُمانية', desc: 'الأطباق التقليدية وعادات الضيافة.' },
  { href: '/visit/hot-weather/', label: 'الزيارة في الصيف', desc: 'الحرارة والرطوبة وكيف تخطط لفترات قصيرة.' },
];
---
<GuideLayout
  title="مطاعم السمك في مطرح: الطزاجة والأطباق والأوقات"
  h1="مطاعم السمك في مطرح: كيف تختار وتأكل طازجاً"
  description="دليل المأكولات البحرية حول مطرح: الصلة بين سوق السمك والصيد والمطاعم، واختيار السمك الطازج، وأشهر الأطباق، وأوقات الذروة، والاحتياطات صيفاً."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        <div>
          <p class="kicker">من الميناء إلى الطبق</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d]">العلاقة بين سوق السمك والصيد والمطاعم المجاورة</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="يقع مبنى سوق السمك الحديث في قلب مطرح على الميناء، وهو مبنى صُمّم ليخدم الحركة اليومية للصيد على مستوى المنطقة، ويتسع لأكثر من مئة بائع ومقطّع للسمك بحسب الجهة المصمّمة." /></p>
            <p><BidiText text="هذا القرب يجعل المطاعم المجاورة قادرة على الحصول على السمك الطازج في صباح كل يوم. فالصلة بين الصيد والمطاعم ليست فقط تجارية، بل تشكّل جزءاً من الحياة اليومية في مطرح." /></p>
          </div>
        </div>
        <div>
          <h2 class="display text-3xl font-black text-[#18110d]">الطزاجة وكيف تختار السمك</h2>
          <div class="mt-4 space-y-4 text-[#58483e]">
            <p><BidiText text="ابحث عن علامات الطزاجة: عين صافية ولحم متماسك ورائحة بحرية نظيفة بلا زفارة. عند الشراء اطلب من البائع أن يريك المقطع، وتجنّب الأسماك ذات القوام الرخو أو الرائحة النافذة." /></p>
            <p><BidiText text="في المطاعم اسأل عن نوع السمك وطريقة تحضيره إن كنت لا تعرفهما؛ فالنوع يحدّد الطعم والطريقة الأنسب للطهي، مما يساعدك على اختيار طبق يناسب ميزانيتك وذوقك." /></p>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة تحقق سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">العين:</b> صافية ولامعة.</li>
            <li><b class="text-[#18110d]">اللحم:</b> متماسك ومرن.</li>
            <li><b class="text-[#18110d]">الرائحة:</b> بحرية نظيفة لا نافذة.</li>
            <li><b class="text-[#18110d]">العرض:</b> مساحة نظيفة وثلج كافٍ.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه للتحقق:</b> النشاط والأنواع يختلفان بحسب الموسم وأيام الأسبوع، ونتائج هذا الدليل وصفية لا توصيات لأسماء تجارية. تحقّق ميدانياً قبل الزيارة. آخر مراجعة للمعلومات: <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">أطباق السمك</p>
      <h2 class="display mt-3 text-3xl font-black md:text-4xl">كيف يُقدَّم السمك عادةً؟</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">مشوي على الفحم</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="الطريقة الأشهر للمشواي، إذ يُشوى السمك كاملاً أو شرائح ويُقدَّم مع الأرز أو الخبز والليمون." /></p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">مقلي</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="خيار سريع لمحبي القرمشة، ويُقدّم عادةً مع الأرز والصلصة الجانبية." /></p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#176b68]">ضمن أطباق الأرز</h3>
          <p class="mt-3 text-sm text-[#66574e]"><BidiText text="يُدمج السمك مع الأرز المتبّل بالبهارات في طبق مشبع يشبه المجبوس بالسمك." /></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="display text-3xl font-black text-[#18110d]">الشراء للطهي والاحتياطات صيفاً</h2>
      <div class="mt-4 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="إن اشتريت السمك للطهي المنزلي، فتحقّق من نظافة العرض وطريقة التخزين ووجود الثلج الكافي، واطلب التنظيف حسب رغبتك. انقل السمك سريعاً في جو بارد لأن الحرارة العالية تسرّع تلفه." /></p>
        <p><BidiText text="في الصيف تكون الحرارة والرطوبة مرتفعة حول الميناء، فالتوقيت صباحاً أكثر راحة، ويُفضّل التقليل من الوقوف الطويل في الشمس وترطيب الجسم. أما الأمسيات فمناسبة للعشاء البحري بعد انخفاض الحرارة." /></p>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">ملاحظة:</b> أوقات الذروة وموسمية الأنواع تتغيّر بين فصل وآخر؛ إن كان نوع معيّن من السمك مهمّاً لك فاسأل عنه في يوم الزيارة.
      </div>
    </div>
  </section>
</GuideLayout>
