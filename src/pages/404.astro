---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — الصفحة غير موجودة | دليل سوق مطرح" description="الصفحة التي تبحث عنها غير متوفرة في دليل سوق مطرح. عد إلى الصفحة الرئيسية لمتابعة الاستكشاف.">
  <section class="section pt-36">
    <div class="shell max-w-4xl text-center">
      <p class="kicker">خطأ 404</p>
      <h1 class="display mt-3 text-5xl font-black">الصفحة غير موجودة</h1>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed">يبدو أن الرابط الذي فتحته غير صحيح، أو أن الصفحة انتقلت إلى مكان آخر. يمكنك العودة إلى الدليل الرئيسي لاستكشاف سوق مطرح وزيارته.</p>
      <a href="/" class="mt-10 inline-block rounded-full bg-[#176b68] px-8 py-4 text-lg font-black text-white transition hover:bg-[#1a7d7a]">العودة إلى دليل سوق مطرح</a>
    </div>
  </section>
</BaseLayout>
