---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'من مطار مسقط' },
];

const quickFacts = [
  { label: 'المطار', value: 'مسقط الدولي' },
  { label: 'الموقع', value: 'خارج حي مطرح' },
  { label: 'أسرع خيار', value: 'سيارة أجرة أو تطبيق توصيل' },
  { label: 'أسعار مؤكدة', value: 'غير متوفرة — تحقّق ميدانياً' },
];

const options = [
  { name: 'سيارة الأجرة', desc: 'متوفرة عند صالات الوصول؛ اتفق على الوجهة والطريقة قبل الانطلاق.' },
  { name: 'تطبيق توصيل', desc: 'يحدّد السعر مسبقاً غالباً؛ اكتب الوجهة بدقة ليصلك السائق إلى المدخل الصحيح.' },
  { name: 'سيارة خاصة أو مستأجرة', desc: 'مرونة أكبر مع الحقائب؛ تابع لوحات الطرق والمواقف عند الوصول.' },
  { name: 'حافلة ثم مشي', desc: 'حافلة المشغّل الوطني حتى محطة قريبة، ثم مشي أو أجرة قصيرة إلى السوق.' },
];

const sections = [
  {
    heading: 'أين يقع المطار بالنسبة للمطرح؟',
    body: [
      'يقع مطار مسقط الدولي خارج حي مطرح، في منطقة أخرى من محافظة مسقط. لذلك تحتاج إلى انتقال بالسيارة أو الأجرة أو الحافلة، ولا يمكن الوصول من المطار إلى السوق سيراً على الأقدام.',
      'المسافة ليست قصيرة جداً ولا طويلة جداً؛ لكن الزمن الفعلي يتأثر بالطريق والزحام ووقت الوصول أكثر من تأثره بالمسافة نفسها.',
    ],
  },
  {
    heading: 'خيارات الانتقال من المطار',
    body: [
      'أبسط الخيارات هو سيارة الأجرة أو تطبيق التوصيل من صالة الوصول مباشرة إلى «سوق مطرح قرب كورنيش مطرح». هذه الخيارات مريحة مع الحقائب، لكن السعر يتفاوت بحسب الشركة والوقت والطلب.',
      'يمكن كذلك استخدام سيارة خاصة أو مستأجرة إن كنت تفضّل مرونة الحركة، أو الجمع بين الحافلة ثم المشي أو أجرة قصيرة. حساب الوقت الإضافي ضروري في هذا الخيار الأخير.',
    ],
  },
  {
    heading: 'ما الذي يغيّر مدة الرحلة',
    body: [
      'ساعات الذروة صباحاً ومساءً ترفع زمن الرحلة، كذلك العطلات والمناسبات. الطريق الذي تختاره أيضاً يؤثر، لأن بعض المسارات أطول لكنها أقل ازدحاماً.',
      'وكقاعدة عامة: لا تبنِ خطة زمنية ضيقة على أفضل احتمال، بل اترك هامشاً. إضافة عشر أو خمس عشرة دقيقة احتياطية قد تمنع تأخيراً عن موعد مهم.',
    ],
  },
  {
    heading: 'الحقائب وترتيبات الوصول',
    body: [
      'إن كانت معك حقائب كبيرة، فالحافلة قد لا تكون الخيار الأنسب بسبب المساحة وأمور النقل في آخر الطريق. سيارة الأجرة أو التطبيق قدّم مساحة أكبر ووصولاً أقرب إلى المدخل.',
      'عند الوصول إلى السوق، لا تنزل في مكان يعرقل الحركة، بل اطلب نقطة نزول قريبة من المدخل أو من الكورنيش لتكمل مشياً قصيراً. احرص على أن يبقى معك ما تحتاجه فقط داخل السوق إن كنت ستترك الحقائب في وسيلة النقل.',
    ],
  },
  {
    heading: 'نصائح التسعير والاتفاق',
    body: [
      'قبل الانطلاق، اسأل عن تقدير التكلفة والوقت. في التطبيقات يظهر السعر مسبقاً عادةً، أما مع سيارة الأجرة فمن الأفضل الاتفاق على الوجهة وطريقة الحساب قبل الركوب لتجنّب الاختلاف عند الوصول.',
      'احتفظ بقدر من العملة المحلية للمبالغ الصغيرة، وتأكد من وسيلة الدفع قبل الرحلة إن كنت تعتمد على البطاقة. إن كان العرض غير واضح، فمن حقك أن ترفض وتختار وسيلة أخرى.',
    ],
  },
  {
    heading: 'لا أرقام أسعار مؤكدة',
    body: [
      'لا نقدّم في هذه الصفحة رقماً ثابتاً لتكلفة السيارة أو الحافلة، لأن الأسعار تتغير بحسب الشركة والوقت والطلب والمسافة. أي سعر تقرأه هنا سيكون عرضة للتقادم.',
      'تحقّق من التطبيق أو من مصدر المشغّل الرسمي قبل الانطلاق لمعرفة التكلفة الحالية. هذا أضمن من الاعتماد على أرقام منشورة سابقاً.',
    ],
  },
];

const faq = [
  { q: 'كم تستغرق الرحلة من المطار إلى سوق مطرح؟', a: 'تتفاوت المدة بحسب الطريق والزحام ووقت الوصول؛ لا نقدّم رقماً ثابتاً. اترك هامشاً احتياطياً في خطتك، خصوصاً في ساعات الذروة.' },
  { q: 'هل يمكن الوصول من المطار مشياً؟', a: 'لا؛ المطار خارج حي مطرح وتحتاج إلى انتقال بسيارة أو أجرة أو حافلة، ثم مشياً قصيراً في آخر الطريق.' },
  { q: 'ما أسهل خيار مع الحقائب؟', a: 'سيارة الأجرة أو تطبيق التوصيل مباشرة من صالة الوصول إلى محيط السوق، لأنهما يوفّران مساحة أكبر ووصولاً أقرب إلى المدخل.' },
  { q: 'هل الأسعار ثابتة؟', a: 'لا نقدّم أسعاراً مؤكدة؛ فهي تتغير بحسب الشركة والوقت. تحقّق من التطبيق أو من المصدر الرسمي قبل الانطلاق.' },
  { q: 'هل أحتاج العملة النقدية؟', a: 'من المفيد حمل قدر من العملة المحلية للمبالغ الصغيرة، مع التأكد من وسيلة الدفع قبل الرحلة إن كنت ستعتمد على البطاقة.' },
];

const sources = [
  { label: 'مواصلات — النقل الوطني', org: 'شركة النقل الوطنية (رسمي)', url: 'https://mwasalat.om/', desc: 'خيارات الحافلة من وإلى مطار مسقط الدولي ومحيط مسقط؛ تحقّق من الجداول الحالية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة المكان لتقدير المسار ونقطة النزول قرب المدخل.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق عام لمحافظة مسقط وموقع مطرح فيها.' },
];

const related = [
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'نقطة النزول الصحيحة عند الوصول.' },
  { href: '/visit/bus/', label: 'الوصول بالحافلة', desc: 'تفاصيل خيار الحافلة ثم المشي.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'إن وصلت بسيارة خاصة أو مستأجرة.' },
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'ترتيب زمني يجمع السوق والكورنيش والمعالم.' },
];
---
<GuideLayout
  title="من مطار مسقط الدولي إلى سوق مطرح: خيارات النقل | دليل سوق مطرح"
  h1="من مطار مسقط الدولي إلى سوق مطرح"
  description="الوصول من مطار مسقط الدولي إلى سوق مطرح: سيارة الأجرة وتطبيقات التوصيل والسيارة الخاصة والحافلة ثم المشي، مع تفاوت المدة ونصائح الحقائب والتسعير."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">من المطار</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">أربع طرق للوصول من المطار إلى السوق</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="الرحلة من مطار مسقط الدولي إلى سوق مطرح رحلة قصيرة نسبياً بالسيارة، ولا تتطلب أكثر من اختيار وسيلة نقل مناسبة لحجم الحقائب ووقت وصولك. رتّب الخيار قبل مغادرة الصالة لتبدأ زيارتك بهدوء." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {options.map((o) => (
          <div class="card rounded-3xl p-6">
            <b class="block text-lg font-black text-[#176b68]">{o.name}</b>
            <p class="mt-3 text-sm text-[#66574e]"><BidiText text={o.desc} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">اكتب الوجهة بدقة</p>
          <p class="mt-3 text-sm text-[#66574e]">«مطرح» وحدها قد تقودك إلى جزء آخر من الحي؛ اكتب «سوق مطرح قرب كورنيش مطرح» لتقترب من المدخل الصحيح. رمز المطار الدولي هو <bdi dir="ltr">MCT</bdi>.</p>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> أسعار النقل من المطار ومواعيد الحافلات تتغير باستمرار. لا تعتمد على أي رقم في هذه الصفحة؛ تحقّق من التطبيق أو المصدر الرسمي للمشغّل قبل الانطلاق.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
