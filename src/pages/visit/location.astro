---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'الموقع والخريطة' },
];

const quickFacts = [
  { label: 'المدينة والحي', value: 'مطرح، محافظة مسقط، سلطنة عُمان' },
  { label: 'أقرب معلم', value: 'كورنيش مطرح والميناء' },
  { label: 'رمز Plus Code', value: 'JHC7+5Q مسقط' },
  { label: 'الإحداثيات التقريبية', value: '23.6204, 58.5645' },
];

const sections = [
  {
    heading: 'أين يقع سوق مطرح بالضبط؟',
    body: [
      'يقع السوق في حي مطرح على الواجهة البحرية لمحافظة مسقط، ملاصقاً لكورنيش مطرح وقريباً من الميناء التجاري. العنوان الشائع عند البحث هو «سوق مطرح، بالقرب من كورنيش مطرح، مسقط، عُمان»، ورمز Plus Code المسجّل للمكان هو JHC7+5Q.',
      'الإحداثيات التقريبية للمدخل الرئيسي على خرائط جوجل هي 23.6204 شمالاً و58.5645 شرقاً. هذه القيم مفيدة لتقريب الخريطة في تطبيقات الملاحة، لكن الأفضل دائماً فتح رابط المكان مباشرة لتجنّب أي انحراف في نقطة الوصول.',
    ],
  },
  {
    heading: 'الفرق بين «مطرح» و«سوق مطرح»',
    body: [
      'كثير من الباحثين يكتبون «مطرح» فقط، وهو اسم الحي السكني والتجاري الكبير الذي يشمل الكورنيش والميناء وسوق السمك وقلعة مطرح وجزءاً من مسقط القديمة. أما «سوق مطرح» فهو الجزء التجاري التقليدي المسقوف داخل هذا الحي.',
      'لذلك إذا كان هدفك هو الأزقة والمحال التقليدية فاجعل وجهتك «سوق مطرح»، وإذا كنت تبحث عن الواجهة البحرية أو الميناء فالوجهة «كورنيش مطرح». المسافة بين الاثنين مشي قصير لا يتجاوز دقائق.',
    ],
  },
  {
    heading: 'كيف تصل إلى نقطة الوصول الصحيحة',
    body: [
      'أنسب نقطة نزول هي أقرب موقف أو مدخل على الكورنيش. من هناك يمكنك رؤية الواجهة البحرية ثم الاتجاه نحو مدخل السوق، والتفاصيل في دليل المداخل والبوابات.',
      'عند طلب سيارة أجرة أو تطبيق توصيل اكتب «سوق مطرح قرب كورنيش مطرح» بدلاً من «مطرح» وحدها، لأن الأخيرة قد تقودك إلى جزء آخر من الحي. تحقق من اللوحات المحلية عند الوصول لأن بعض الطرق حول الكورنيش أحادية الاتجاه في أوقات معينة.',
    ],
  },
];

const faq = [
  { q: 'ما رمز Plus Code لسوق مطرح؟', a: 'رمز المكان المسجّل هو JHC7+5Q مسقط، وهو أقصر طريقة لفتح الموقع مباشرة في تطبيقات الخرائط التي تدعم هذا الرمز.' },
  { q: 'هل السوق داخل مسقط القديمة؟', a: 'لا. سوق مطرح في حي مطرح، أما مسقط القديمة (التي تضم قصر العلم والمتحف الوطني) فهي منطقة مجاورة تحتاج انتقالاً قصيراً بالسيارة أو سيارة الأجرة.' },
  { q: 'هل يمكن الوصول مشياً من الكورنيش؟', a: 'نعم، العلاقة بين الكورنيش والسوق مشي مباشر وقصير، وغالباً يكون المشي أسهل من البحث عن موقف قريب من المدخل في أوقات الذروة.' },
];

const sources = [
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'اللقطة المرجعية للموقع والإحداثيات ورمز Plus Code؛ تحقّق من التحديث قبل الانطلاق.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان وسياقه الجغرافي داخل مسقط.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف البلدي لموقع السوق وواجهته البحرية وأعمال التطوير المحيطة.' },
];

const related = [
  { href: '/visit/opening-hours/', label: 'أوقات عمل سوق مطرح', desc: 'ساعات الزيارة المعتادة وتنبيهات الجُمَع والعطلات.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'أين توقف السيارة وكيف تستعد للازدحام.' },
  { href: '/visit/entrances/', label: 'المداخل والبوابات', desc: 'أقرب مدخل بحسب مكان وصولك.' },
];
---
<GuideLayout
  title="أين يقع سوق مطرح؟ الموقع والخريطة والإحداثيات | دليل سوق مطرح"
  h1="موقع سوق مطرح والخريطة وطريقة الوصول"
  description="أين يقع سوق مطرح في مسقط بالضبط: رمز Plus Code والإحداثيات التقريبية، الفرق بين حي مطرح والسوق، وأفضل نقطة وصول على كورنيش مطرح."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="overflow-hidden rounded-[2rem] border-4 border-white shadow-xl">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6501.9319845401915!2d58.5645!3d23.6204018!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e91f78583a8b82f%3A0x14ead28d3c8b5dc0!2sMutrah%20Souq!5e1!3m2!1sar!2som!4v1788187915378!5m2!1sar!2som"
            width="600"
            height="420"
            style="border:0;width:100%;min-height:380px"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="خريطة موقع سوق مطرح في مسقط"
          ></iframe>
        </div>
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">معلومات الوصول</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">العنوان:</b> سوق مطرح، بالقرب من كورنيش مطرح، مسقط، عُمان</li>
            <li><b class="text-[#18110d]">Plus Code:</b> <bdi dir="ltr">JHC7+5Q</bdi> مسقط</li>
            <li><b class="text-[#18110d]">الإحداثيات:</b> <bdi dir="ltr">23.6204, 58.5645</bdi></li>
            <li><b class="text-[#18110d]">الحي:</b> مطرح — محافظة مسقط</li>
          </ul>
          <a class="mt-5 inline-flex rounded-full bg-[#E2A52E] px-5 py-2.5 font-black text-[#18110d]" href={mapUrl} target="_blank" rel="nofollow noopener">افتح الموقع في خرائط جوجل</a>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> الإحداثيات ورمز Plus Code تقريبية وتُستخدم للوصول فقط؛ لا تعتمد عليها كمصدر مساحي دقيق، وتحقق من الطرق المغلقة مؤقتاً حول الكورنيش.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
