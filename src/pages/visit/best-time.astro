---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'أفضل وقت للزيارة' },
];

const quickFacts = [
  { label: 'الفترة الموصى بها رسمياً', value: 'سبتمبر إلى مايو' },
  { label: 'الأكثر هدوءاً', value: 'الصباح' },
  { label: 'الأكثر حيوية', value: 'المساء' },
  { label: 'الأشد حرارة ورطوبة', value: 'يونيو إلى أغسطس' },
];

const sections = [
  {
    heading: 'الفترة الأنسب وفق المصدر الرسمي',
    body: [
      'تذكر بوابة عُمان السياحية الرسمية أن أفضل فترة لزيارة سوق مطرح تمتد من سبتمبر إلى مايو. هذه الفترة تشمل الخريف والشتاء والربيع، وتكون فيها الأجواء أكثر اعتدالاً للتنقّل في الهواء الطلق وعلى الواجهة البحرية.',
      'هذا لا يعني أن الزيارة مستحيلة خارج هذه الفترة، بل إن التجربة تكون ألطف وأطول داخل الفترة المذكورة، وقد تحتاج صيفاً إلى تقصير الجولة والاعتماد أكثر على الظل والأمسيات.',
    ],
  },
  {
    heading: 'صباح أهدأ ومساء أكثر حيوية',
    body: [
      'الصباح يمنحك سوقاً أهدأ: ممرات أقل ازدحاماً، وفرصة أفضل للتأمل والتحدث مع الباعة والتصوير دون عجلة. هذا الوقت مناسب للعائلات وللزوار الذين يفضّلون التجوّل ببطء.',
      'أما المساء فيجمع أكبر قدر من الحركة والحيوية، مع إضاءة داخلية وأجواء اجتماعية. إن أردت أن ترى السوق في أوج نشاطه، فاجعل المساء موعدك، واحسب وقتاً إضافياً للازدحام والمواقف.',
    ],
  },
  {
    heading: 'الحرارة والرطوبة في الصيف',
    body: [
      'بين يونيو وأغسطس ترتفع الحرارة والرطوبة في مسقط، ويصبح المشي في الهواء الطلق في منتصف النهار متعباً. داخل الأزقة المسقوفة يوجد ظل يحمي نسبياً، لكن الحرارة تظل مرتفعة خاصة في الممرات غير المكيّفة.',
      'الحل العملي في الصيف هو تقصير الجولة والاعتماد على فترتين: صباح مبكر أو مساء بعد انكسار الحرارة، مع شرب الماء والاستراحة المتكررة. راجع صفحة الزيارة في الصيف لمزيد من التفاصيل.',
    ],
  },
  {
    heading: 'العطلات والمناسبات ورمضان',
    body: [
      'في عطلات نهاية الأسبوع والأعياد والمناسبات الوطنية يشهد محيط السوق ازدحاماً أكبر وتتغير الساعات أحياناً. إن كان هدوءك هو الأهم، فخفّض احتمال الزيارة في أوقات العطلات المزدحمة أو اذهب في وقت أبكر.',
      'في رمضان ينتقل إيقاع السوق إلى المساء وما بعد الإفطار بشكل واضح، وتتركز الحركة في فترة الليل. راجع صفحة السوق في رمضان لتفهم كيف تتغير الأوقات والأجواء.',
    ],
  },
  {
    heading: 'الضوء والتصوير',
    body: [
      'إن كان هدفك التصوير، فلكل وقت طابعه: ضوء الصباح الناعم يظهر تفاصيل الأسقف الخشبية والألوان، بينما يوفر المساء أضواءً داخلية ومزاجاً أدفأ. الوقت الأكثر إثارة غالباً هو ما حول غروب الشمس، حين يتحول الضوء على الواجهة.',
      'احترم دائماً الخصوصية: استأذن قبل تصوير الأشخاص أو الباعة، وتذكّر أن بعض الممرات ضيقة وقد تسبب ازدحاماً إن توقفت للتصوير. راجع صفحة التصوير وآداب الزيارة.',
    ],
  },
  {
    heading: 'كيف توازن بين الهدوء والحركة',
    body: [
      'القرار بسيط: إن أردت الهدوء فالصباح، وإن أردت الحيوية فالمساء، وإن كان الجو حاراً فالأمسية هي الحل. يمكنك أيضاً تقسيم الزيارة: جولة صباحية قصيرة للتسوق المريح، ثم عودة بعد الغروب للأجواء المضيئة.',
      'تحقّق دائماً من ساعات العمل في يوم زيارتك بالذات، لأن ما يصلح يوم أسبوع قد لا يصلح يوم جمعة أو عطلة.',
    ],
  },
];

const faq = [
  { q: 'ما أفضل شهر لزيارة سوق مطرح؟', a: 'تذكر بوابة عُمان السياحية الرسمية أن الفترة من سبتمبر إلى مايو هي الأفضل للزيارة، لأن الأجواء فيها أكثر اعتدالاً. أي شهر داخل هذه الفترة يمنحك تجربة مريحة نسبياً.' },
  { q: 'هل الصباح أم المساء أفضل؟', a: 'الصباح أهدأ وأنسب للتصوير والتسوق المريح، والمساء أكثر حيوية ويمنح السوق أجواءً مضيئة واجتماعية. الخيار يعتمد على ما تفضّله.' },
  { q: 'هل الزيارة ممكنة في الصيف؟', a: 'نعم، لكن الأفضل أن تكون في صباح مبكر أو مساء لتجنّب الحرارة والرطوبة المرتفعتين، مع شرب الماء والاستراحة المتكررة.' },
  { q: 'هل الأجواء مختلفة في رمضان؟', a: 'نعم؛ في رمضان تنتقل الحركة إلى المساء وما بعد الإفطار بشكل واضح، وقد تتغير الساعات. تحقّق من الأوقات في يوم زيارتك.' },
  { q: 'ما أفضل وقت للتصوير؟', a: 'ضوء الصباح الناعم مناسب لتفاصيل الأسقف، والمساء يمنح أضواءً داخلية دافئة. وقت ما حول الغروب من أجمل الأوقات على الواجهة البحرية.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'تحديد فترة الزيارة المناسبة (سبتمبر–مايو) والتعريف بالمكان.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف الممرات المسقوفة وحركة الزوار الموسمية في السوق.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'بطاقة المكان لمقارنة ساعات الصباح والمساء قبل التخطيط.' },
];

const related = [
  { href: '/visit/opening-hours/', label: 'أوقات عمل سوق مطرح', desc: 'ساعات الزيارة المعلنة وتنبيهات الجمعة والعطلات.' },
  { href: '/visit/hot-weather/', label: 'زيارة مطرح في الصيف', desc: 'نصائح الحرارة والرطوبة وتقليل الجهد.' },
  { href: '/visit/ramadan/', label: 'سوق مطرح في رمضان', desc: 'تغيّر الإيقاع والساعات في الشهر الفضيل.' },
  { href: '/itineraries/sunset-photo/', label: 'التصوير والغروب في مطرح', desc: 'أفضل مواقع وتوقيتات ضوء الغروب.' },
];
---
<GuideLayout
  title="أفضل وقت لزيارة سوق مطرح: الفصول والصباح والمساء | دليل سوق مطرح"
  h1="أفضل وقت لزيارة سوق مطرح"
  description="متى تزور سوق مطرح: فترة سبتمبر–مايو وفق المصدر الرسمي، والمقارنة بين الصباح الهادئ والمساء النشِط، وأثر الحرارة والعطلات ورمضان والتصوير."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">التخطيط الزمني</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">اختر الوقت بحسب ما تريده من الزيارة</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="لا يوجد وقت واحد «الأفضل» للجميع؛ فمن يبحث عن الهدوء يجد ضالته في الصباح، ومن يريد الحيوية يفضّل المساء، ومن يهرب من الحرارة يختار الفترة الأكثر اعتدالاً من السنة. حدّد أولاً ما تريده ثم اختر التوقيت المناسب." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الصباح</b>
          <p class="mt-3 text-sm text-[#66574e]">ممرات أهدأ، وأجواء أبرد، ومساحة أكبر للتأمل والتصوير والتحدث مع الباعة دون عجلة.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">المساء</b>
          <p class="mt-3 text-sm text-[#66574e]">أكبر عدد من المحال المفتوحة، وإضاءة داخلية، ومزاج اجتماعي حيّ يمنح السوق طابعه الكامل.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">جدول مختصر للاختيار</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">للتصوير:</b> صباح ناعم أو وقت الغروب.</li>
            <li><b class="text-[#18110d]">للبيع والشراء:</b> توقّع أكبر خيار في المساء.</li>
            <li><b class="text-[#18110d]">مع الأطفال:</b> صباح أو أمسية بعد انكسار الحرارة.</li>
            <li><b class="text-[#18110d]">في الصيف:</b> صباح مبكر أو ليلاً.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> توصية الفصول مستقرة نسبياً، لكن الساعات الفعلية تتغير في العطلات والمناسبات ورمضان. تحقّق من الأوقات في يوم زيارتك بالذات.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
