---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'الوصول بالحافلة' },
];

const quickFacts = [
  { label: 'المشغّل الوطني', value: 'شركة النقل الوطنية (مواصلات)' },
  { label: 'يخدم', value: 'خطوط داخل مسقط ومطرح' },
  { label: 'مصدر الجداول', value: 'الموقع الرسمي للمشغّل' },
  { label: 'آخر ميل', value: 'المشي من أقرب محطة إلى المدخل' },
];

const sections = [
  {
    heading: 'من يشغّل الحافلات في مسقط؟',
    body: [
      'النقل العام بالحافلات في سلطنة عُمان يتولاه المشغّل الوطني المعروف باسم مواصلات. يوفّر المشغّل خطوطاً مدينية داخل مسقط وخطوطاً بين المدن، ولديه محطات ومواقف معلنة، منها محطة الحافلات في روي ونقطة قريبة من مطار مسقط الدولي.',
      'الأسعار الرسمية والمسارات وجداول المواعيد تُنشر عبر قنوات المشغّل. لذلك فإن أي معلومة عن خط أو تذكرة يجب أن تُقتبس من هذه القنوات مباشرة، لا من ملخصات قديمة.',
    ],
  },
  {
    heading: 'هل توجد حافلة تخدم مطرح؟',
    body: [
      'تشير القوائم الرسمية للمشغّل إلى خطوط مدينية تخدم مناطق مسقط المختلفة، ومنها ما يمرّ بمحيط مطرح. كما أدرجت جداول أقدم أسماء مواقف مثل «سوق مطرح» و«سوق السمك» ضمن بعض الخطوط التي تصل إلى الواجهة البحرية بمطرح.',
      'هذه الأسماء تظهر في مستندات قديمة ولا نضمن أنها ما تزال محطات تشغيل حالية. لذلك نعرض هنا المبدأ فقط: يوجد نقل عام يخدم المنطقة، لكن رقم الخط والمحطة الحالية يجب التحقق منهما من المشغّل.',
    ],
  },
  {
    heading: 'لا تبنِ خطتك على جدول قديم',
    body: [
      'قد تجد في المواقع غير الرسمية أرقام خطوط وأسعاراً وجداول لرحلات تخدم مطرح. بعض هذه البيانات قديم أو تعرّض للتغيير بعد إعادة تنظيم الخطوط، وقد لا يعكس الوضع اليوم.',
      'قاعدة آمنة: اعتبر أي رقم خط أو سعر رأيته في مدونة أو منشور قديم مجرد معلومة غير مؤكدة، وتحقّق منها في الموقع الرسمي أو عند شبّاك المشغّل قبل الاعتماد عليها في تنقّلك.',
    ],
  },
  {
    heading: 'كيف تتحقق من المسار والتوقيت والتذكرة',
    body: [
      'ابدأ من الموقع الرسمي للمشغّل، وابحث عن الخطوط المدينية الخاصة بمسقط. حدّد أقرب محطة انطلاق إلى مكانك (مثل محطة مركزية في مسقط) ثم ابحث عن خط يتوقف في محيط مطرح.',
      'بعد ذلك تحقّق من ثلاثة أمور: أوقات الانطلاق والعودة، وسعر التذكرة وطريقة الدفع، وما إذا كان بإمكانك حمل حقائب أو أمتعة. عند الشك، تواصل مع خدمة عملاء المشغّل أو اسأل عند المحطة؛ فالجدول المعلن قد يختلف في العطلات.',
    ],
  },
  {
    heading: 'آخر ميل: من المحطة إلى السوق',
    body: [
      'حتى لو وُجدت محطة قريبة، فمن المرجّح أن تحتاج إلى مشي قصير للوصول إلى أحد مداخل السوق. جهّز نفسك للمشي في الهواء الطلق: قبعة وماء في فترات الحرارة، وحذر عند عبور الشوارع القريبة من الميناء.',
      'إن كان المشي صعباً عليك، فيمكنك إكمال آخر جزء من الطريق بسيارة أجرة قصيرة، أو اختيار خيار نقل مكمّل يوصلك أقرب إلى الواجهة البحرية.',
    ],
  },
  {
    heading: 'خيارات مكمّلة للحافلة',
    body: [
      'قد يكون الجمع بين وسيلتَي نقل أسرع من الاعتماد على الحافلة وحدها: حافلة حتى محطة قريبة، ثم مشي أو سيارة أجرة قصيرة. كذلك يمكن للحافلة أن تكون خيار العودة بعد جولة مسائية، إن تأكدت من موعد آخر رحلة.',
      'تحقّق دائماً من موعد آخر رحلة عائدة قبل التخطيط لجولة مسائية، لأن الاعتماد على رحلة متأخرة غير مؤكدة قد يتركك دون خيار نقل.',
    ],
  },
];

const faq = [
  { q: 'هل توجد حافلة تصل إلى سوق مطرح؟', a: 'نعم، لدى المشغّل الوطني خطوط مدينية تخدم مسقط ومناطقها ومنها محيط مطرح. لكن رقم الخط والمحطة الحالية يجب التحقق منهما من الموقع الرسمي للمشغّل قبل الانطلاق.' },
  { q: 'لماذا لا تقدّمون جدولاً للخطوط؟', a: 'لأن الجداول وأرقام الخطوط تتغير، واعتماد جدول قديم قد يؤدي إلى معلومة خاطئة. الأفضل البحث في قناة المشغّل الرسمية مباشرة.' },
  { q: 'كم تبعد المحطة عن مدخل السوق؟', a: 'يعتمد على المحطة التي تستخدمها، لكن توقّع مشياً قصيراً من أقرب موقف إلى أحد مداخل السوق.' },
  { q: 'كيف أدفع تذكرة الحافلة؟', a: 'طرق الشراء (نقداً أو إلكترونياً) وتفاصيلها تُحدَّد من المشغّل؛ راجع الموقع الرسمي أو اسأل عند المحطة للتأكد من الطريقة المتاحة حالياً.' },
  { q: 'هل الحافلة مناسبة في رمضان والعطلات؟', a: 'قد تتغير مواعيد الخطوط في رمضان والعطلات وتزداد الحاجة للتحقق. راجع الجدول الرسمي في يوم زيارتك ولا تعتمد على مواعيد سابقة.' },
];

const sources = [
  { label: 'مواصلات — النقل الوطني', org: 'شركة النقل الوطنية (رسمي)', url: 'https://mwasalat.om/', desc: 'المصدر الرسمي للمسارات والجداول المدينية والبينية والتذاكر؛ تحقّق من البيانات الحالية.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق عام لمسقط ومطرح وموقع المطرح على الواجهة البحرية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة المكان لمقارنة أقرب المحطات ومسارات المشي إلى المدخل.' },
];

const related = [
  { href: '/visit/from-airport/', label: 'من مطار مسقط إلى سوق مطرح', desc: 'خيارات النقل من المطار وترتيب الحقائب.' },
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'نقطة الوصول الصحيحة قبل البحث عن النقل.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'إن اخترت إكمال الطريق بالسيارة أو الأجرة.' },
  { href: '/visit/cruise-port/', label: 'من ميناء السلطان قابوس', desc: 'الوصول من الميناء إلى السوق ضمن وقت التوقف.' },
];
---
<GuideLayout
  title="الوصول إلى سوق مطرح بالحافلة: خطوط مواصلات والتحقق | دليل سوق مطرح"
  h1="الوصول إلى سوق مطرح بالحافلة"
  description="كيف تصل إلى سوق مطرح بالحافلة عبر المشغّل الوطني للنقل في عُمان: خطوات التحقق من المسار والتوقيت والتذكرة، ولماذا لا نعتمد على جدول قديم، وخيارات مكمّلة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">بالنقل العام</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">الحافلة خيار واقعي… بشرط التحقق</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="النقل بالحافلة إلى مطرح ممكن عبر المشغّل الوطني، لكن قيمته تعتمد على دقة المعلومة. لذلك جرت العادة في هذا الدليل على إعطائك المنهج الصحيح للتحقق بدلاً من جدول قد لا يزال صالحاً." /></p>
      </div>
      <ol class="mt-10 grid gap-5 md:grid-cols-2">
        <li class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">١. اذهب إلى الموقع الرسمي</b>
          <p class="mt-3 text-sm text-[#66574e]">ابدأ من موقع المشغّل الوطني، وليس من منشورات قديمة على الشبكات الاجتماعية.</p>
        </li>
        <li class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">٢. حدّد أقرب محطة</b>
          <p class="mt-3 text-sm text-[#66574e]">اعرف أقرب موقف انطلاق إلى مكانك ثم ابحث عن خط يمرّ بمحيط مطرح.</p>
        </li>
        <li class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">٣. تحقّق من المواعيد</b>
          <p class="mt-3 text-sm text-[#66574e]">راجع موعد الذهاب وآخر رحلة عائدة، خصوصاً إن خططت لجولة مسائية.</p>
        </li>
        <li class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">٤. تأكد من التذكرة</b>
          <p class="mt-3 text-sm text-[#66574e]">اعرف السعر الحالي وطريقة الدفع المسموحة، وهل يمكن حمل أمتعة على الخط.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">تنبيه على الأرقام القديمة</p>
          <p class="mt-3 text-sm text-[#66574e]">قد تصادف أرقام خطوط أو أسعاراً في أدلة غير رسمية؛ لا تعتمد عليها كواقع حالي. المصدر النهائي هو المشغّل الرسمي، والاسم اللاتيني للمشغّل هو <bdi dir="ltr">Mwasalat</bdi>.</p>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> الخطوط والمواعيد والأسعار قابلة للتغيير في أي وقت. تحقّق من الموقع الرسمي للمشغّل أو من شبّاك المحطة قبل الانطلاق، خصوصاً في رمضان والعطلات والمناسبات.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
