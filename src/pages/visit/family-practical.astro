---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'الزيارة مع الأطفال' },
];

const quickFacts = [
  { label: 'الأنسب مع الأطفال', value: 'الصباح الباكر أو بعد العصر' },
  { label: 'عربة الأطفال', value: 'تُقيَّم ميدانياً على أرض غير مستوية' },
  { label: 'المرافق ودورات المياه', value: 'تحتاج تأكيداً عند المدخل' },
  { label: 'فواصل الراحة', value: 'الكورنيش ومناطق الجلوس قربه' },
];

const faq = [
  { q: 'هل سوق مطرح مناسب للأطفال؟', a: 'نعم بشكل عام، فالممرات قصيرة والتجربة حسّية وممتعة للصغار بسبب الروائح والألوان. التحدي الأساسي هو الازدحام وضيق بعض الأزقة وعدم استواء الأرض، لذا التوقيت الأهدأ ونظرة مستمرة للطفل تصنعان الفرق.' },
  { q: 'هل يمكن استخدام عربة أطفال داخل السوق؟', a: 'لا يمكننا الجزم بذلك دون تحقق ميداني؛ الأزقة ضيقة والأرض غير مستوية وقد توجد درجات في بعض الأجزاء. في المداخل ومحور الكورنيش يكون الأمر أسهل عادةً، لكن عمق السوق قد يتطلب حمل الطفل أو طيّ العربة. قرّر عند المدخل بحسب ما تراه.' },
  { q: 'أين نجد دورات مياه أو مرافق قريبة؟', a: 'لا نضمّن ضماناً بوجود مرافق مفتوحة أو مهيأة. تذكر بعض المصادر أعمال تطوير لمرافق قرب مداخل السوق، لكن ذلك إفادة تطوير لا ضمان للحالة الحالية. اسأل عند المدخل أو في المحال عن أقرب مرفق قبل الحاجة إليه.' },
  { q: 'ما التوقيت الأسهل للعائلة؟', a: 'الصباح الباكر أهدأ وأبرد، وفترة ما بعد العصر أنشط لكن أكثر ازدحاماً. تجنّب الظهيرة صيفاً، ولا تطارد كل الأزقة في جلسة واحدة؛ اترك مساحة لراحة الطفل.' },
  { q: 'كيف نتعامل مع الزحام داخل الأزقة؟', a: 'سِر بخط واحد مضغوط، واتفق على نقطة لقاء محددة إن انفصلتم، ولا تتوقفوا في منتصف الممر الضيق. في الازدحام الشديد الأفضل الخروج إلى محور الكورنيش الأوسع ثم العودة.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف بالمكان وفترة الزيارة المناسبة من سبتمبر إلى مايو لتخطيط توقيت عائلي.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف الأزقة والأسقف الخشبية، ويساعد في تقدير تضاريس الزيارة مع الأطفال.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع وساعات القائمة قبل الانطلاق مع العائلة.' },
];

const related = [
  { href: '/itineraries/family/', label: 'مسار عائلي حول السوق', desc: 'مسار مشي قصير مع فواصل راحة.' },
  { href: '/visit/hot-weather/', label: 'الزيارة في الصيف', desc: 'التعامل مع الحرارة والرطوبة مع الأطفال.' },
  { href: '/visit/accessible-route/', label: 'زيارة ميسّرة', desc: 'اعتبارات الحركة وتقييم العربة ميدانياً.' },
  { href: '/around/riyam-park/', label: 'حديقة ريام', desc: 'مساحة خضراء قريبة على الساحل.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'ممشى واسع مناسب للاستراحة واللعب.' },
];
---
<GuideLayout
  title="زيارة سوق مطرح مع الأطفال: نصائح عملية | دليل سوق مطرح"
  h1="زيارة سوق مطرح مع الأطفال"
  description="نصائح عملية لزيارة سوق مطرح مع الأطفال: أفضل توقيت، والماء والظل، وتقييم عربة الأطفال ميدانياً، والمرافق التي تحتاج تأكيداً، والسلامة في الازدحام."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">خطة عائلية واقعية</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">ما يجعل الزيارة مع الأطفال أسهل</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="سوق مطرح بيئة حسّية محبوبة للأطفال: روائح اللبان والتوابل، وألوان الأقمشة، وأصوات الأزقة. لكن الممرات ضيقة والأرض غير مستوية، ويتغيّر الازدحام عبر اليوم، لذا ينجح التخطيط المسبق أكثر من الاعتماد على العفوية." /></p>
            <p><BidiText text="القاعدة العامة: اجعل الزيارة قصيرة ومتقطعة، واختر وقتاً أبرد وأهدأ، وحدّد نقطة خروج قريبة. لا تحتاج لتغطية كل الأزقة؛ المشي الهادئ في جزء منها يكفي لتجربة ممتعة." /></p>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-black text-[#18110d]">ما ينبغي تأكيده ميدانياً</h3>
          <div class="mt-4 space-y-3">
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">ملاءمة عربة الأطفال:</b> لا نضمن سهولتها في كل الممرات؛ جرّب المدخل واحكم بنفسك على الأرض والدرجات.
            </div>
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">المرافق ودورات المياه:</b> لا نضمن وجود مرافق مفتوحة أو مهيأة؛ اسأل عند المدخل مسبقاً.
            </div>
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">مناطق الاستراحة:</b> تتفاوت المقاعد والجلسات القريبة بحسب الموقع؛ حدّد نقطة راحة على الكورنيش كخيار احتياطي.
            </div>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة الخروج السريع</p>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>ماء ووجبة خفيفة للطفل.</li>
            <li>قبعة وواقٍ من الشمس عند المشي النهاري.</li>
            <li>هاتف مشحون ونقطة لقاء متفق عليها.</li>
            <li>خطة خروج مبكر عند الإرهاق.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> في الازدحام، أبقِ الطفل قريباً وامشِ في طابور واحد؛ الأزقة الضيقة ليست مكاناً للانفصال المؤقت.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">مرونة العائلة</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">متى تختصر الزيارة ومتى تمدّها؟</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">اختصِر</h3>
          <p class="mt-3 text-sm text-[#66574e]">إذا بدأ الطفل يتعب أو ارتفعت الحرارة، اكتفِ بمقطع واحد من السوق ثم انتقل إلى راحة على الكورنيش.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">مدّد</h3>
          <p class="mt-3 text-sm text-[#66574e]">إذا كان الطفل مستمتعاً وهادئاً، أضف جولة قصيرة على الواجهة البحرية أو مساحة خضراء قريبة.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">كُرِّر</h3>
          <p class="mt-3 text-sm text-[#66574e]">زيارتان قصيرتان في اليوم نفسه أسهل للعائلة من جلسة طويلة متصلة داخل الأزقة.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا محتوى هذه الصفحة في 2 نوفمبر 2026، ولم نتحقق ميدانياً من ملاءمة عربة الأطفال أو حالة المرافق في يوم معيّن. التفاصيل المتغيرة تُراجع قبل كل زيارة." /></p>
        <p>هذه نصائح عامة من دليل مستقل وغير رسمي، وليست ضمانات. اتخذ قرارك الميداني عند المدخل بحسب حالة الأرض والازدحام واحتياج عائلتك.</p>
      </div>
    </div>
  </section>
</GuideLayout>
