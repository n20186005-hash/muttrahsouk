---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'زيارة ميسّرة' },
];

const quickFacts = [
  { label: 'التضاريس', value: 'غير مستوية مع درجات وأزقة ضيقة' },
  { label: 'حالة الإتاحة', value: 'غير مؤكدة؛ تتطلب تأكيداً رسمياً وميدانياً' },
  { label: 'مسار أقل جهداً', value: 'الكورنيش والمداخل القريبة منه' },
  { label: 'الأفضل زمنياً', value: 'الصباح الباكر وتجنّب الذروة' },
];

const faq = [
  { q: 'هل يصلح سوق مطرح للكراسي المتحركة؟', a: 'لا يمكننا تأكيد ذلك. الأزقة ضيقة والأرض غير مستوية وتوجد درجات في أجزاء من السوق، ولم نتحقق ميدانياً من وجود منحدرات مستمرة. المسار الأسلس عادةً هو محور الكورنيش المستوي، بينما يتطلب الدخول إلى عمق الأزقة تأكيداً مسبقاً من الجهات المختصة.' },
  { q: 'هل توجد منحدرات ومصاعد في السوق؟', a: 'لم نتحقق من ذلك ولم نجد إفادة رسمية مؤكدة ننقلها. النصيحة أن تسأل الجهة المختصة أو منشأة قريبة منك قبل الزيارة، وتتخذ قرارك ميدانياً بحسب ما تراه عند المداخل، دون افتراض توفّر منحدرات أو مصاعد.' },
  { q: 'هل توجد دورات مياه مهيأة لذوي الإعاقة؟', a: 'لا نضمن توفّرها ولا ساعات تشغيلها. تذكر بعض المصادر أعمال تطوير لمرافق قرب السوق، لكن ذلك إفادة عن تطوير وليس ضماناً لحالة الإتاحة اليوم؛ اسأل عند المدخل عن أقرب مرفق يناسب احتياجك.' },
  { q: 'ما أفضل توقيت لتقليل الجهد؟', a: 'الصباح الباكر أو فترة بعد العصر أخفّ حرارةً وأقل ازدحاماً، ويُفضّل تجنّب الظهيرة صيفاً. الزيارة القصيرة على محور واحد أسهل من التجول المتشعّب داخل الأزقة.' },
  { q: 'هل يمكن للسيارة الاقتراب من مدخل السوق؟', a: 'عادةً توجد نقاط نزول قريبة من محيط الكورنيش والمداخل، لكن مواضعها وتنظيم المرور يتغيران. رتّب النزول قرب المدخل ثم اترك المركبة في المواقف المسموح بها، وتحقّق من اللوحات المحلية في يوم الزيارة.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف الأزقة الضيقة والأسقف الخشبية والسلع؛ يفيد في تقدير طبيعة التضاريس والمسار.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان وفترة الزيارة المناسبة من سبتمبر إلى مايو.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع لدراسة مداخل الكورنيش والاقتراب من المدخل.' },
];

const related = [
  { href: '/visit/entrances/', label: 'المداخل والبوابات', desc: 'أي مدخل أسهل بحسب نقطة وصولك.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'المواقف العامة ومناطق النزول والتحميل.' },
  { href: '/visit/hot-weather/', label: 'الزيارة في الصيف', desc: 'تقليل الجهد في الحرارة والرطوبة.' },
  { href: '/visit/family-practical/', label: 'الزيارة مع الأطفال', desc: 'توقيت مريح وخطة فواصل راحة.' },
  { href: '/itineraries/2-hour-walk/', label: 'جولة مشي ساعتين', desc: 'مسار قصير يمكن تكييفه حسب القدرة.' },
];
---
<GuideLayout
  title="زيارة سوق مطرح لذوي الإعاقة والحركة المحدودة | دليل سوق مطرح"
  h1="زيارة سوق مطرح لذوي الإعاقة وذوي الحركة المحدودة"
  description="ما ينبغي معرفته قبل زيارة سوق مطرح بحدود حركة: تضاريس غير مستوية وأزقة ضيقة ودرجات، ومسار أقل جهداً عبر الكورنيش، وما يجب تأكيده رسمياً."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">التخطيط الواقعي</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">تضاريس السوق قبل قرار الزيارة</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="سوق مطرح سوق تقليدي قديم، وليس مبنى حديثاً مهيّأ بمسارات منظمة. الممرات ضيقة ومتشابكة، والأرض غير مستوية، وتوجد درجات في أجزاء من الأزقة. هذه الطبيعة تجعل الزيارة الممتدّة داخل عمق السوق أصعب على ذوي الحركة المحدودة من الزيارة على محيط السوق المسطّح." /></p>
            <p><BidiText text="هدف هذه الصفحة أن يصل القارئ إلى قرار واقعي لا إلى وعد غير مؤكد. لذلك لا نكتب هنا أن السوق «مهيّأ»، بل نوضّح ما نعرفه وما يحتاج تأكيداً، ونقترح بديلاً أقل جهداً هو محور الكورنيش وما يقابله من مداخل." /></p>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-black text-[#18110d]">ما نحتاج تأكيده قبل الزيارة</h3>
          <div class="mt-4 space-y-3">
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">المنحدرات والمصاعد:</b> لم نتحقق من توفّرها بشكل مستمر؛ اسأل الجهة المختصة أو المرفق القريب قبل التخطيط.
            </div>
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">الدورات والمرافق:</b> لا نضمن حالتها أو ساعات تشغيلها؛ تذكر بعض المصادر تطوير مرافق، وهو إفادة تطوير لا ضمان إتاحة.
            </div>
            <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
              <b class="text-[#18110d]">نقاط النزول:</b> مواضعها وتنظيم المرور حول الكورنيش يتغيران؛ تحقّق ميدانياً في يوم الزيارة.
            </div>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">مسار منخفض الجهد</p>
          <ol class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>انزل في نقطة قريبة من الكورنيش المستوي.</li>
            <li>امشِ على الممشى البحري للتمتع بالأجواء والإطلالة.</li>
            <li>اقترب من مدخل السوق لمشاهدة المحال دون التغلغل الطويل.</li>
            <li>استرح عند أي مقعد أو منطقة جلوس، وكرّر الفترات القصيرة.</li>
          </ol>
        </div>
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">رفيق الزيارة</p>
          <p class="mt-3 text-sm text-[#66574e]">وجود مرافق يقلّل الجهد ويسهّل التعامل مع الدرجات والازدحام المحدود، ويساعد في متابعة أي احتياج طارئ.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">تقليل الجهد</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">عادات بسيطة تجعل الزيارة أسهل</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        <div class="card rounded-3xl p-5"><b class="text-[#176b68]">تجنّب الذروة</b><p class="mt-2 text-sm text-[#66574e]">الصباح الباكر أقل ازدحاماً وأسهل حركةً داخل الممرات.</p></div>
        <div class="card rounded-3xl p-5"><b class="text-[#176b68]">تجنّب الحرارة</b><p class="mt-2 text-sm text-[#66574e]">الحرارة والرطوبة ترهق أكثر؛ اختر وقتاً أبرد واسترح في الظل.</p></div>
        <div class="card rounded-3xl p-5"><b class="text-[#176b68]">مسارات قصيرة</b><p class="mt-2 text-sm text-[#66574e]">قسّم الزيارة إلى مقاطع قصيرة بدل جولة طويلة متصلة.</p></div>
        <div class="card rounded-3xl p-5"><b class="text-[#176b68]">اتصال واحتياط</b><p class="mt-2 text-sm text-[#66574e]">احتفظ بهاتف مشحون وخطة عودة واضحة ونقطة لقاء محددة.</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا محتوى هذه الصفحة في 2 نوفمبر 2026، ولم نتحقق ميدانياً من حالة الإتاحة أو المنحدرات أو المرافق في سوق مطرح. المعلومات المتغيرة تُراجع قبل كل زيارة." /></p>
        <p>لا تقدّم هذه الصفحة أي ضمان إتاحة. تأكّد من الجهات المختصة أو المرفق القريب منك قبل التخطيط، واتخذ قرار الدخول إلى عمق الأزقة بناءً على ما تراه عند المداخل.</p>
      </div>
    </div>
  </section>
</GuideLayout>
