---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'المواقف' },
];

const quickFacts = [
  { label: 'أين تركن عادةً', value: 'مواقف عامة على الكورنيش والشوارع المحيطة' },
  { label: 'ضمان وجود مكان', value: 'غير مضمون' },
  { label: 'الرسوم', value: 'تحددها اللوحات والأنظمة المحلية' },
  { label: 'أفضل حل في الذروة', value: 'اركن أبعد ثم امشِ' },
];

const sections = [
  {
    heading: 'أين توجد المواقف عادةً حول السوق',
    body: [
      'تتوزّع المواقف المتاحة حول سوق مطرح في منطقة كورنيش مطرح وعلى الشوارع المحيطة بالحي. الاعتماد الأكبر يكون على المواقف على طول الواجهة البحرية، ثم على الفراغات الجانبية في الشوارع القريبة من المداخل.',
      'تذكر بلدية مسقط ضمن أعمال تطوير السوق توسيع عدد مواقف المركبات، وهذا مؤشر على أن المواقف جزء من التخطيط البلدي للمنطقة. مع ذلك، تبقى أعداد الأماكن محدودة أمام حجم الإقبال في المواسم، خصوصاً في المساء وعطلات نهاية الأسبوع.',
    ],
  },
  {
    heading: 'لا ضمان لوجود مكان ولا لسعر محدّد',
    body: [
      'لا يمكن لأي دليل أن يضمن لك موقفاً متاحاً في وقت وصولك، ولا أن يحدّد لك رسماً ثابتاً. الرسوم — إن وُجدت — تظهر على اللوحات أو تُعلن محلياً، وقد تختلف بحسب المنطقة والمناسبة والوقت.',
      'لذلك اتبع دائماً اللوحات والأنظمة المحلية عند مكان الوقوف، ولا تعتمد على معلومات قديمة عن أسعار أو أماكن. إن ظهر لك عامل مواقف أو لوحة رسمية فالتزم بما عليها.',
    ],
  },
  {
    heading: 'مناطق النزول والتحميل وأماكن لا تتوقف فيها',
    body: [
      'خصّص وقتاً قصيراً للنزول والتحميل فقط عندما يكون المقصود إنزال الركاب أو البضائع، ثم تابع إلى موقف مناسب. لا تتوقف أمام مداخل السوق أو على الممرات المخصصة للمشاة حتى لو بدا الأمر سريعاً.',
      'التوقف أمام المداخل يعرقل حركة المشاة والباعة ويُعرّض سيارتك للمخالفة. إن كنت مع مجموعة كبيرة أو أطفال، اختر مكان نزول واضحاً ثم اجتمعوا عند المدخل المتفق عليه قبل الدخول.',
    ],
  },
  {
    heading: 'أيام الأسبوع مقابل العطلات والمواسم',
    body: [
      'تختلف سهولة الحصول على موقف بشكل واضح بين أيام الأسبوع والعطلات. في أيام العمل قد تجد أماكن أقرب، بينما في المساء وعطلات نهاية الأسبوع وفي المواسم السياحية وفي ليالي رمضان تشتد المنافسة على كل فراغ قريب.',
      'إن كانت زيارتك في وقت ذروة متوقع، فخطّط للوصول مبكراً أو اختر موقفاً أبعد قليلاً منذ البداية بدلاً من الدوران المتكرر حول المداخل.',
    ],
  },
  {
    heading: 'البديل الذكي: اركن أبعد وامشِ',
    body: [
      'غالباً يكون الحل الأسرع هو ركن السيارة في محيط أبعد قليلاً ثم إكمال الطريق مشياً. المسافة من الكورنيش إلى مداخل السوق مشي قصير، وقد يكون المشي أسهل بكثير من الانتظار في ازدحام أمام المدخل.',
      'هذا الخيار مفيد أيضاً إن أردت القيام بجولة على الواجهة البحرية أو زيارة القلعة وسوق السمك ضمن الزيارة نفسها، لأنك تكون قد بدأت مسارك من مسافة مناسبة.',
    ],
  },
];

const faq = [
  { q: 'هل توجد مواقف مخصصة لسوق مطرح؟', a: 'تنتشر مواقف عامة في منطقة الكورنيش وعلى الشوارع المحيطة. لا نضمن توفّر مكان في وقت وصولك، والرسوم تحددها اللوحات والأنظمة المحلية.' },
  { q: 'هل الرسوم معلومة وثابتة؟', a: 'لا يمكن تقديم رسم ثابت؛ فقد تختلف بحسب المنطقة والوقت والمناسبة. اتبع اللوحات الرسمية عند مكان الوقوف.' },
  { q: 'أين يمكن أن أنزل الركاب؟', a: 'استخدم مناطق النزول والتحميل المخصصة إن وُجدت، ولا تتوقف أمام مداخل السوق أو على ممرات المشاة، ثم انتقل إلى موقف مناسب.' },
  { q: 'ما أفضل وقت للعثور على موقف؟', a: 'الصباح في أيام الأسبوع يكون عادةً أسهل من المساء ومن عطلات نهاية الأسبوع والمواسم؛ وإن كانت زيارتك في الذروة فالحل الأمثل هو الركن أبعد ثم المشي.' },
  { q: 'هل المشي من الموقف بعيد؟', a: 'المسافة من الكورنيش إلى مداخل السوق مشي قصير عادةً، وغالباً يكون أسرع من الدوران بحثاً عن موقف قريب.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'يذكر تطوير السوق بما فيه توسيع مواقف المركبات وتحسين المداخل.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة الموقع لاستكشاف الشوارع والمداخل المحيطة قبل الانطلاق.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق عام لمحافظة مسقط وموقع مطرح على الواجهة البحرية.' },
];

const related = [
  { href: '/visit/entrances/', label: 'بوابات ومداخل سوق مطرح', desc: 'من أي مدخل تدخل بحسب مكان وقوفك.' },
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'نقطة الوصول الصحيحة والإحداثيات التقريبية.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'أوقات الهدوء والذروة لتجنّب الازدحام.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى البحري الذي يسهل البدء منه مشياً.' },
];
---
<GuideLayout
  title="مواقف سوق مطرح: أين توقف سيارتك وتتفادى الازدحام | دليل سوق مطرح"
  h1="مواقف سوق مطرح والوصول بالسيارة"
  description="دليل عملي للمواقف حول سوق مطرح: مواقف الكورنيش والشوارع المحيطة، لوحات التنظيم والرسوم، مناطق النزول والتحميل، ولماذا يُفضَّل الركن أبعد ثم المشي."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">بالسيارة</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">كيف تركن سيارتك قرب السوق؟</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="الوصول بالسيارة إلى سوق مطرح ممكن، لكن التحدي الحقيقي هو إيجاد موقف قريب في وقت مزدحم. الحل العملي أن تتعامل مع المواقف كخطوة تخطيط وليس كأمر تلقائي، وأن تكون مستعداً للمشي القصير." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">مواقف الكورنيش</b>
          <p class="mt-3 text-sm text-[#66574e]">الخيار الأقرب للواجهة البحرية؛ تتيح لك البدء مشياً نحو السوق مع الاستمتاع بالممشى.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الشوارع المحيطة</b>
          <p class="mt-3 text-sm text-[#66574e]">فراغات جانبية في الشوارع القريبة؛ راقب اللوحات لأن بعضها مخصص أو محظور.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">اركن أبعد وامشِ</b>
          <p class="mt-3 text-sm text-[#66574e]">غالباً الحل الأسرع في الذروة؛ مسافة المشي إلى المداخل قصيرة عادةً.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة سريعة قبل الركن</p>
          <ol class="mt-3 list-decimal space-y-2 pr-5 text-sm text-[#66574e]">
            <li>اقرأ اللوحة المحلية عند المكان قبل التوقف.</li>
            <li>تأكد أنك لا تسدّ مدخلاً أو ممراً للمشاة.</li>
            <li>احفظ موقع سيارتك أو التقط إشارة قريبة.</li>
            <li>إن كان الموقف بعيداً فلا بأس؛ المشي جزء من التجربة.</li>
          </ol>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> أعداد المواقف والرسوم وقواعد الوقوف تتغيّر محلياً حسب الموسم والمناسبة. لا تعتمد على أي سعر أو تفصيل في هذه الصفحة كحقيقة نهائية؛ راقب اللوحات عند الوصول واسأل عند الحاجة.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
