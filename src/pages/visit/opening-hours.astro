---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'أوقات العمل' },
];

const quickFacts = [
  { label: 'الجمعة وفق قائمة الخرائط', value: '16:00–22:00' },
  { label: 'السبت إلى الخميس وفق قائمة الخرائط', value: '09:00–23:00' },
  { label: 'تاريخ لقطة القائمة', value: '23 أكتوبر 2026' },
  { label: 'تعريفة دخول منشورة', value: 'لا توجد' },
];

const sections = [
  {
    heading: 'ماذا تقول ساعات السوق المعلنة؟',
    body: [
      'تفرّق بطاقة سوق مطرح على خرائط جوجل بين يوم الجمعة وبقية أيام الأسبوع. وفق اللقطة التي راجعناها بتاريخ 23 أكتوبر 2026، تُسرد ساعات الجمعة من الساعة 16:00 إلى 22:00، وساعات السبت إلى الخميس من الساعة 09:00 إلى 23:00.',
      'هذه الأرقام تخص بطاقة المكان على الخريطة، وليست جدولاً رسمياً صادراً عن إدارة السوق. لذلك تعامل معها كنقطة انطلاق مفيدة، وليس كضمان أن كل باب سيكون مفتوحاً في اللحظة نفسها.',
    ],
  },
  {
    heading: 'هذه ساعات «القائمة» لا ساعات كل متجر',
    body: [
      'السوق ليس منشأة واحدة بباب واحد وموظفين يفتحون ويغلقون في وقت واحد. إنه مجموعة من المحال المتجاورة، لكل منها صاحبه وساعاته. بعض المحال يفتح أبكر، وبعضها ينتظر بعد الظهر، وبعضها يغلق للراحة ثم يعود مساءً.',
      'لذلك قد تدخل السوق في وقت يبدو «مفتوحاً» فتجد ممراً نشطاً وممراً آخر أغلب محاله مغلق. هذا أمر طبيعي ولا يعني أن الزيارة فاشلة؛ المساء عادةً يجمع أكبر عدد من الأبواب المفتوحة.',
    ],
  },
  {
    heading: 'أثر صلاة الجمعة والعطلات والمناسبات',
    body: [
      'يوم الجمعة له إيقاع مختلف في مطرح. تقلّ الحركة في ساعات الصباح إلى ما قبل صلاة الجمعة، ثم ينهض السوق تدريجياً بعد الصلاة ويمتد نشاطه إلى المساء. لهذا تبدو بداية ساعات الجمعة متأخرة في القائمة المعلنة.',
      'في العطلات الرسمية والمناسبات الوطنية والأعياد قد تتغير الساعات دون إشعار مسبق على الخريطة. في هذه الأيام يكون الخيار الأفضل هو الاتصال أو المرور ميدانياً في وقت مبكر لمعرفة الحالة الفعلية.',
    ],
  },
  {
    heading: 'صباح أم مساء؟ الفرق في التجربة',
    body: [
      'الصباح أهدأ وأبرّد، والممرات أقل ازدحاماً، وهو الأنسب إن أردت التصوير ببطء أو التحدث مع الباعة على راحتك. أما المساء ففيه حركة أكبر وإضاءة داخلية وأجواء اجتماعية، وغالباً يكون هو الوقت الذي يقصده معظم الزوار.',
      'إن كان هدفك التسوق الهادئ فاجعل زيارتك صباحية، وإن أردت الإحساس بأجواء السوق الحقيقية والمزاج الاحتفالي فاختر المساء. يمكن أيضاً الجمع بين الاثنين: جولة قصيرة صباحاً ثم عودة للتسوق ليلاً.',
    ],
  },
  {
    heading: 'هل يوجد رسم دخول للسوق؟',
    body: [
      'لم نجد في المصادر الرسمية التي اطلعنا عليها أي تعريفة منشورة لدخول سوق مطرح، ولا يبدو أن الدخول يخضع لرسوم معلنة. أما الأسعار التي تظهر مقابل بعض الجولات الإرشادية في منصات الحجز فهي مقابل خدمة الجولة، وليست رسوم دخول إلى السوق.',
      'إن عرض عليك أحدهم خدمة مدفوعة داخل السوق، فمن حقك أن تسأل عن طبيعة الخدمة وسعرها قبل القبول، ولا تدفع لشراء ما لم تطلبه فعلاً.',
    ],
  },
];

const faq = [
  { q: 'ما ساعات عمل سوق مطرح؟', a: 'تسرد قائمة خرائط جوجل، وفق لقطة 23 أكتوبر 2026، ساعات الجمعة 16:00–22:00، وساعات السبت إلى الخميس 09:00–23:00. هذه ساعات بطاقة المكان وتتغير في العطلات والمناسبات، لذا تحقّق قبل الانطلاق.' },
  { q: 'هل تفتح كل المحال في هذه الساعات؟', a: 'لا. السوق مجموعة محال مستقلة، وقد تجد بعضها مغلقاً أثناء الساعات المعلنة. المساء عادةً يجمع أكبر عدد من الأبواب المفتوحة.' },
  { q: 'لماذا تختلف ساعات يوم الجمعة؟', a: 'بسبب صلاة الجمعة؛ تقل الحركة صباحاً ثم ينهض السوق بعد الصلاة ويمتد نشاطه إلى المساء، لذلك تبدو ساعات الجمعة متأخرة في القائمة.' },
  { q: 'هل الدخول إلى السوق برسوم؟', a: 'لم نجد أي تعريفة رسمية منشورة لدخول السوق. احترس من أي «رسوم» غير معلنة، واسأل عن أي خدمة مدفوعة قبل قبولها.' },
  { q: 'هل يتغير الجدول في رمضان؟', a: 'نعم، تتغير الساعات في رمضان وفي الأعياد غالباً، وتتركز الحركة بعد الإفطار. راجع دليل السوق في رمضان، وتحقّق ميدانياً في يوم الزيارة.' },
];

const sources = [
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'بطاقة المكان المرجعية لساعات الزيارة المعلنة؛ تحقّق من تحديثها قبل الانطلاق.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان وفترة الزيارة المناسبة.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف البلدي للسوق وأقسامه وأعمال التطوير التي شملت الإضاءة والمظلات.' },
];

const related = [
  { href: '/visit/best-time/', label: 'أفضل وقت لزيارة سوق مطرح', desc: 'المقارنة بين الفصول وبين الصباح والمساء.' },
  { href: '/visit/ramadan/', label: 'سوق مطرح في رمضان', desc: 'كيف تتغيّر الساعات والحركة خلال الشهر الفضيل.' },
  { href: '/souq/al-dhalam/', label: 'لماذا يسمى سوق الظلام؟', desc: 'أثر الأزقة المسقوفة على الإضاءة داخل السوق.' },
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'أين يقع السوق بالضبط وكيف تصل إلى المدخل الصحيح.' },
];
---
<GuideLayout
  title="أوقات عمل سوق مطرح: ساعات الزيارة والسوق يوم الجمعة | دليل سوق مطرح"
  h1="أوقات عمل سوق مطرح وساعات الزيارة"
  description="ساعات سوق مطرح وفق قائمة خرائط جوجل: الجمعة 16:00–22:00 والسبت–الخميس 09:00–23:00، ولماذا تختلف ساعات كل متجر، وأثر الجمعة والعطلات، وكيف تتحقق قبل الزيارة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">قبل الانطلاق</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">ساعات السوق كما تُعرض على الخريطة</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="أبسط طريقة لتصوّر أوقات السوق هي النظر إلى بطاقته على خرائط جوجل؛ فهي تجمع الساعات في جدول واحد واضح، ويمكنك الاعتماد عليها كنقطة انطلاق قبل التخطيط لزيارتك." /></p>
      </div>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#2b1b13] text-white">
              <th class="p-4">اليوم</th>
              <th class="p-4">الساعات في قائمة خرائط جوجل</th>
              <th class="p-4">ملاحظة</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#B98739]/20 bg-white">
            <tr>
              <td class="p-4 font-bold text-[#18110d]">السبت إلى الخميس</td>
              <td class="p-4"><bdi dir="ltr">09:00–23:00</bdi></td>
              <td class="p-4 text-[#66574e]">تمتد الزيارة من الصباح إلى وقت متأخر من المساء.</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-[#18110d]">الجمعة</td>
              <td class="p-4"><bdi dir="ltr">16:00–22:00</bdi></td>
              <td class="p-4 text-[#66574e]">تبدأ متأخرة بسبب صلاة الجمعة وتنتهي أبكر قليلاً.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">تنبيه:</b> الجدول أعلاه مأخوذ من بطاقة المكان على الخريطة (لقطة <BidiText text="23 أكتوبر 2026" />) وهو وصفي لا رسمي؛ لا يضمن أن كل متجر سيكون مفتوحاً في اللحظة نفسها.
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">لماذا تتغيّر الساعات؟</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">استقلال المحال:</b> كل متجر يفتح ويغلق بحسب صاحبه.</li>
            <li><b class="text-[#18110d]">صلاة الجمعة:</b> تُؤخّر بداية النشاط يوم الجمعة.</li>
            <li><b class="text-[#18110d]">العطلات والمناسبات:</b> قد تُغيّر الجدول دون تحديث فوري.</li>
            <li><b class="text-[#18110d]">الطقس:</b> في الحرارة الشديدة يتركز النشاط مساءً.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق يوم الزيارة (<BidiText text="2 نوفمبر 2026" />):</b> راجع بطاقة المكان على الخريطة صباح يوم الزيارة، وإن كان يوم جمعة أو عطلة رسمية فاتصل بمكان إقامتك أو بأحد المحال للتأكد. كل الساعات الواردة هنا قابلة للتغيير.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
