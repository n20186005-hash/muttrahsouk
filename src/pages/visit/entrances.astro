---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const mapUrl = 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'المداخل والبوابات' },
];

const quickFacts = [
  { label: 'المدخل الرئيسي', value: 'من جهة كورنيش مطرح' },
  { label: 'مداخل أخرى', value: 'من جهة سوق السمك والمسجد' },
  { label: 'الطابع الداخلي', value: 'أزقة ضيقة تحت أسقف خشبية' },
  { label: 'نقطة لقاء للمجموعات', value: 'عند المدخل من الكورنيش' },
];

const sections = [
  {
    heading: 'المدخل الرئيسي من جهة الكورنيش',
    body: [
      'أشهر مدخل لسوق مطرح هو المدخل من جهة البحر، المواجه لكورنيش مطرح. تذكر بلدية مسقط أن بوابة «خور بمبة» تُعدّ المدخل الرئيسي المعروف للسوق من جهة البحر، وأن هذا الجزء يمتد من مسجد الرسول الأعظم إلى خور بمبة.',
      'الوصول من هذه الجهة مريح لمن يأتي مشياً من الممشى البحري، وتستقبلك عند المدخل ملامح السوق المعروفة: قوس أو بوابة ثم ممر يدخل بك إلى الأزقة المسقوفة.',
    ],
  },
  {
    heading: 'مداخل من جهة سوق السمك والمسجد',
    body: [
      'إلى جانب المدخل البحري، يمكن الدخول إلى السوق من الجهة المقابلة القريبة من منطقة سوق السمك ومن محيط المسجد، بحسب الشارع الذي تصل منه. هذه المداخل تفيد إذا كنت قادماً من داخل الحي أو من جهة المواقف البعيدة عن الكورنيش.',
      'لا تتوقع أن كل مدخل يبدو متشابهاً؛ بعضها أوسع وأوضح، وبعضها ممر ضيق قد لا تلاحظه من النظرة الأولى. عند التردد، توجّه إلى المدخل الأقرب لكورنيش مطرح لأنه الأكثر وضوحاً.',
    ],
  },
  {
    heading: 'كيف تتوجّه داخل الأزقة والأسقف الخشبية',
    body: [
      'داخل السوق تصف بلدية مسقط ممرات ضيقة ومتعرجة تحت أسقف خشبية منقوشة، وهذا يعني أن الرؤية البعيدة محدودة والمسارات متشابكة. لذلك لا تحاول حفظ خريطة دقيقة في ذهنك، بل اعتمد على معالم بسيطة: مسجد، أو تقاطع ممرات، أو مدخل واسع.',
      'أسلم طريقة هي التجوّل دون قلق من «الضياع»، لأن السوق مساحة متصلة يمكن الخروج منها من أكثر من جهة. إن احتجت التوجّه، اسأل أحد أصحاب المحال بلطف عن أقرب مخرج إلى الكورنيش أو إلى سوق السمك.',
    ],
  },
  {
    heading: 'نقاط لقاء مناسبة للمجموعات',
    body: [
      'إذا كنت ضمن مجموعة أو عائلة كبيرة، فالأفضل تحديد نقطة لقاء واضحة قبل الدخول، لأن الأزقة المتعرجة تجعل التجمع في الداخل صعباً. من أنسب النقاط: المدخل من جهة الكورنيش، أو مكان ظاهر على الواجهة قريب من المدخل.',
      'اتفقوا أيضاً على وقت محدد للعودة، وليحمل كل شخص وسيلة تواصل تعمل محلياً. هذا يوفّر وقتاً كبيراً ويمنع البحث الطويل داخل الممرات المزدحمة.',
    ],
  },
  {
    heading: 'الوصول الشامل: لا ضمانات قبل التحقق الميداني',
    body: [
      'لا نستطيع الجزم بأن جميع المداخل مهيأة للكراسي المتحركة أو لعربات الأطفال، لأن بعض المداخل ممرات ضيقة قد تتضمن عتبات أو أرضيات غير مستوية. هذه تفاصيل يجب تأكيدها ميدانياً أو عبر الجهة المختصة قبل التخطيط لزيارة تعتمد على الحركة الميسّرة.',
      'إن كان الوصول الميسّر ضرورياً لك، فراجع صفحة الزيارة الميسّرة، وتواصل مع الجهات الرسمية لمعرفة المدخل الأنسب، مع تفضيل أوقات الهدوء وتجنّب الذروة والازدحام.',
    ],
  },
];

const faq = [
  { q: 'ما المدخل الرئيسي لسوق مطرح؟', a: 'المدخل الرئيسي المعروف من جهة البحر، ويقابل كورنيش مطرح؛ وتذكر بلدية مسقط بوابة خور بمبة بوصفها المدخل الرئيسي من جهة البحر.' },
  { q: 'هل توجد أكثر من بوابة للسوق؟', a: 'نعم، إلى جانب المدخل البحري يمكن الدخول من الجهة القريبة من سوق السمك والمسجد بحسب الشارع الذي تصل منه.' },
  { q: 'كيف أتفادى الضياع داخل الأزقة؟', a: 'اعتمد على معالم بسيطة وتذكّر أن السوق مساحة متصلة بأكثر من مخرج. عند الحاجة اسأل أحد الباعة عن أقرب مخرج إلى الكورنيش.' },
  { q: 'أين مناسب للقاء المجموعات؟', a: 'الأفضل عند المدخل من جهة الكورنيش أو نقطة ظاهرة على الواجهة قبل الدخول، مع تحديد وقت عودة متفق عليه.' },
  { q: 'هل المداخل مناسبة للكراسي المتحركة؟', a: 'لا يمكن الجزم بذلك؛ بعض المداخل ممرات ضيقة قد تتضمن عتبات. يجب التحقق ميدانياً أو عبر الجهات الرسمية قبل الاعتماد عليها.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'يصف الممرات الضيقة المتعرجة ومدخل خور بمبة من جهة البحر والأقسام الداخلية.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: mapUrl, desc: 'لقطة المكان لتحديد الاتجاه من الكورنيش نحو المدخل الرئيسي.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'وصف رسمي للسوق وموقعه على الواجهة البحرية بمطرح.' },
];

const related = [
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'أين تركن سيارتك وأي مدخل يخدم موقعك.' },
  { href: '/visit/accessible-route/', label: 'زيارة سوق مطرح لذوي الإعاقة', desc: 'مسار منخفض الجهد وتنبيهات الوصول الميسّر.' },
  { href: '/souq/architecture/', label: 'عمارة سوق مطرح التقليدية', desc: 'الأزقة المسقوفة والأسقف الخشبية المنقوشة.' },
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'نقطة الوصول الصحيحة والإحداثيات التقريبية.' },
];
---
<GuideLayout
  title="بوابات ومداخل سوق مطرح: من أين تدخل وكيف تتوجه | دليل سوق مطرح"
  h1="بوابات ومداخل سوق مطرح"
  description="مداخل سوق مطرح من جهة الكورنيش ومن جهة سوق السمك والمسجد، والتوجّه داخل الأزقة المسقوفة، ونقاط اللقاء للمجموعات، مع تنبيهات الوصول الميسّر."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">من أين تدخل؟</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">مداخل السوق الأربعة الأكثر استخداماً</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="للسوق أكثر من جهة دخول، والاختيار بينها يعتمد على الطريق الذي وصلت منه: إن جئت من الواجهة البحرية فالخيار الطبيعي هو المدخل من الكورنيش، وإن جئت من داخل الحي أو من جهة سوق السمك فهناك مداخل أقرب." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">المدخل من الكورنيش</b>
          <p class="mt-3 text-sm text-[#66574e]">الأوضح والأشهر، ويقابل الممشى البحري؛ مناسب لمن يأتي مشياً من الواجهة.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">من جهة سوق السمك</b>
          <p class="mt-3 text-sm text-[#66574e]">مدخل عملي لمن كان في منطقة سوق السمك أو قادماً من الجهة التجارية المجاورة.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">من محيط المسجد</b>
          <p class="mt-3 text-sm text-[#66574e]">مدخل جانبي يفيد القادمين من داخل الحي أو من مواقف بعيدة عن الكورنيش.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">مدخل خور بمبة</b>
          <p class="mt-3 text-sm text-[#66574e]">تذكره بلدية مسقط كبوابة المدخل الرئيسي من جهة البحر للسوق.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قبل الدخول: اتفاق سريع</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">نقطة اللقاء:</b> عند المدخل من الكورنيش.</li>
            <li><b class="text-[#18110d]">وقت العودة:</b> حدّدوه قبل الانطلاق.</li>
            <li><b class="text-[#18110d]">جهة الخروج:</b> الكورنيش أو سوق السمك.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> أوصاف المداخل ومستوى تهيئتها للوصول الميسّر قابلة للتغيير مع أعمال التطوير والصيانة. تحقّق ميدانياً عند الوصول، أو عبر الجهات الرسمية، قبل الاعتماد على مدخل معيّن.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
