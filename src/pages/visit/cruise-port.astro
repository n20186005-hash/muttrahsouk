---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'من ميناء السلطان قابوس' },
];

const quickFacts = [
  { label: 'الموقع', value: 'الميناء السياحي في مطرح قرب الكورنيش' },
  { label: 'المسافة التقديرية للسوق', value: 'نحو كيلومتر إلى كيلومترين حسب موقع الرسو' },
  { label: 'خيارات التنقل', value: 'مشي أو سيارة أجرة أو حافلة الميناء' },
  { label: 'القاعدة الأهم', value: 'أكّد قواعد الدخول والمواعيد مع مشغّل الرحلة' },
];

const faq = [
  { q: 'كيف أصل من السفينة إلى سوق مطرح؟', a: 'يعتمد ذلك على موقع رسو السفينة وقواعد الميناء في يومك. الخيارات الشائعة هي المشي على الكورنيش، أو سيارة أجرة من بوابة الميناء، أو حافلة مكوكية إن وفّرها الميناء أو مشغّل الرحلة. تأكد من التفاصيل على متن السفينة قبل النزول.' },
  { q: 'هل يمكن المشي من الميناء إلى السوق مباشرة؟', a: 'المسافة قصيرة نسبياً ويمكن أن تتراوح بين نحو كيلومتر وكيلومترين حسب الرصيف، لكن حدود الوصول داخل الميناء تختلف بحسب الترتيبات الأمنية والبوابات المفتوحة في يوم الرسو. لا نفترض إمكانية المشي الكامل من الرصيف؛ اسأل عن نقطة الخروج المتاحة.' },
  { q: 'كم وقت أحتاج للعودة إلى السفينة؟', a: 'احسب دائماً هامشاً إضافياً فوق الوقت المتوقع للعودة، لأن الازدحام عند البوابات ونقاط التفتيش قد يؤخرك. اطرح الهامش من وقت الإبحار المعلن بدل الاعتماد على آخر لحظة.' },
  { q: 'هل تُوفَّر حافلات مكوكية من الميناء؟', a: 'قد توفّر بعض الرحلات والسياحة حافلات مكوكية بين الرصيف ونقطة قريبة من مطرح، لكن ذلك يعتمد على الميناء ومشغّل الرحلة وليس مضموناً دائماً. تحقّق على متن السفينة أو من موظفي المحطة.' },
  { q: 'هل يمكن استقلال سيارة أجرة داخل الميناء؟', a: 'غالباً تنتظر سيارات الأجرة خارج نطاق الحركة المباشر أو عند البوابة وفق ترتيب الميناء. تفاوت التسعير وارد، فاتفق على الوجهة والسعر قبل الانطلاق أو استخدم تطبيق توصيل إن كان متاحاً لديك.' },
];

const sources = [
  { label: 'دليل موانئ الرحلات — مسقط', org: 'دليل مسارات بحرية (مصدر خارجي)', url: 'https://cruises.to/muscat-oman/', desc: 'يشير إلى أن السفن ترسو في ميناء السلطان قابوس بمطرح وأن الوصول من الميناء إلى السوق يحتاج تنقلاً قصيراً.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق محافظة مسقط ومطرح كوجهة ساحلية على خليج عُمان.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع لقياس المسافة التقريبية من محيط الميناء.' },
];

const related = [
  { href: '/visit/location/', label: 'الموقع والخريطة', desc: 'أين يقع السوق بالنسبة للكورنيش والميناء.' },
  { href: '/visit/from-airport/', label: 'من مطار مسقط إلى السوق', desc: 'خيارات الوصول لمن يصل جواً.' },
  { href: '/visit/bus/', label: 'الوصول بالحافلة', desc: 'خطوط النقل الوطني وإكمال المشي.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الممشى الذي يربط الميناء بالسوق.' },
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'استثمار توقف قصير بين السوق والكورنيش.' },
];
---
<GuideLayout
  title="من ميناء السلطان قابوس إلى سوق مطرح | دليل سوق مطرح"
  h1="من ميناء السلطان قابوس إلى سوق مطرح"
  description="كيف تصل إلى سوق مطرح من ميناء السلطان قابوس في مطرح: خيارات المشي وسيارة الأجرة والحافلة، والمسافة التقريبية، واستثمار توقف السفينة القصير بأمان."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">وصول زوّار الرحلات البحرية</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">لماذا يقع السوق قريباً من الميناء؟</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="يرسو عدد من سفن الرحلات في ميناء السلطان قابوس بمطرح، وهو على مسافة قصيرة من كورنيش مطرح الذي يحتضن السوق على واجهته البحرية. لهذا القرب، يُعدّ سوق مطرح من أسهل المعالم الوصول إليها لزوّار السفن مقارنة بمعالم أبعد في محافظة مسقط." /></p>
            <p><BidiText text="مع ذلك، ليست كل نقطة رسو على المسافة نفسها، وقد تختلف البوابات المفتوحة وقواعد الحركة داخل الميناء من يوم لآخر. لذلك تعامل مع أي مسافة أو وقت مقترح هنا كتقدير عام فقط، وأكّده على متن السفينة أو من موظفي المحطة." /></p>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-black text-[#18110d]">ثلاث طرق للتنقل</h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">المشي</b>
              <p class="mt-2 text-sm text-[#66574e]">مناسب إذا كانت نقطة الخروج قريبة من الكورنيش والجو معتدل؛ المسار مستوٍ غالباً على طول الواجهة.</p>
            </div>
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">سيارة الأجرة</b>
              <p class="mt-2 text-sm text-[#66574e]">خيار سريع لتقليل الجهد والحرارة؛ اتفق على الوجهة والسعر أو استخدم تطبيق توصيل إن توفّر.</p>
            </div>
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">حافلة الميناء</b>
              <p class="mt-2 text-sm text-[#66574e]">قد توفّر بعض الرحلات حافلة مكوكية إلى نقطة قريبة؛ التوفّر يعتمد على الميناء ومشغّل الرحلة.</p>
            </div>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">خطة التوقف القصير</p>
          <ol class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>انزل مبكراً واحسب وقت العودة أولاً.</li>
            <li>اجعل السوق والكورنيش أولوية قبل أي إضافة.</li>
            <li>اترك هامشاً كافياً لبوابة الميناء.</li>
          </ol>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> قواعد الدخول والخروج من الميناء ومواعيد الإبحار تُتحقق من مشغّل الرحلة وطاقم السفينة، وليست ثابتة لجميع السفن.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">اخطط لعودتك</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">كيف تستثمر وقت التوقف دون قلق العودة؟</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">قبل النزول</h3>
          <p class="mt-3 text-sm text-[#66574e]">اعرف آخر وقت للصعود إلى السفينة، وحدّد نقطة الخروج والعودة، واحفظ رقم بوابة الميناء أو اسمها.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">أثناء الزيارة</h3>
          <p class="mt-3 text-sm text-[#66574e]">أنجز السوق والكورنيش أولاً، فهما الأقرب؛ ثم أضف ما يسمح به الوقت دون استنزافه في انتقال طويل.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">هامش الأمان</h3>
          <p class="mt-3 text-sm text-[#66574e]">احسب وقت العودة مضاعفاً في الذروة، لأن الحافلات وسيارات الأجرة قد تتأخر عند البوابات.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا معلومات هذه الصفحة في 2 نوفمبر 2026. المسافات وأماكن الرسو وإجراءات الميناء ومواعيد السفن قابلة للتغيير، ولم نتحقق منها ميدانياً في يوم رسو محدّد." /></p>
        <p>قواعد الدخول والخروج من الميناء ومواعيد العودة هي مسؤولية مشغّل الرحلة؛ التزم بتعليماته أولاً. لا تعتمد على أي وقت مقدَّر هنا بدل التعليمات الرسمية للسفينة.</p>
      </div>
    </div>
  </section>
</GuideLayout>
