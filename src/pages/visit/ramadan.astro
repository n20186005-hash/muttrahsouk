---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'السوق في رمضان' },
];

const quickFacts = [
  { label: 'تغيّر الساعات', value: 'تنخفض نهاراً وتمتد مساءً؛ تُراجع سنوياً' },
  { label: 'أكثر الأوقات حيوية', value: 'بعد الإفطار' },
  { label: 'اللباس المناسب', value: 'محتشم ومراعٍ لأجواء الشهر' },
  { label: 'الطعام', value: 'خيارات نهارية محدودة وتمتد بعد الإفطار' },
];

const faq = [
  { q: 'هل تتغير ساعات سوق مطرح في رمضان؟', a: 'نعم، يغلب على شهر رمضان تعديل ساعات العمل في القطاعين العام والخاص، ويتأثر السوق بهذا النسق، فتنخفض ساعات النهار وتمتد الحركة مساءً. لكن الساعات المفصّلة تتغيّر من سنة إلى أخرى، لذا يجب التحقق منها في كل رمضان قبل الزيارة.' },
  { q: 'متى يكون السوق أكثر ازدحاماً في رمضان؟', a: 'الذروة عادةً بعد الإفطار حيث تخرج الناس للتسوّق والتنزه، وتمتد الأجواء حتى وقت متأخر نسبياً. من أراد هدوءاً أكبر فقد يفضّل فترة النهار المتأخرة أو زيارة سريعة قبل المغرب.' },
  { q: 'هل تتوفّر المطاعم نهار رمضان؟', a: 'تغلق كثير من المطاعم والمقاهي المحلية نهاراً وتعيد الفتح عند الإفطار، بينما تبقى بعض المطاعم الفندقية عاملة بترتيبات خاصة. التوفّر يتفاوت بحسب المكان والتاريخ، فتحقّق قبل الاعتماد على أي خيار.' },
  { q: 'هل يتأثر سوق السمك برمضان؟', a: 'نشاط سوق السمك مرتبط أساساً بحركة الصيد والطلب، ويتأثر بالنسق اليومي في رمضان. يُفضّل زيارته صباحاً والتأكد من التوقيت الفعلي في يومك، فقد تختلف أوقات الذروة عن الأيام العادية.' },
  { q: 'ما آداب الزيارة لغير الصائمين في رمضان؟', a: 'اللباس المحتشم والهدوء وعدم الأكل أو الشرب في الأماكن العامة نهاراً، واحترام الصائمين. هذه آداب عامة مناسبة للمكان؛ التزم بها خصوصاً في الأسواق والأزقة والأماكن القريبة من المساجد.' },
];

const sources = [
  { label: 'ساعات العمل المخفّضة في رمضان', org: 'وكالة الأنباء العُمانية (رسمي)', url: 'https://omannews.gov.om/topics/en/79/show/126980/ona', desc: 'إعلان رسمي بساعات العمل المخفّضة في رمضان للقطاعين العام والخاص، وهو سياق ينعكس على نسق عمل السوق.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان، ويُفهم منه أن فترة الزيارة المناسبة تمتد من سبتمبر إلى مايو.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع وساعات القائمة غير الرمضانية لمقارنتها بالوضع في الشهر.' },
];

const related = [
  { href: '/visit/opening-hours/', label: 'أوقات عمل سوق مطرح', desc: 'الساعات المعتادة خارج رمضان للمقارنة.' },
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'الموازنة بين الهدوء والازدحام في الشهر.' },
  { href: '/food/omani-food/', label: 'الأكلات العُمانية', desc: 'أطباق رمضانية ومناسبات الإفطار.' },
  { href: '/around/fish-market/', label: 'سوق السمك', desc: 'أثر رمضان على نشاط السوق صباحاً.' },
  { href: '/visit/family-practical/', label: 'الزيارة مع الأطفال', desc: 'توقيت مرن للعائلة في ليالي رمضان.' },
];
---
<GuideLayout
  title="سوق مطرح في رمضان: الساعات والأجواء | دليل سوق مطرح"
  h1="سوق مطرح في شهر رمضان"
  description="ماذا يتغير في سوق مطرح خلال رمضان: تعديل الساعات وذروة ما بعد الإفطار وآداب الزيارة وتوفّر الطعام، مع التأكيد على ضرورة التحقق من الساعات كل سنة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">شهر مختلف الإيقاع</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">كيف يتغيّر إيقاع السوق في رمضان؟</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="رمضان شهر قمري يبدأ في تاريخ مختلف كل سنة، ويعيد ترتيب الإيقاع اليومي في عُمان. تعتمد ساعات العمل في القطاعين العام والخاص على نسق مخفّض خلال الشهر، وينسحب ذلك على النشاط التجاري: فترات نهارية أقصر ثم حركة مسائية ممتدة بعد الإفطار." /></p>
            <p><BidiText text="لذلك لا يمكن نقل ساعات رمضان من سنة إلى أخرى كأنها ثابتة. أفضل ممارسة أن تتحقق من الساعات الفعلية قرب وقت زيارتك، لأن أول الشهر وآخره وليالي العشر قد تختلف أيضاً في الازدحام وساعات العمل." /></p>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-black text-[#18110d]">مقارنة عامة بين نهار الشهر ومسائه</h3>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-right text-sm">
              <thead>
                <tr class="bg-[#2b1b13] text-white">
                  <th class="p-4 font-black">الوقت</th>
                  <th class="p-4 font-black">الطابع الغالب</th>
                  <th class="p-4 font-black">ملاحظة للزائر</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-[#fffaf0]">
                  <td class="p-4 font-bold text-[#176b68]">النهار</td>
                  <td class="p-4 text-[#66574e]">حركة أهدأ وساعات أقصر</td>
                  <td class="p-4 text-[#66574e]">مناسب للتسوّق الهادئ مع احترام أجواء الصيام.</td>
                </tr>
                <tr class="bg-[#f7f0df]">
                  <td class="p-4 font-bold text-[#176b68]">قبيل المغرب</td>
                  <td class="p-4 text-[#66574e]">تحضيرات الإفطار وازدحام متزايد</td>
                  <td class="p-4 text-[#66574e]">تزدحم بعض المحال؛ تنقّل بحذر واحترام.</td>
                </tr>
                <tr class="bg-[#fffaf0]">
                  <td class="p-4 font-bold text-[#176b68]">بعد الإفطار</td>
                  <td class="p-4 text-[#66574e]">الأجواء الأكثر حيوية</td>
                  <td class="p-4 text-[#66574e]">الذروة الحقيقية؛ الأزقة أكثر ازدحاماً وإضاءةً.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">آداب ينبغي مراعاتها</p>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>اللباس المحتشم طوال الشهر.</li>
            <li>تجنّب الأكل والشرب في الأماكن العامة نهاراً.</li>
            <li>خفض الصوت في الأزقة والقرب من المساجد.</li>
            <li>احترام مواعيد الصلاة وحركة المصلين.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> ساعات رمضان غير ثابتة ولا ننقلها كجدول مؤكد؛ تحقّق من القنوات الرسمية وخرائط جوجل قرب موعد زيارتك.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">الطعام في الشهر</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">توفّر الطعام وسوق السمك</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">نهاراً</h3>
          <p class="mt-3 text-sm text-[#66574e]">كثير من المطاعم والمقاهي المحلية مغلق أو محدود؛ لا تعتمد على خيار نهارى قبل التحقق منه.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">عند الإفطار</h3>
          <p class="mt-3 text-sm text-[#66574e]">تعود المطاعم للعمل وتقدّم قوائم وأجواء الشهر؛ تتشكّل أزمة حركة قرب وقت المغرب.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <h3 class="text-lg font-black text-[#18110d]">سوق السمك</h3>
          <p class="mt-3 text-sm text-[#66574e]">يتأثر بروتين الصيد والطلب في الشهر؛ تحقّق من التوقيت الفعلي في يومك.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا محتوى هذه الصفحة في 2 نوفمبر 2026. ساعات رمضان تختلف سنوياً بحسب بداية الشهر ومدة النهار، ولم نتحقق من ساعات سوق مطرح الرمضانية ليوم محدّد." /></p>
        <p>لا تنقل ساعات الشهر من سنة إلى أخرى. تحقّق من الجهات الرسمية وخرائط جوجل قرب موعد الزيارة، وراعِ آداب الشهر في جميع الأحوال.</p>
      </div>
    </div>
  </section>
</GuideLayout>
