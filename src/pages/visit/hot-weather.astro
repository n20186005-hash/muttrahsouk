---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'الزيارة والوصول', href: '/visit/location/' },
  { name: 'الزيارة في الصيف' },
];

const quickFacts = [
  { label: 'الحرارة والرطوبة', value: 'شديدة في يونيو–أغسطس مع رطوبة ساحلية عالية' },
  { label: 'الأنسب زمنياً', value: 'الصباح الباكر أو بعد الغروب' },
  { label: 'الظل داخل السوق', value: 'الأسقف توفر ظلاً لا تبريداً' },
  { label: 'نمط الزيارة', value: 'فترات قصيرة متقطعة وراحة متكررة' },
];

const faq = [
  { q: 'كم تشتد الحرارة صيفاً في مسقط؟', a: 'مناخ مسقط صحراوي مداري حار جداً في الصيف، ويبلغ المتوسط في يونيو أعلى مستوياته السنوية، مع ارتفاع متوسط في يوليو وأغسطس. ويتضاعف الإحساس بالحرارة قرب الساحل بسبب الرطوبة العالية، خاصةً في أغسطس.' },
  { q: 'هل سوق مطرح مكيّف أو مظلل؟', a: 'الأزقة مسقوفة، وهذا يمنح ظلاً من الشمس المباشرة لكنه لا يبرّد الهواء ولا يلغي الحرارة والرطوبة. لذلك لا تعتمد على السقف كحلّ للحر، بل خفّف الجهد ورطّب جسمك.' },
  { q: 'ما أفضل وقت لزيارة السوق صيفاً؟', a: 'الصباح الباكر أخفّ حرارةً وأقل ازدحاماً، وبعد الغروب تكون الأجواء ألطف وإن كانت الحركة أكثر حيوية. تجنّب الظهيرة قدر الإمكان، فهي أثقل أوقات النهار.' },
  { q: 'كيف أتجنب الإرهاق الحراري؟', a: 'اشرب الماء باستمرار، واتخذ فترات راحة متكررة في الظل أو داخل مكان مبرّد، ولا تُطِل الوقوف في الشمس، وأجّل أي نشاط بدني مثل الصعود عند اشتداد الحرارة. أوقف النشاط واطلب الراحة عند الدوار أو الإرهاق الشديد.' },
  { q: 'هل يتأثر المشي إلى الكورنيش بالحرارة صيفاً؟', a: 'نعم، ممشى الكورنيش مكشوف غالباً، لذا يكون أنسب في الصباح الباكر أو بعد الغروب. في النهار يُفضّل تقصير المسافات والتحرك بين مناطق الظل.' },
];

const sources = [
  { label: 'مناخ مسقط — المتوسطات الشهرية', org: 'مرجع مناخي دولي (مصدر خارجي)', url: 'https://www.climatestotravel.com/climate/oman/muscat', desc: 'يصنّف مناخ مسقط كصحراوي مداري مع صيف طويل حار جداً، ويقدّم متوسطات الحرارة الشهرية.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'تحديد فترة الزيارة المناسبة من سبتمبر إلى مايو، ما يشير إلى أفضلية تجنّب ذروة الصيف.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع وساعات القائمة لتخطيط أوقات الزيارة الصيفية.' },
];

const related = [
  { href: '/visit/best-time/', label: 'أفضل وقت لزيارة السوق', desc: 'مقارنة الفصول واختيار الموسم الأنسب.' },
  { href: '/visit/family-practical/', label: 'الزيارة مع الأطفال', desc: 'تعامل خاص مع الحرارة والماء مع الصغار.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الأوقات الأنسب للممشى المكشوف.' },
  { href: '/food/quick-drinks/', label: 'الشاي والكرك والمشروبات', desc: 'توقفات سريعة للترطيب أثناء الجولة.' },
  { href: '/itineraries/2-hour-walk/', label: 'جولة مشي ساعتين', desc: 'مسار قصير يمكن تقديمه للصباح أو المساء.' },
];
---
<GuideLayout
  title="زيارة مطرح في الصيف: الحرارة والرطوبة | دليل سوق مطرح"
  h1="زيارة سوق مطرح في الصيف"
  description="دليل عملي لزيارة سوق مطرح في يونيو–أغسطس: حرارة ورطوبة مسقط العالية، والظل داخل الأزقة المسقوفة، وأفضل أوقات الزيارة، وخطة فترات قصيرة متقطعة."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-8">
        <div>
          <p class="kicker">صيف مسقط</p>
          <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">لماذا يكون الصيف مختلفاً في مطرح؟</h2>
          <div class="mt-5 space-y-4 text-[#58483e]">
            <p><BidiText text="مناخ مسقط صحراوي مداري، وفصله الصيفي طويل وحار جداً. تقترب أعلى المتوسطات الشهرية من مستوياتها القصوى في يونيو ويستمر الثقل الحراري في يوليو وأغسطس. ولأن مطرح على الساحل، تُضاف الرطوبة العالية إلى الحرارة، فيبدو الجو أثقل مما يظهر به الرقم وحده." /></p>
            <p><BidiText text="الأثر العملي واضح: المشي الطويل في النهار مُتعب حتى داخل السوق، والممشى البحري مكشوف غالباً. الخطأ الشائع أن يحسب الزائر نفسه على مسافة المضيّ ظناً أنها قصيرة؛ الصحيح أن يخطّط لفترات قصيرة متقطعة مع راحة ورطوبة." /></p>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-black text-[#18110d]">مقارنة أوقات النهار والمساء صيفاً</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">الصباح الباكر</b>
              <p class="mt-2 text-sm text-[#66574e]">الأخفّ حرارةً وأقل ازدحاماً؛ مناسب للسوق أولاً ثم الكورنيش قبل ارتفاع الشمس.</p>
            </div>
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">بعد الغروب</b>
              <p class="mt-2 text-sm text-[#66574e]">ألطف من النهار وأكثر حيوية؛ الأزقة المسقوفة أجمل تحت الإضاءة المسائية.</p>
            </div>
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">الظهيرة</b>
              <p class="mt-2 text-sm text-[#66574e]">أثقل الأوقات؛ الأفضل تجنّب المشي فيها والاكتفاء بأماكن الظل أو المبرّدة.</p>
            </div>
            <div class="card rounded-3xl p-5">
              <b class="text-[#176b68]">الممشى المكشوف</b>
              <p class="mt-2 text-sm text-[#66574e]">أنسب في الصباح أو المساء؛ في النهار قصّر المسافات وتحرّك بين مناطق الظل.</p>
            </div>
          </div>
        </div>
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة الترطيب والحماية</p>
          <ul class="mt-3 space-y-2 text-sm text-[#66574e]">
            <li>زجاجة ماء وتناولها بانتظام لا عند العطش فقط.</li>
            <li>واقٍ من الشمس وقبعة للأجزاء المكشوفة.</li>
            <li>ملابس خفيفة فاتحة تسمح بمرور الهواء.</li>
            <li>راحة متكررة في مكان مبرّد أو مظلل.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> الظل داخل الأزقة المسقوفة لا يعني برودة الهواء؛ الحرارة والرطوبة تبقى مرتفعة، فخفّف الجهد ولا تُطِل الوقوف.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">تخطيط فترات قصيرة</p>
      <h2 class="display mt-3 text-3xl font-black text-[#18110d] md:text-4xl">نموذج زيارة صيفية بدون إرهاق</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-3">
        <li class="card rounded-3xl p-6"><b class="block text-[#176b68]">مقطع أول</b><p class="mt-2 text-sm text-[#66574e]">صباحاً: جزء من السوق أثناء الأجواء الأبرد، ومعه ترطيب منتظم.</p></li>
        <li class="card rounded-3xl p-6"><b class="block text-[#176b68]">راحة</b><p class="mt-2 text-sm text-[#66574e]">فاصل في مكان مبرّد أو مظلل لخفض حرارة الجسم واستعادة النشاط.</p></li>
        <li class="card rounded-3xl p-6"><b class="block text-[#176b68]">مقطع ثانٍ</b><p class="mt-2 text-sm text-[#66574e]">مساءً: عودة للسوق والممشى بعد الغروب حيث الأجواء ألطف.</p></li>
      </ol>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell max-w-4xl">
      <p class="text-sm font-bold text-[#F6D98C]">التحقق قبل الانطلاق</p>
      <h2 class="display mt-3 text-3xl font-black">تاريخ التحقق والتنبيهات</h2>
      <div class="mt-5 space-y-3 text-[#d8eee9]">
        <p><BidiText text="راجعنا محتوى هذه الصفحة في 2 نوفمبر 2026. قيم الحرارة والرطوبة متوسطات مناخية عامة، والطقس الفعلي يتغيّر يومياً؛ راجع توقعات الطقس قبل الزيارة." /></p>
        <p>هذه نصائح عامة من دليل مستقل وغير رسمي وليست نصيحة طبية. عند وجود حالة صحية أو حساسية للحرارة، استشر مختصاً واتبع إرشادات السلامة الميدانية.</p>
      </div>
    </div>
  </section>
</GuideLayout>
