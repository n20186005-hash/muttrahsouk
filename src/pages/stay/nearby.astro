---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'برامج الزيارة والإقامة', href: '/itineraries/half-day/' },
  { name: 'الإقامة قرب السوق' },
];

const quickFacts = [
  { label: 'أقرب منطقة للسوق', value: 'مطرح — على مسافة مشي من الكورنيش' },
  { label: 'مناطق بديلة', value: 'روي والقرم وشاطئ القرم والموج' },
  { label: 'معيار الترخيص', value: 'تحقّق من ترخيص المنشأة وتصنيفها' },
  { label: 'التوافر والأسعار', value: 'متغيّرة — تحقّق من منصات الحجز' },
];

const sections = [
  {
    heading: 'قرب السوق أم قرب البحر؟',
    body: [
      'إذا كان هدفك الأساسي زيارة سوق مطرح ومشي الواجهة البحرية، فإن حي مطرح نفسه هو الأقرب، إذ يضعك على بُعد دقائق من مداخل السوق والكورنيش. يتميّز بطابع تاريخي وحياة يومية نشطة قرب الميناء، وقد يكون أهدأ في بعض الممرات وأكثر حيوية في أخرى. أما حي روي فطبيعته تجارية وتجمع نقل، ويناسب من يريد موقعاً مركزياً متصلاً ببقية المدينة.',
      'في الجهة المقابلة، تجمع منطقة القرم وشاطئ القرم بين قرب الشاطئ والمطاعم والخدمات، وتعدّ قاعدة شائعة لمن يريد مزيجاً من الراحة والوصول. وتتجه بعض الخيارات الحديثة نحو مناطق قريبة من الميناء الترفيهي والمناطق الساحلية التي تذكرها بوابة عُمان السياحية ضمن الوجهات الساحلية الفاخرة، وهي أبعد قليلاً عن السوق وتحتاج غالباً سيارة أو سيارة أجرة. هذا وصف لأنواع المناطق لا لأماكن بعينها، ولا تُفهم منه أي توصية.',
    ],
  },
  {
    heading: 'معايير الاختيار قبل الحجز',
    body: [
      'ابدأ بتحديد أولوياتك: المسافة وقابلية المشي إلى السوق، وسهولة الوصول بالمواصلات العامة أو سيارة الأجرة، وتوافر المواقف إن كنت تقود بنفسك. ثم انظر إلى مستوى الضجيج المتوقع، فالمناطق القريبة من السوق والميناء قد تشهد حركة مبكرة وأصواتاً عالية في بعض الأوقات، وقد يكون ذلك ميزة لمن يريد قربه من الفعاليات وعيباً لمن يبحث عن الهدوء.',
      'من المعايير المهمة أيضاً التحقق من أن المنشأة مرخّصة كمؤسسة سياحية، إذ تتمثّل مسؤولية الترخيص والتصنيف في السلطنة في وزارة التراث والسياحة. كما يوصي المصدر الرسمي للزائر بحفظ الجوازات والأموال والمقتنيات في مكان آمن، وهذه نصائح عامة تنطبق على أي منطقة تقيم فيها. راجع أيضاً سياسة الإلغاء، وحدود الوصول، وملاءمة المكان للأطفال أو لذوي الاحتياجات الخاصة قبل التأكيد.',
    ],
  },
  {
    heading: 'كيف تتحقق من التوافر والسعر الحالي؟',
    body: [
      'لا نذكر هنا أي منشأة بعينها ولا أي سعر، لأن الفنادق ودور الضيافة تتغيّر أسعارها وتوافرها باستمرار، ويتأثّر الطلب بالموسم والعطلات. الفترة الأكثر طلباً تقع عادةً في الأشهر المعتدلة بين سبتمبر ومايو، وترتفع الحجوزات حول المناسبات والإجازات، فمن الحكمة الحجز مبكراً حين يقترب موعدك من هذه الأوقات.',
      'للتأكد من التفاصيل الحالية، راجع منصات الحجز المعروفة وقنوات المنشأة الرسمية، وقارن الموقع الفعلي بالنسبة إلى السوق على الخريطة، واقرأ أحدث المراجعات، وتحقّق من السعر الإجمالي بعد الرسوم وسياسة الإلغاء قبل الدفع. تبقى كل تفاصيل التوافر والأسعار والتصنيف غير مؤكَّدة هنا وتخضع تحديثاً مستمراً؛ تحقّق منها مباشرة عند الحجز، وقد راجعنا المعلومات الواردة هنا حتى 2 نوفمبر 2026.',
    ],
  },
];

const faq = [
  { q: 'ما أقرب منطقة للإقامة إلى سوق مطرح؟', a: 'حي مطرح نفسه هو الأقرب، إذ يقصر المسافة إلى مداخل السوق والكورنيش. هذا وصف عام لنوع المنطقة ولا نسمّي أي فندق أو دار ضيافة بعينها.' },
  { q: 'هل أسعار الإقامة ثابتة؟', a: 'لا؛ الأسعار متغيّرة بحسب الموسم والعطلات ونوع الغرفة وسياسة الإلغاء. لا نثبت أي سعر في هذا الدليل، والأفضل مقارنة الأسعار الحالية على منصات الحجز قبل التأكيد.' },
  { q: 'كيف أتأكد أن منشأة الإقامة مرخّصة؟', a: 'تقع مسؤولية ترخيص وتصنيف المؤسسات السياحية في السلطنة على وزارة التراث والسياحة، ويُستحسن التحقق من التصنيف والترخيص في الأدلة والمنصات الرسمية قبل الحجز.' },
  { q: 'هل أحتاج سيارة إن أقمت بعيداً عن السوق؟', a: 'يعتمد ذلك على المنطقة؛ بعض المناطق قريبة ويمكن مشيها، وأخرى تحتاج سيارة أجرة أو حافلة أو سيارة خاصة. راجع صفحة الوصول والمواقف لتفهم خيارات التنقّل.' },
  { q: 'ما أفضل وقت للحجز؟', a: 'كلما اقترب موعدك من الأشهر المعتدلة أو العطلات ارتفع الطلب، فيُستحسن الحجز مبكراً. تبقى التوافر والأسعار مسألة تتغيّر، فتحقّق منها عند الحجز.' },
];

const sources = [
  { label: 'مسقط — تعريف الوجهة', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'نظرة رسمية على أحياء مسقط ووجهاتها الساحلية وفئات الإقامة.' },
  { label: 'دليل السياحة العُماني (فهرس الإقامة والفنادق)', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/media/pigfokjz/oman-tourism-directory.pdf', desc: 'دليل رسمي يصنّف أماكن الإقامة والفنادق والشقق الفندقية في محافظات السلطنة.' },
  { label: 'إرشادات سياحية للزائرين', org: 'وزارة الخارجية العُمانية (رسمي)', url: 'https://www.fm.gov.om/en/visitors/travel-advice-for-visitors/', desc: 'إرشادات عامة للزائر تشمل حفظ المقتنيات وسلامة التنقّل.' },
];

const related = [
  { href: '/itineraries/half-day/', label: 'برنامج نصف يوم', desc: 'كيف توزّع وقتك حول السوق والمعالم.' },
  { href: '/visit/from-airport/', label: 'من مطار مسقط إلى السوق', desc: 'خيارات الوصول بعد هبوط الطائرة.' },
  { href: '/visit/parking/', label: 'مواقف سوق مطرح', desc: 'إن أقمت بعيداً وأردت القيادة بنفسك.' },
  { href: '/food/nearby-restaurants/', label: 'مطاعم قريبة من السوق', desc: 'أين تأكل قرب منطقة إقامتك.' },
  { href: '/around/old-muscat/', label: 'مسقط القديمة', desc: 'منطقة تاريخية قريبة من خيارات الإقامة.' },
];
---
<GuideLayout
  title="أين تنام قرب سوق مطرح: مناطق الإقامة ومعايير الاختيار | دليل سوق مطرح"
  h1="الإقامة قرب سوق مطرح: المناطق والمعايير"
  description="دليل محايد للإقامة قرب سوق مطرح: الفرق بين مناطق مطرح وروي والقرم والساحل، معايير اختيار السكن، والتحقق من الترخيص والتوافر والأسعار الحالية."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">أسئلة تسألها قبل التأكيد</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li>ما المسافة الفعلية من المنشأة إلى مدخل السوق، وهل المسار صالح للمشي؟</li>
            <li>هل يتوفر موقف للسيارة؟ وهل توجد رسوم أو شروط محلية؟</li>
            <li>هل المنشأة مرخّصة ومصنّفة كمؤسسة سياحية؟</li>
            <li>ما السعر الإجمالي بعد الرسوم، وما سياسة الإلغاء؟</li>
            <li>هل يلائم المستوى المطلوب من الهدوء واحتياجات الوصول لجميع المرافقين؟</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه الحياد:</b> لا يسمّي هذا الدليل أي فندق أو دار ضيافة، ولا يثبت أي سعر أو توافر. استخدم المعايير هنا كإطار تخطيط فقط، وتحقق من كل التفاصيل الحالية مباشرة عند الحجز كما اطّلعنا عليها حتى <BidiText text="2 نوفمبر 2026" />.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
