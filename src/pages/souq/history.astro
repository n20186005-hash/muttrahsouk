---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'تاريخ سوق مطرح' },
];

const quickFacts = [
  { label: 'الموقع التاريخي', value: 'الواجهة البحرية في مطرح' },
  { label: 'البناء القديم', value: 'الطين وسعف النخيل' },
  { label: 'الأسقف', value: 'خشبية منقوشة' },
  { label: 'أبرز السلع', value: 'اللبان والبخور والعطور والفضيات' },
];

const sections = [
  {
    heading: 'سوق على الواجهة البحرية',
    body: [
      'يقع سوق مطرح على الواجهة البحرية من جانب مدينة مطرح، ملاصقاً للميناء الذي ارتبط به تاريخياً. هذا الموقع الساحلي هو ما جعل السوق محطة طبيعية للتجارة وتبادل السلع، إذ يلتقي فيه القادمون من البحر بمن يقصدونه من داخل عُمان.',
      'تذكر بلدية مسقط أن السوق يقع على واجهة عُمان البحرية، وأن وجوده قرب الميناء جعله مركزاً تجارياً وثقافياً يقصده الزوار من داخل السلطنة وخارجها.',
    ],
  },
  {
    heading: 'الأزقة المتعرجة والأسقف الخشبية',
    body: [
      'تصف بلدية مسقط السوق بأنه نموذج للأسواق الشعبية التقليدية، يتميّز بتصميم معماري قديم مع ممرات ضيقة ومتعرجة وأسقف خشبية منقوشة. هذه الأسقف مزخرفة بزخارف مستوحاة من التراث العُماني.',
      'وتذكر البلدية أن السوق كان في السابق مبنياً من الطين وسعف النخيل، ثم جرى تطويره وصيانته مع الحفاظ على طابعه التقليدي الأصيل. لذلك فالتشكيل الحالي هو نتيجة تطور طويل، لا بناء واحد في لحظة واحدة.',
    ],
  },
  {
    heading: 'السلع التي صنعت سمعة السوق',
    body: [
      'تشير المصادر البلديّة إلى تنوّع سلع السوق: التحف والهدايا والبخور واللبان والعطور، إلى جانب الفخاريات العُمانية والفضيات وخناجر الفضة والأقمشة. ويذكر الوصف أن بعض هذه السلع يصعب العثور عليه في الأسواق الحديثة، وهو ما يمنح السوق تفرده.',
      'ويميّز الزائر رائحة السوق برائحة البخور واللبان العُماني، وهذه الرائحة نفسها جزء من هوية المكان بحسب الوصف الرسمي. ولمعرفة الفئات التي يقبل عليها الزوار، راجع صفحة ماذا تشتري.',
    ],
  },
  {
    heading: 'علاقة السوق بميناء مطرح والنشاط التجاري',
    body: [
      'ارتبط سوق مطرح بميناء مطرح وبالنشاط التجاري في الحي، فالميناء جعل المدينة نقطة التقاء للتجارة البحرية، والسوق هو الواجهة التي يبيع فيها التجار والحرفيون.',
      'هذه العلاقة بين الميناء والسوق هي مفتاح فهم المكان: السوق ليس معزولاً عن الحياة اليومية، بل هو امتداد لاقتصاد بحري قائم على الحركة والتبادل. ومع تطوّر مطرح تطوّر السوق معه مع بقاء طابعه التقليدي.',
    ],
  },
  {
    heading: 'أعمال التطوير البلدي',
    body: [
      'تذكر بلدية مسقط قيامها بأعمال تجميل وتطوير للسوق، منها تبليط الطرقات والسكك والأزقة، وتركيب مظلات ثابتة على أروقة السوق الداخلية للوقاية من الشمس والأمطار، وإضافة كراسي وإنارة داخلية للممرات.',
      'كما جرى تُركيب إنارة تجميلية على المدخل وبعض الأروقة الرئيسية، وتطوير دورات المياه عند مدخل السوق من الطريق البحري، وتركيب لوحات إرشادية لتعريف مرتادي السوق بأقسامه ومداخله ومخارجه. هذه الأعمال تهدف إلى موازنة الحفاظ على الطابع الأصيل مع تحسين تجربة الزائر.',
    ],
  },
];

const faq = [
  { q: 'ما أصل سوق مطرح؟', a: 'يذكر الوصف البلدي أن السوق كان في السابق مبنياً من الطين وسعف النخيل، ثم جرى تطويره وصيانته مع الحفاظ على طابعه التقليدي. وارتبط تاريخياً بميناء مطرح والنشاط التجاري في الحي.' },
  { q: 'هل يقع السوق قرب الميناء؟', a: 'نعم، يقع سوق مطرح على الواجهة البحرية من جانب مدينة مطرح، وملاصقاً للميناء الذي ارتبط به تاريخياً.' },
  { q: 'ما الذي يميّز تصميم السوق؟', a: 'ممرات ضيقة ومتعرجة وأسقف خشبية منقوشة بزخارف مستوحاة من التراث العُماني، بحسب وصف بلدية مسقط.' },
  { q: 'ما أشهر السلع في السوق؟', a: 'اللبان والبخور والعطور والتحف والهدايا والفضيات والخناجر والأقمشة والفخاريات العُمانية، بحسب الوصف الرسمي.' },
  { q: 'هل جرى تطوير السوق؟', a: 'نعم، ذكرت بلدية مسقط أعمال تبليط وتطوير للممرات، وتركيب مظلات وإنارة، وتطوير دورات المياه عند المدخل البحري ولوحات إرشادية.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'الوصف البلدي التفصيلي للسوق: الممرات والأسقف والسلع وأعمال التطوير.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'التعريف الرسمي بالمكان وسياقه كسوق تقليدي في مطرح.' },
  { label: 'تجربة عُمان — محافظة مسقط', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat', desc: 'سياق عام لمحافظة مسقط وتاريخ مطرح ومينائها.' },
];

const related = [
  { href: '/souq/al-dhalam/', label: 'لماذا يسمى سوق الظلام؟', desc: 'تفسير الاسم وعلاقته بالأزقة المسقوفة.' },
  { href: '/souq/architecture/', label: 'عمارة سوق مطرح التقليدية', desc: 'تفاصيل الممرات والأسقف الخشبية والجدران.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'الواجهة البحرية التي يقع عليها السوق.' },
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري من السوق', desc: 'فئات السلع التي اشتهر بها السوق.' },
];
---
<GuideLayout
  title="تاريخ سوق مطرح: من ميناء مطرح إلى أزقته المسقوفة | دليل سوق مطرح"
  h1="تاريخ سوق مطرح"
  description="نبذة عن تاريخ سوق مطرح كما تصفه بلدية مسقط: موقعه على الواجهة البحرية، ممراته المتعرجة وأسقفه الخشبية المنقوشة، وسلعه، وعلاقته بميناء مطرح."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">من الميناء إلى السوق</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">حكاية سوق نشأ على الماء</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="لفهم سوق مطرح، ابدأ من موقعه: سوق على الواجهة البحرية ملاصق للميناء، نشأ حيث تلتقي التجارة البحرية بالحياة اليومية في مطرح. هذا التلازم بين الماء والسوق هو الخيط الذي يشرح كثيراً من ملامح المكان اليوم." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الموقع</b>
          <p class="mt-3 text-sm text-[#66574e]">واجهة بحرية في مطرح، بجوار الميناء؛ نقطة التقاء التجارة والزوار.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">البناء</b>
          <p class="mt-3 text-sm text-[#66574e]">كان في السابق من الطين وسعف النخيل، ثم جرى تطويره مع الحفاظ على الطابع.</p>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">الأسقف</b>
          <p class="mt-3 text-sm text-[#66574e]">خشبية منقوشة بزخارف مستوحاة من التراث العُماني، بحسب الوصف البلدي.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(0).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه منهجي:</b> لا نحدّد في هذه الصفحة تاريخ تأسيس للسوق، ولا نروي أساطير غير موثّقة. الاعتماد هنا على ما تصفه الجهات الرسمية فقط، وكل ما عدا ذلك يُترك بلا جزم.
        </div>
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">أين أقرأ أكثر؟</p>
          <p class="mt-3 text-sm text-[#66574e]">لمزيد من تفاصيل الممرات والأسقف، راجع صفحة العمارة التقليدية، ولتفسير اسم السوق راجع صفحة سوق الظلام.</p>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> التفاصيل التاريخية مأخوذة من صفحات رسمية؛ إن كنت بحاجة إلى تدقيق أكاديمي أو تاريخي دقيق، فراجع الجهات المختصة بالتراث في السلطنة.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
