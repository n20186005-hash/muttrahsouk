---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'الأقمشة والملابس' },
];

const quickFacts = [
  { label: 'أشهر الملابس الرجالية', value: 'الدشداشة والكمة والمسار' },
  { label: 'قطع الزي النسائي التقليدي', value: 'كندورة وسروال ولحاف' },
  { label: 'منسوجات شائعة', value: 'أقمشة مطرزة وأوشحة ومفارش' },
  { label: 'نصيحة الشراء', value: 'افحص الحبكة والقماش واسأل عن المنشأ' },
];

const sections = [
  {
    heading: 'الأسماء التي ستسمعها في السوق',
    body: [
      'في قسم الأقمشة والملابس ستتكرّر أمامك أسماء عُمانية محددة. أبرزها للرجال «الدشداشة»، وهي ثوب فضفاض طويل بلا ياقة وبأكمام طويلة، غالباً أبيض لكنه يأتي بألوان أخرى، وتتدلّى عند فتحة رقبته شرابة تُعطَّر أحياناً. ويُكمل الزيَ غطاء الرأس، إما «الكمة» وهي قبعة مطرّزة تُلبَس في أوقات الراحة، وإما «المسار» وهو شال مربّع يُلفّ حول الرأس. وعلى المناسبات الرسمية يُلبَس الخنجر على الخصر.',
      'وفي الزي النسائي التقليدي تتكرّر ثلاث قطع: «الكندورة» أو الثوب الطويل المطرّز على الأكمام، و«السروال» وهو بنطال فضفاض يضيق عند الكاحل، و«اللحاف» وهو شال يُغطّي الرأس. وتختلف الألوان والتطريز بحسب المنطقة، وتلبس كثير من النساء اليوم عباءة سوداء فضفاضة فوق ملابسهن في المناسبات العادية.',
    ],
  },
  {
    heading: 'كلمة «اللباس» وما يعنيه في السياق العُماني',
    body: [
      'كلمة «اللباس» في العربية تعني الملبوس عموماً، وليست اسماً لقطعة واحدة بعينها؛ ولذلك قد تسمع البائع يقول «اللباس العُماني» إشارة إلى الزي التقليدي بمجمله. ومن المفيد أيضاً معرفة أن الرجل يلبس تحت الدشداشة قطعة قماش تُلفّ حول الخصر، وأن الخنجر يُعدّ جزءاً من الزي في المناسبات والأعياد.',
      'هذه التسميات متجذّرة في الثقافة العُمانية وتظهر في السياقين الرسمي واليومي. أمّا تفاصيل كل قطعة من حيث القَصّة والتطريز فتختلف اختلافاً كبيراً من منطقة إلى أخرى، ومن محالٍ إلى محال، فاحتفظ بالمرونة ولا تفترض نمطاً واحداً لكل الأثواب المعروضة.',
    ],
  },
  {
    heading: 'ماذا يُباع فعلاً وكيف تشتري بثقة؟',
    body: [
      'يضم جانب المنسوجات أقمشة تُباع بالمتر، وملابس تقليدية جاهزة، وأوشحة ومفارش وحوائج منزلية، وتطريزاً يدوياً، وإمكانية تفصيل بعض القطع في المحل نفسه. وكما هي حال السوق منذ قرون، تصل بعض الأقمشة من أسواق تجارية خارجية، ويُصنع بعضها محلياً؛ لذلك يبقى الأصل والجودة متفاوتين من محل إلى آخر.',
      'عند الشراء افحص وزن القماش وملاءمته للطقس الحار، وتمييز التطريز اليدوي من الآلي، وجودة الحبكة، وثبات اللون، والمقاس. اسأل البائع عن المنشأ وطريقة العناية قبل الدفع، وتذكّر أن الأسعار قابلة للتفاوض في كثير من المحال حسب نوع القطعة، وأن هذا الدليل لا يثبت سعراً بعينه ولا يوصي بمحل معيّن.',
    ],
  },
];

const faq = [
  { q: 'ما الفرق بين الدشداشة والكندورة؟', a: 'كلتاهما ثوب طويل، لكن «الدشداشة» تُستخدم في وصف الزي الرجالي المكوّن من ثوب بلا ياقة وبأكمام طويلة، بينما «الكندورة» اسم شائع للثوب النسائي المطرّز. تختلف التفاصيل بحسب المنطقة والمحل.' },
  { q: 'ماذا يلبس الرجال العُمانيون تقليدياً؟', a: 'الدشداشة مع الكمة أو المسار على الرأس، ويُضاف الخنجر على الخصر في المناسبات الرسمية والأعياد. الألوان والأقمشة تتغيّر بحسب الفصل والمناسبة.' },
  { q: 'هل الأقمشة المعروضة محلية أم مستوردة؟', a: 'يختلف ذلك من محل إلى آخر؛ تصل بعض الأقمشة من أسواق تجارية خارجية ويُصنع بعضها محلياً. لا يمكننا الجزم بمصدر قطعة بعينها، والأدق أن تسأل البائع عن المنشأ قبل الشراء.' },
  { q: 'هل يمكن تفصيل ثوب داخل السوق؟', a: 'توفّر بعض المحال خدمات التفصيل، لكن توفّرها ومدة التنفيذ والسعر أمور تخص كل محل على حدة ولا نضمنها؛ اتفق على التفاصيل بوضوح قبل الترك.' },
  { q: 'هل الأسعار ثابتة؟', a: 'تختلف الممارسة من محل إلى آخر، وكثير من المحال يقبل التفاوض. لا يثبت هذا الدليل أي سعر، ويمكنك مراجعة صفحة المساومة والدفع لفهم الأسلوب المناسب.' },
];

const sources = [
  { label: 'ثقافة عُمان — الزي الوطني', org: 'سفارة سلطنة عُمان (رسمي)', url: 'https://www.omanembassy.org/about-oman/culture/', desc: 'وصف الزي الرجالي: الدشداشة وشرابتها وغطاء الرأس والخنجر.' },
  { label: 'ثقافة عُمان — الملابس والطعام', org: 'ويكيبيديا', url: 'https://en.wikipedia.org/wiki/Culture_of_Oman', desc: 'أسماء الزي الرجالي والنسائي: الدشداشة والكمة والمسار والكندورة والسروال واللحاف.' },
  { label: 'سوق مطرح — التعريف الرسمي', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'وصف السوق كمتاهة من الأزقة والمحال المفعمة بالمنسوجات والحرف.' },
];

const related = [
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري من سوق مطرح', desc: 'نظرة شاملة على أقسام السوق.' },
  { href: '/souq/bargaining-payment/', label: 'المساومة والدفع', desc: 'أسلوب التفاوض ووسائل الدفع.' },
  { href: '/souq/silver-khanjar/', label: 'الفضة والخناجر', desc: 'الخنجر العُماني والمشغولات الفضية.' },
  { href: '/souq/perfume-spices/', label: 'العطور والتوابل', desc: 'قسم عطري قريب من قسم الأقمشة.' },
  { href: '/visit/entrances/', label: 'المداخل والبوابات', desc: 'أقرب مدخل لقسم الأقمشة.' },
];
---
<GuideLayout
  title="الأقمشة والملابس في سوق مطرح: الدشداشة والكمة والمنسوجات | دليل سوق مطرح"
  h1="الأقمشة والملابس التقليدية في سوق مطرح"
  description="دليل المنسوجات في سوق مطرح: الدشداشة والكمة والمسار والخنجر، والزي النسائي كالكندورة والسروال واللحاف، وقطع النسيج المتنوعة ومعايير شرائها."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">معجم سريع لمصطلحات الملابس</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">الدشداشة:</b> ثوب رجالي طويل بلا ياقة وبأكمام طويلة وشرابة عند الرقبة.</li>
            <li><b class="text-[#18110d]">الكمة:</b> قبعة رجالية مطرّزة تُلبَس في أوقات الراحة.</li>
            <li><b class="text-[#18110d]">المسار:</b> شال مربّع يُلفّ حول الرأس على المناسبات.</li>
            <li><b class="text-[#18110d]">الكندورة:</b> ثوب نسائي طويل غالباً بتطريز على الأكمام.</li>
            <li><b class="text-[#18110d]">السروال:</b> بنطال فضفاض يضيق عند الكاحل.</li>
            <li><b class="text-[#18110d]">اللحاف:</b> شال نسائي يُغطّي الرأس.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة الاستقلالية:</b> هذه الصفحة تشرح أسماء الأزياء العامة ومعايير الاختيار، ولا تسمّي محالاً ولا تنشر أسعاراً أو توصيات تجارية. تحقّق من المنشأ والجودة بنفسك قبل الشراء.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
