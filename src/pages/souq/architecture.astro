---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'العمارة التقليدية' },
];

const quickFacts = [
  { label: 'الطابع المعماري', value: 'سوق مسقوف بممرات ضيقة ومتشابكة' },
  { label: 'مواد البناء الشائعة', value: 'الحجر والجص والخشب' },
  { label: 'سبب التغطية', value: 'حماية الممرات من الشمس والحرارة' },
  { label: 'الاسم المحلي', value: 'سوق الظلام' },
];

const sections = [
  {
    heading: 'لماذا بُني سوق مطرح مسقوفاً ومظلّلاً؟',
    body: [
      'يقع السوق في حي مطرح على الواجهة البحرية لمسقط، حيث تشتد الحرارة والرطوبة في معظم أشهر السنة. ولهذا صُمّمت ممراته ضيقة ومسقوفة، فتحجب امتداد ضوء الشمس وتحتفظ بقدر من الظل والبرودة النسبية بين الجدران. تشير دراسات متخصصة في تراث السوق إلى أن هذه الممرات شُيّدت بهذا الشكل عن قصد، وأن سوادها النسبي هو أصل التسمية المحلية «سوق الظلام».',
      'تبيّن الوصف الميداني أن السوق الأصلي اعتمد على مواد محلية في تغطيته، ثم تطوّرت عناصر التغطية عبر أعمال الترميم والتطوير اللاحقة. لذلك قد تجد اليوم خليطاً بين أجزاء تحافظ على طابعها التقليدي وأخرى أُعيد تشكيلها أو غُطّيت بأسقف أحدث. هذا التنوّع طبيعي في سوق ما زال يعمل، لا في متحف مغلق.',
    ],
  },
  {
    heading: 'الخشب والحجر والجص: عناصر الهوية المعمارية',
    body: [
      'أبرز ما يميّز تفاصيل السوق استخدام الخشب في الأسقف والأقواس والبوابات، فتُشكّل الأخشاب هيكل السقف وتُزيَّن أحياناً بحُليات بسيطة. ويظهر الحجر والجص في الجدران والمحال، إلى جانب ألوان من التزجيج والنوافذ الصغيرة والإضاءة التقليدية التي تضيء قلب الممرات.',
      'تعمل الجدران السميكة والأسقف المغطاة معاً كدُروع مناخية بسيطة: تحدّ من دخول الحرارة نهاراً وتحتفظ بالبرودة نسبياً. وكلما توغّلت داخل الممرات ابتعدت عن ضوء النهار المباشر، فتتبدّل الألوان وملمس المواد بحسب موضعك من المدخل.',
    ],
  },
  {
    heading: 'كيف تقرأ تخطيط السوق اليوم؟',
    body: [
      'للسوق عدة مداخل رئيسية: مدخل شمالي يطل على الطريق البحري والكورنيش وفيه مساحات نزول للسيارات والحافلات، وعقدة تجمّع مسقوفة في القلب يخفّ فيها ضوء النهار، ومدخل خلفي جنوبي غربي قريب من بوابة مطرح ومن منطقة فيها مركز شرطة. هذا التنوّع في المداخل يوزّع حركة الوافدين ويخفّف الاحتكاك عند أكثر النقاط ازدحاماً.',
      'تطوّرت بعض المحال من غرف منازل قديمة كانت تُستخدم للتخزين، ثم فُتحت على الممرات لتصبح محال تطل على الزوّار. وعندما تمشي ببطء وترفع نظرك إلى الأسقف والأقواس، ستقرأ طبقات هذه المراحل، وهو ما يجعل السوق مختلفاً عن المعارض المغلقة.',
    ],
  },
];

const faq = [
  { q: 'لماذا يُعرف سوق مطرح باسم سوق الظلام؟', a: 'لأن ممراته ضيقة ومسقوفة فتحجب معظم ضوء الشمس المباشر، فيبدو الجزء الداخلي مظلماً نسبياً، ومن هذه الظلال جاء الاسم المحلي.' },
  { q: 'ممَّ بُنيت أسقف السوق؟', a: 'تشير الدراسات المنشورة إلى استخدام الخشب في الأسقف والأقواس والبوابات، مع الحجر والجص في الجدران، ثم أضافت الأعمال اللاحقة عناصر تغطية أحدث. تختلف المواد من جزء لآخر، وهي تفاصيل تراثية لا جرد رسمي محدّث.' },
  { q: 'هل السوق مبنى تاريخي واحد؟', a: 'لا؛ السوق مجموعة ممرات ومحال نمت عضواً عبر مراحل، وبعض المحال كانت غرف منازل فُتحت على الممرات. لذلك ترى فيه خليطاً من طبقات زمنية مختلفة.' },
  { q: 'هل أستطيع فهم العمارة دون مرشد؟', a: 'نعم، التعرّف على الخشب والحجر والعقد المسقوفة ممكن بالمشي والتأمل. ومع ذلك لا نضمن توافر جولات مرشدة في وقت معيّن؛ اسأل عند المدخل إن رغبت بمرافقة.' },
];

const sources = [
  { label: 'سوق مطرح — التعريف الرسمي', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'تعريف رسمي بالمكان وسياقه ضمن معالم مسقط.' },
  { label: 'سوق مطرح .. بين عبق الماضي وإشراقة الحاضر', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف البلدي للممرات والمحال والاسم التاريخي وأعمال التطوير المحيطة.' },
  { label: 'دراسة: الحفاظ على التراث المادي في عُمان — سوق مطرح', org: 'دورية أكاديمية محكّمة', url: 'https://ijetrm.com/issues/files/Feb-2024-08-1707380171-FEB003.pdf', desc: 'تحليل معماري لعناصر السوق ومداخله واستخدام الخشب في الأسقف والأقواس.' },
  { label: 'دراسة: الشكل والوظيفة في سوقين تقليديين في الشرق الأوسط', org: 'دورية أكاديمية محكّمة', url: 'https://mdpi-res.com/d_attachment/sustainability/sustainability-12-07154/article_deploy/sustainability-12-07154.pdf', desc: 'مقارنة معمارية بين سوق مطرح وسوق آخر في المنطقة.' },
];

const related = [
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'سياق زمني لتطوّر السوق ووظائفه.' },
  { href: '/souq/al-dhalam/', label: 'لماذا سوق الظلام؟', desc: 'قصة الاسم وظلال الممرات.' },
  { href: '/visit/entrances/', label: 'المداخل والبوابات', desc: 'أقرب مدخل بحسب مكان وصولك.' },
  { href: '/around/fort/', label: 'قلعة مطرح', desc: 'نموذج لعمارة عُمانية تحصينية قريبة.' },
  { href: '/souq/textiles-clothing/', label: 'الأقمشة والملابس', desc: 'ما يُعرض داخل الممرات المسقوفة.' },
];
---
<GuideLayout
  title="عمارة سوق مطرح التقليدية: الممرات المسقوفة والأخشاب | دليل سوق مطرح"
  h1="العمارة التقليدية في سوق مطرح"
  description="كيف بُني سوق مطرح: الممرات المسقوفة الضيقة، الأسقف والأقواس الخشبية، الجدران الحجرية والجصية، ومداخله الثلاثة، وتأثير مناخ مطرح على تصميمه."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">كيف تستشعر العمارة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li>امشِ ببطء وارفع نظرك إلى الأسقف والأقواس بدل الاقتصار على واجهات المحال.</li>
            <li>لاحظ الانتقال من المساحات المفتوحة عند المدخل إلى العقد المسقوفة في القلب.</li>
            <li>الضوء غير المباشر أنسب لرؤية تفاصيل الخشب والحجر وتجسّد اللون.</li>
            <li>احترم ضيق الممرات ولا تسدّ حركة المارّة أثناء التوقف للتصوير أو التأمل.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة:</b> وصف المواد والمراحل الإنشائية مستند إلى دراسات ومصادر منشورة كما اطّلعنا عليها حتى <BidiText text="2 نوفمبر 2026" />. قد تتبدّل التفاصيل بعد كل عملية ترميم، وهذا وصف عام لا جرد هندسي دقيق.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
