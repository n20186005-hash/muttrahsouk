---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'سوق الجملة والسوق التقليدي' },
];

const quickFacts = [
  { label: 'عدد المحال', value: 'نحو 1274 محلاً بحسب بلدية مسقط' },
  { label: 'قسم الزوار', value: 'الأزقة المسقوفة التقليدية للتحف والهدايا' },
  { label: 'قسم الجملة', value: 'نشاط تجاري قائم على البيع بالكميات والبضائع' },
  { label: 'أوقات الازدحام', value: 'المساء والعطلات غالباً أكثر ازدحاماً' },
];

const sections = [
  {
    heading: 'لماذا يُوصف سوق مطرح بأنه قسمان؟',
    body: [
      'يجمع سوق مطرح بين طابعين متجاورين: قسم تقليدي موجّه للزائر يجذب السائح بمنتجاته من التحف والهدايا والبخور والفضيات والمنسوجات، ونشاط تجاري أوسع مرتبط بالبيع بالكميات والبضائع اليومية. تشير بلدية مسقط إلى أن السوق يضم نحو 1274 محلاً، وهذا وحده يوضح تنوع النشاط داخله.',
      'الحدود بين القسمين غير حادة، فبين أزقة الهدايا تجد محالاً تخدم التزويد والتجارة، كما تتشابه المداخل في كثير من الأحيان. الأهم للزائر أن يفهم أي قسم يخدم حاجته قبل أن يقارن الأسعار أو يبحث عن منتج بعينه.',
    ],
  },
  {
    heading: 'من يرتاد كل قسم؟',
    body: [
      'القسم التقليدي يرتاده الزوار والسياح والمقيمون الباحثون عن الهدايا والتحف والتجربة الثقافية، وقد يشتري المقيمون منه الهدايا الموسمية. أما النشاط التجاري والجملة فيرتبط عادةً بمن يبحث عن كميات أو بضائع للتزويد، وقد يزيد الاختلاط في أوقات معينة.',
      'هذا لا يعني أن أحد القسمين محجوز عن الزائر؛ فالجميع يمرّون في المساحة نفسها. لكن إدراك طبيعة القسم يساعدك على توقّع مستوى الأسعار وأسلوب التعامل، وعلى احترام خصوصية العاملين في المحال التجارية التي لا تستهدف البيع الفردي.',
    ],
  },
  {
    heading: 'أوقات الازدحام وما يتوقعه الزائر',
    body: [
      'يبلغ السوق ذروته عادةً في المساء وفي العطلات والمناسبات، ويتسم الصباح بالهدوء النسبي، وهو ما يجده بعض الزوار أنسب للتسوق الهادئ والتصوير. في المواسم المزدحمة يضيق التنقل في الأزقة، لذلك اترك مساحة للمارة ولا توقف حركة الممرات.',
      'في القسم التقليدي توقّع منتجات موجّهة للعرض والهدايا، وفي القسم التجاري توقّع بضائع تُشترى بالكميات وبأسلوب تعامل أكثر مباشرة. في الحالتين اسأل عن السعر والمنشأ والجودة قبل الشراء، ولا تعتمد على العنوان وحده لتحديد ما تريده.',
    ],
  },
  {
    heading: 'العلاقة بالميناء وسوق السمك',
    body: [
      'يرتبط سوق مطرح تاريخياً بواجهته البحرية وحركة الميناء، وهذا القرب هو ما جعل النشاط التجاري يتجاور مع النشاط الموجّه للزوار. قريباً من السوق يقع سوق السمك، حيث يبدأ النشاط عادةً في ساعات الصباح، ما يمنح المنطقة إيقاعاً تجارياً يومياً مختلفاً عن أزقة الهدايا.',
      'لمن يريد فهم الصورة كاملة، يمكن دمج جولة السوق مع مشاهدة سوق السمك والميناء في جولة واحدة. راجع صفحات المعالم القريبة لترتيب الجولة بحسب الوقت المتاح لك.',
    ],
  },
];

const faq = [
  { q: 'ما الفرق بين قسم الجملة والقسم التقليدي في مطرح؟', a: 'القسم التقليدي موجّه للزوار ويغلب عليه عرض التحف والهدايا والبخور والفضيات، أما النشاط التجاري والجملة فيرتبط بالبيع بالكميات والبضائع للتزويد. الحدود بينهما غير حادة، وقد يمرّ الزائر في القسمين في الجولة نفسها.' },
  { q: 'هل يمكن للزائر التسوق في قسم الجملة؟', a: 'يختلف ذلك بحسب المحل، فبعض المحال التجارية لا تستهدف البيع الفردي بينما بعضها يقبل. اسأل بلطف عن إمكانية الشراء بكميات صغيرة قبل التفاوض، واحترم طبيعة المكان إن كان موجهاً للتجار.' },
  { q: 'متى يكون السوق أقل ازدحاماً؟', a: 'الفترة الصباحية عادةً أهدأ من المساء، بينما يشهد المساء والعطلات والمناسبات ذروة الازدحام. لزيارة هادئة وللتصوير اختر الصباح، وللأجواء اختر المساء مع توقع الضغط في الأزقة.' },
  { q: 'كيف أرتب جولة تجمع السوق والميناء وسوق السمك؟', a: 'زُر سوق السمك عادةً في الصباح حين يكون نشاطه أعلى، ثم خصّص وقتاً لأزقة السوق قبل الظهيرة أو بعدها، واختم بجولة على الكورنيش والميناء. راجع صفحات البرامج لترتيب يوم كامل أو نصف يوم بحسب وقتك.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'ذكر أن السوق يضم عدداً كبيراً من المحال، ووصف ممراته وأسقفه الخشبية وسلعه وأعمال تطويره.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'وصف السوق كسوق عربي تقليدي ومقصد للزوار، وفترة الزيارة المناسبة (سبتمبر–مايو).' },
];

const related = [
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري', desc: 'فئات المنتجات وكيف تقارن الجودة.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'خلفية السوق وعلاقته بميناء مطرح.' },
  { href: '/souq/bargaining-payment/', label: 'المساومة والدفع', desc: 'آداب السعر ووسائل الدفع.' },
  { href: '/around/fish-market/', label: 'سوق السمك في مطرح', desc: 'نشاط الميناء والصباح قرب السوق.' },
];
---
<GuideLayout
  title="سوق الجملة والسوق التقليدي في مطرح: الفرق وما تتوقعه | دليل سوق مطرح"
  h1="سوق الجملة والسوق التقليدي في مطرح"
  description="دليل الفرق بين قسم الجملة والنشاط التجاري والقسم التقليدي الموجّه للزوار في سوق مطرح: من يرتاد كل قسم، وأوقات الازدحام، والعلاقة بالميناء وسوق السمك."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">مقارنة سريعة</p>
          <dl class="mt-3 space-y-3 text-sm text-[#66574e]">
            <div><dt class="font-bold text-[#18110d]">القسم التقليدي</dt><dd>تحف وهدايا وبخور وفضيات ونسيج موجّهة للزوار.</dd></div>
            <div><dt class="font-bold text-[#18110d]">قسم الجملة والنشاط التجاري</dt><dd>بضائع بالكميات لمن يبحث عن التزويد.</dd></div>
            <div><dt class="font-bold text-[#18110d]">القاسم المشترك</dt><dd>مسار واحد متصل، والحدود غير حادة.</dd></div>
          </dl>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> التوصيف هنا عام وليس تصنيفاً رسمياً لدرجات الأسعار. سلوك كل محل يختلف، فاسأل البائع قبل الشراء.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell">
      <p class="text-sm font-bold text-[#F6D98C]">أي قسم يناسبك؟</p>
      <h2 class="display mt-3 text-4xl font-black">اختر وجهتك داخل السوق بحسب هدفك</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">باحث عن هدية</h3>
          <p class="mt-2 text-[#d8eee9]">اتجه إلى أزقة القسم التقليدي حيث تتجمع التحف والبخور والمنسوجات والفضيات.</p>
        </article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">باحث عن كميات</h3>
          <p class="mt-2 text-[#d8eee9]">اسأل عن المحال التجارية التي تتعامل بالجملة، وحدّد الكمية والاستخدام مسبقاً.</p>
        </article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">زوّار أول مرة</h3>
          <p class="mt-2 text-[#d8eee9]">ابدأ من المدخل الرئيسي وجولة عامة، ثم عد إلى القسم الذي ناسبك للتسوق الفعلي.</p>
        </article>
      </div>
      <div class="mt-8 rounded-3xl border border-white/20 bg-black/20 p-5 text-sm text-[#d8eee9]">
        <b class="text-[#F6D98C]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="تتغير تركيبة المحال ونشاطها بمرور الوقت، ولا يوجد تصنيف رسمي معلن يقسم السوق إلى منطقتين بحدود ثابتة. تحقّق ميدانياً من طبيعة كل محل قبل الشراء أو التفاوض، خاصة في المحال الموجّهة للتجار." />
      </div>
    </div>
  </section>
</GuideLayout>
