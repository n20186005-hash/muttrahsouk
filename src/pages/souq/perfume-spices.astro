---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'العطور والتوابل' },
];

const quickFacts = [
  { label: 'العطور', value: 'زيوت عطرية ومباخر ومستحضرات عطرية متنوعة' },
  { label: 'التوابل', value: 'مزيج البهارات، الكركم، الليمون المجفف (اللومي)' },
  { label: 'منتجات عُمانية', value: 'التمر والحلوى العُمانية والقهوة العُمانية' },
  { label: 'للسفر', value: 'السوائل تحتاج تغليفاً محكماً؛ تحقق من قواعد الحمل' },
];

const sections = [
  {
    heading: 'العطور الزيتية والمباخر',
    body: [
      'تشتهر محال السوق بالعطور الزيتية والمباخر. بعض العطور زيوت خالصة وبعضها مخفّف أو مخلوط، لذلك اسأل صراحةً عن نوع الزيت ودرجة تركيزه وحجم العبوة. جرّب كمية صغيرة على الجلد وانتظر قليلاً لترى كيف تتغير الرائحة بعد ملامسة البشرة.',
      'أما المباخر فهي أوانٍ تُوضع فيها الجمرة لحرق البخور، وهي أدوات مرتبطة بالاستقبال والمناسبات في المنطقة. اسأل عن مادة المبخرة (خشب أو معدن أو غيره) وعن حجمها وطريقة تنظيفها، فهذه تفاصيل عملية تهمّ من ينوي استخدامها فعلاً.',
    ],
  },
  {
    heading: 'التوابل ومزيج البهارات واللومي',
    body: [
      'من أكثر ما يلفت الانتباه في السوق روائح التوابل المكدّسة. تشمل المعروضات الشائعة مزيج البهارات والكركم والفلفل والليمون المجفف المعروف محلياً باسم «اللومي». يمكنك سؤال البائع عن مكونات الخلطة وطزاجتها؛ فالبهارات تفقد قوتها مع الوقت.',
      'حين تشتري مزيجاً جاهزاً، اسأل عن مكوناته الأساسية لأن بعض الخلطات تختلف من منطقة إلى أخرى، ولأن مذاق الطبق يتغير بتغيّر الخلطة ذاتها. الطزاجة مؤشر مهم: ابحث عن رائحة قوية ونقاء لوني بلا شوائب، واشتر بكميات معتدلة إن كنت لن تستخدمها سريعاً.',
    ],
  },
  {
    heading: 'القهوة والتمر والحلوى العُمانية',
    body: [
      'الحلوى العُمانية حلوى تقليدية كثيفة تُصنع أساساً من السكر والنشا والسمن والهيل وماء الورد والزعفران، وتُضاف إليها غالباً مسكرات كاللوز والجوز. تُقدّم عادةً مع القهوة العُمانية والتمر، وهي من أبرز منتجات الهدايا التي يرتبط بها السوق.',
      'أما القهوة العُمانية فهي جزء من تقاليد الضيافة: يُقدَّم التمر والقهوة معاً في المجالس، ويكون التمر هو مصدر الحلاوة التي توازن مذاق القهوة. اسأل عند الشراء عن مكونات الحلوى ودرجة حلاوتها ووجود المكسرات، وعن تاريخ الإنتاج إن وُجد على العبوة.',
    ],
  },
  {
    heading: 'التغليف للسفر والحذر الجمركي',
    body: [
      'السوائل والزيوت العطرية وحبوب البخور كلها تحتاج لفاً محكماً قبل السفر لتجنب التسرب وتغيّر الرائحة. اطلب من البائع تغليفاً مناسباً للنقل، واحتفظ بالسوائل داخل كيس محكم في الحقيبة وفق قواعد السوائل المعتادة في الطيران.',
      'لا نتحقق في هذا الدليل من الرسوم أو القيود الجمركية على أي من هذه المنتجات، ولا من حدود الكميات المسموح بها. تحقّق من الجهات الجمركية الرسمية في بلدك وبلد الوجهة قبل السفر، خاصة مع المواد العطرية والنباتية، ولا تعتمد على هذه الصفحة كإرشاد جمركي.',
    ],
  },
];

const faq = [
  { q: 'ما الفرق بين الزيت العطري والدهن؟', a: 'التسميات تختلف بين الباعة ولا يوجد تعريف موحد مفروض. اسأل صراحةً عن درجة التركيز وهل المنتج خالص أم مخفّف أم مخلوط، وجرّب كمية صغيرة على الجلد قبل الشراء لتعرف ثبات الرائحة.' },
  { q: 'ما هو اللومي؟', a: 'اللومي هو الليمون المجفف المعروف في المطبخ المحلي والعماني، ويُستخدم لإضافة نكهة حمضية للأطباق. تجده مباعاً ضمن قسم التوابل، ويكون عادةً بلون بني فاتح أو داكن بحسب درجة التجفيف.' },
  { q: 'ما هي الحلوى العُمانية؟', a: 'حلوى تقليدية كثيفة تُصنع أساساً من السكر والنشا والسمن والهيل وماء الورد والزعفران، وتُضاف إليها غالباً مكسرات. تُقدَّم مع القهوة العُمانية والتمر، ويختلف مذاقها ودرجة حلاوتها بين المنتجين.' },
  { q: 'هل يمكن إدخال هذه المنتجات إلى بلدي؟', a: 'لا نتحقق من الرسوم الجمركية أو حدود الكميات المسموح بها، وقد تفرض بعض الدول قيوداً على المواد العطرية أو النباتية. راجع الجهات الجمركية الرسمية في بلد الوجهة قبل السفر.' },
];

const sources = [
  { label: 'الضيافة العُمانية: التمر والقهوة', org: 'عُمان اليوم (صحيفة عُمانية)', url: 'https://www.omandaily.om/print-article?articleId=1203787', desc: 'وصف تقاليد الضيافة العُمانية وارتباط التمر والقهوة العُمانية بالمجالس والمناسبات.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'الإشارة إلى العطور والتوابل ضمن ما يشتهر به السوق.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف السوق كمركز للبخور والعطور والتحف والهدايا.' },
];

const related = [
  { href: '/souq/frankincense/', label: 'اللبان والبخور', desc: 'الأنواع والدرجات وتجربة الشراء.' },
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري', desc: 'نظرة شاملة على فئات منتجات السوق.' },
  { href: '/souq/bargaining-payment/', label: 'المساومة والدفع', desc: 'آداب السعر ووسائل الدفع في السوق.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'خلفية السوق وتجارته التقليدية.' },
];
---
<GuideLayout
  title="العطور والتوابل في سوق مطرح: الزيوت والبهارات والحلوى | دليل سوق مطرح"
  h1="العطور والتوابل والحلوى العُمانية في سوق مطرح"
  description="دليل العطور والتوابل في سوق مطرح: الزيوت العطرية والمباخر، مزيج البهارات واللومي، القهوة العُمانية والحلوى والتمر والتغليف للسفر."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">نصائح سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">العطر:</b> جرّب على الجلد وانتظر قليلاً قبل القرار.</li>
            <li><b class="text-[#18110d]">التوابل:</b> اختر الرائحة القوية بلا شوائب.</li>
            <li><b class="text-[#18110d]">الحلوى:</b> اسأل عن المكونات ودرجة الحلاوة.</li>
            <li><b class="text-[#18110d]">السوائل:</b> اطلب تغليفاً محكماً للنقل.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> لا يقدّم هذا الدليل أسعاراً أو ماركات، ولا يُعدّ مرجعاً جمركياً. كل التفاصيل عن النقل والسفر تُراجع مع الجهات الرسمية.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell">
      <p class="text-sm font-bold text-[#F6D98C]">المنتجات الأكثر طلباً</p>
      <h2 class="display mt-3 text-4xl font-black">أربع فئات تربط الزائر بالمطبخ والبيت العُماني</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6"><h3 class="text-lg font-black text-[#F6D98C]">الزيوت العطرية</h3><p class="mt-2 text-[#d8eee9]">عطور متنوعة بدرجات تركيز متفاوتة؛ اسأل وجرّب.</p></article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6"><h3 class="text-lg font-black text-[#F6D98C]">المباخر</h3><p class="mt-2 text-[#d8eee9]">أدوات مرتبطة بالتقاليد والاستقبال؛ تنوّع في المادة والحجم.</p></article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6"><h3 class="text-lg font-black text-[#F6D98C]">التوابل واللومي</h3><p class="mt-2 text-[#d8eee9]">بهارات ومزيج وليمون مجفف؛ الطزاجة هي المعيار.</p></article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6"><h3 class="text-lg font-black text-[#F6D98C]">القهوة والحلوى والتمر</h3><p class="mt-2 text-[#d8eee9]">تراث ضيافة عُماني يمكن أن يصبح هدية.</p></article>
      </div>
      <div class="mt-8 rounded-3xl border border-white/20 bg-black/20 p-5 text-sm text-[#d8eee9]">
        <b class="text-[#F6D98C]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="تتفاوت جودة المنتجات والخلطات والأسعار بين المحال والمواسم. تحقّق ميدانياً بالمشاهدة والسؤال، وأي مسألة عن الرسوم الجمركية أو الحدود المسموح بها عند السفر تُراجع مع الجهات الرسمية في بلد الوجهة." />
      </div>
    </div>
  </section>
</GuideLayout>
