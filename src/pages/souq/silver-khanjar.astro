---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'الفضة والخناجر' },
];

const quickFacts = [
  { label: 'المكانة الثقافية', value: 'أُدرجت حرفة الخنجر في قائمة اليونسكو للتراث غير المادي عام 2022' },
  { label: 'المكوّنات العامة', value: 'حزام، مقبض، نصل، غمد وغطاء — من خشب وجلد وقماش وفضة' },
  { label: 'ما تسأل عنه', value: 'نوع المعدن والوزن ومصدر الصناعة' },
  { label: 'السفر', value: 'قواعد حمل القطع أو تصديرها تحتاج تحققاً رسمياً' },
];

const sections = [
  {
    heading: 'الخنجر العُماني: قطعة تراثية لا مجرد سكين',
    body: [
      'الخنجر العُماني (الخنجر) جزء من الزي التقليدي للرجل في عُمان، ويُلبس في المناسبات الوطنية والدينية والأعراس. وتصف اليونسكو صناعته بأنها تتطلب معرفة ومهارات تُنقل من جيل إلى جيل، وقد أُدرجت الحرفة في قائمة التراث الثقافي غير المادي عام 2022.',
      'ويشير المصدر نفسه إلى أن الخنجر يُثبَّت حول الخصر ويشمل حزاماً ومقبضاً ونصلاً وغمداً وغطاءً، مصنوعة من مواد متنوعة مثل الخشب والجلد والقماش والفضة. كما أنه جزء من شعار الدولة ويظهر في كثير من العادات والمناسبات.',
    ],
  },
  {
    heading: 'المكوّنات العامة التي تراها في المحال',
    body: [
      'عند النظر إلى خنجر معروض للبيع، يمكنك ملاحظة أجزاء رئيسية: النصل المعدني المنحني، والمقبض الذي قد يُصنع من مواد مثل الخشب أو القرن، والغمد الذي يُزيّن غالباً بالفضة، إضافة إلى الحزام الذي يثبّته حول الخصر.',
      'هذه تسميات عامة وصفية، أما تفاصيل الزخارف والأسلاك الفضية وأنواع المطارق فمتخصصة وتختلف بين صنّاع. لا تدّعي هذه الصفحة أن هناك مقياساً واحداً متفقاً عليه يحدد «أصالة» كل قطعة؛ فالمعيار الأهم هو ما يصرّح به البائع عن المادة والوزن.',
    ],
  },
  {
    heading: 'الفرق بين القطع الفضية والمقلّدة',
    body: [
      'تتنوع الخناجر والقطع الفضية المعروضة بين ما هو مصنوع يدوياً بكميات محدودة وما هو منسوخ لأغراض الديكور والهدايا. الفرق يظهر في الوزن وعناية التفاصيل وأحياناً في طريقة التثبيت والزخرفة.',
      'أفضل ما يمكنك فعله: اسأل صراحةً عن نوع المعدن (فضة أم معدن آخر مطلي)، وعن الوزن التقريبي بالجرام، وعن كون القطعة مصنوعة يدوياً بالكامل أم لا. اطلب وزن القطعة أمامك إن أمكن، وقارن بين أكثر من محل قبل الشراء.',
    ],
  },
  {
    heading: 'الحرف اليدوية والعناية والتنظيف',
    body: [
      'تُصنع الخناجر والقطع الفضية عبر حرف متوارثة تركز على تشكيل المعدن والزخرفة والنقش. لمشاهدة هذه الحرفة عن قرب، تُعدّ أسواق الحرفيين ومحال الصناعة في عُمان وجهات معروفة، أما داخل سوق مطرح فتجد المعروض الجاهز بدرجات متفاوتة من الإتقان.',
      'للعناية بالفضة، امنع ملامستها المستمرة للرطوبة والمواد الكيميائية واحفظها في كيس أو علبة جافة. عند التنظيف استخدم قطعة قماش ناعمة مخصصة للفضة وتجنّب المواد الكاشطة التي قد تكشط النقش، واستشر البائع عن أفضل طريقة لتنظيف قطعتك تحديداً.',
    ],
  },
];

const faq = [
  { q: 'ما الذي يميز الخنجر العُماني عن غيره؟', a: 'الخنجر العُماني قطعة من الزي التقليدي ويُلبس في المناسبات الوطنية والدينية والأعراس، وصناعته تراث غير مادي مُدرج لدى اليونسكو عام 2022. يتميز بمجموعة أجزاء معتادة تشمل الحزام والمقبض والنصل والغمد والغطاء.' },
  { q: 'كيف أفرّق بين الفضة الحقيقية والمقلّدة؟', a: 'اسأل البائع عن نوع المعدن والوزن، واطلب وزن القطعة أمامك. لا يوجد اختبار بسيط مضمون داخل السوق، لذلك قارن بين أكثر من محل وتجنّب الاعتماد على وعود شفهية غير موثقة.' },
  { q: 'كيف أحافظ على الخنجر أو الفضة بعد الشراء؟', a: 'احفظها في مكان جاف بعيداً عن الرطوبة والمواد الكيميائية، ونظّفها بقطعة قماش ناعمة مخصصة للفضة. تجنّب المواد الكاشطة التي تخدش النقوش، واسأل البائع عن الطريقة الأمثل لقطعتك.' },
  { q: 'هل يمكن إخراج الخنجر من عُمان أو حمله على الطائرة؟', a: 'لم نتحقق في هذا الدليل من قواعد حمل أو تصدير الخناجر والقطع الفضية. القطع ذات النصل قد تكون خاضعة لقيود النقل، والتصدير قد يتطلب إجراءات رسمية؛ راجع شركة الطيران والجهات الرسمية المختصة قبل الشراء للسفر.' },
];

const sources = [
  { label: 'الخنجر — المهارات الحرفية والممارسات الاجتماعية', org: 'اليونسكو — التراث غير المادي (رسمي)', url: 'https://ich.unesco.org/en/RL/al-khanjar-craft-skills-and-social-practices-01844', desc: 'توثيق حرفة الخنجر العُماني وأجزائه العامة (الحزام، المقبض، النصل، الغمد، الغطاء) ومواده، وإدراج الحرفة على القائمة الدولية للتراث غير المادي.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'الإشارة إلى الفضيات والحرف ضمن ما يعرضه السوق.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف السلع المعروضة ومنها التحف والفضيات والهدايا داخل أزقة السوق.' },
];

const related = [
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري', desc: 'فئات المنتجات وما تسأل عنه في كل فئة.' },
  { href: '/souq/frankincense/', label: 'اللبان والبخور', desc: 'الأنواع والدرجات وتجربة الشراء.' },
  { href: '/souq/bargaining-payment/', label: 'المساومة والدفع', desc: 'آداب السعر ووسائل الدفع.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'خلفية السوق وحرفه التقليدية.' },
];
---
<GuideLayout
  title="الفضة والخناجر العُمانية في سوق مطرح: دليل الشراء والعناية | دليل سوق مطرح"
  h1="الفضة والخنجر العُماني في سوق مطرح"
  description="دليل الفضة والخناجر في سوق مطرح: مكانة الخنجر العُماني الثقافية ومكوّناته، والفرق بين القطع الفضية والمقلّدة، والعناية والتنظيف، وتحقق قواعد السفر."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">المكوّنات العامة للخنجر</p>
          <dl class="mt-3 space-y-3 text-sm text-[#66574e]">
            <div><dt class="font-bold text-[#18110d]">النصل</dt><dd>الجزء المعدني المنحني.</dd></div>
            <div><dt class="font-bold text-[#18110d]">المقبض</dt><dd>قد يُصنع من الخشب أو القرن أو مواد أخرى.</dd></div>
            <div><dt class="font-bold text-[#18110d]">الغمد والغطاء</dt><dd>يُزيّنان غالباً بالفضة والزخارف.</dd></div>
            <div><dt class="font-bold text-[#18110d]">الحزام</dt><dd>يثبّت الخنجر حول الخصر.</dd></div>
          </dl>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> هذه الصفحة وصفية ولا تروّج لمحل بعينه ولا تثبت أسعاراً. الأوصاف أعلاه عامة وفق المصدر الرسمي، أما التفاصيل الدقيقة فتختلف بين الصنّاع.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">قبل أن تشتري</p>
      <h2 class="display mt-3 text-4xl font-black">أسئلة تطرحها على البائع</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card rounded-3xl p-5"><h3 class="text-lg font-black text-[#18110d]">المادة</h3><p class="mt-2 text-sm text-[#66574e]">فضة أم معدن آخر مطلي؟ اطلب تصريحاً واضحاً.</p></div>
        <div class="card rounded-3xl p-5"><h3 class="text-lg font-black text-[#18110d]">الوزن</h3><p class="mt-2 text-sm text-[#66574e]">الوزن بالجرام مؤشر مهم على قيمة القطعة.</p></div>
        <div class="card rounded-3xl p-5"><h3 class="text-lg font-black text-[#18110d]">طريقة الصناعة</h3><p class="mt-2 text-sm text-[#66574e]">يدوية بالكامل أم منسوخة لأغراض الديكور؟</p></div>
        <div class="card rounded-3xl p-5"><h3 class="text-lg font-black text-[#18110d]">السفر</h3><p class="mt-2 text-sm text-[#66574e]">هل هناك قيود على حمل القطعة أو تصديرها؟</p></div>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="لم نتحقق من أي متطلبات رسمية لتصدير الخناجر أو القطع الفضية أو حملها في السفر. القطع ذات النصل قد تخضع لقيود النقل، لذلك راجع شركة الطيران والجهات الرسمية قبل الشراء بقصد السفر، وتحقّق ميدانياً من المادة والوزن." />
      </div>
    </div>
  </section>
</GuideLayout>
