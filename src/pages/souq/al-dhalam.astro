---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'لماذا سوق الظلام؟' },
];

const quickFacts = [
  { label: 'أصل الاسم', value: 'وصفي لا يعني الإغلاق' },
  { label: 'النطاق المذكور', value: 'من مسجد الرسول الأعظم إلى خور بمبة' },
  { label: 'السبب', value: 'الأزقة المسقوفة تحجب ضوء النهار' },
  { label: 'تجربة النهار', value: 'ظل وبرودة نسبية داخل الأزقة' },
];

const sections = [
  {
    heading: 'الاسم وصف لحالة الضوء… لا للإغلاق',
    body: [
      'أكثر ما يثير فضول الزائر هو اسم «سوق الظلام». رغم ما قد يوحيه الاسم، فهو وصف لحالة الإضاءة داخل جزء من السوق، وليس إشارة إلى أن السوق مغلق أو مظلم تماماً أو مهجور.',
      'فالسوق يعمل نهاراً وليلاً، والاسم يعكس ببساطة انخفاض ضوء الشمس في ممراته المسقوفة، وهو ما يشعر به الزائر فعلاً عند دخوله: انتقال من ضوء النهار الساطع إلى ظل هادئ بين الجدران.',
    ],
  },
  {
    heading: 'النطاق الجغرافي للاسم وفق بلدية مسقط',
    body: [
      'تذكر بلدية مسقط تسمية السوق بـ«سوق الظلام»، وتوضح أن هذه التسمية تُطلق على الجزء الممتد من مسجد الرسول الأعظم إلى خور بمبة، وهو البوابة المعروفة للمدخل الرئيسي للسوق من جهة البحر.',
      'هذا التحديد مهم لأنه يبيّن أن الاسم لا يصف السوق كله بالتساوي، بل يرتبط بمنطقة معينة من الممرات المسقوفة القريبة من المدخل البحري.',
    ],
  },
  {
    heading: 'لماذا تحجب الأزقة ضوء النهار',
    body: [
      'تشرح البلدية أن السبب في التسمية يعود إلى كثرة الأزقة والسكك على عتبات المتاجر، بحيث تحجب هذه الأزقة أشعة الشمس خلال فترة النهار. بعبارة أخرى: التصميم المتلاصق والممرات المسقوفة تمنع وصول الضوء المباشر إلى الداخل.',
      'هذا الأثر العمراني مقصود بطبيعته في الأسواق التقليدية: الظل يخفّف الحرارة ويجعل التجوّل ممكناً نهاراً. لذلك فإن «الظلام» هنا ليس عيباً، بل نتيجة منطقية لتصميم يخدم راحة المترددين.',
    ],
  },
  {
    heading: 'تجربة النهار مقابل تجربة المساء',
    body: [
      'في النهار تدخل إلى ظل نسبي، فتنتقل عينك من الوهج الخارجي إلى هدوء داخلي، وتظهر تفاصيل الأسقف الخشبية والألوان بعينٍ متكيّفة على الضوء الخفيف. هذه هي التجربة التي جعلت للاسم معناه.',
      'في المساء يتغيّر المشهد: تُشعل الإضاءة الداخلية، ويبدو السوق أكثر ألواناً وحركة، ويصبح التباين مع ظلمة الليل الخارجي أقل حدة. لذلك من زار السوق نهاراً فقط لم يعرف وجهه الليلي، والعكس صحيح.',
    ],
  },
  {
    heading: 'تنبيه: لا تخلط بين الاسم والواقع',
    body: [
      'من الأخطاء الشائعة أن يُفهم «سوق الظلام» على أنه مكان مظلم لا يصلح للزيارة، أو أنه سوق منفصل عن سوق مطرح. الحقيقة أن الاسم مرتبط بسوق مطرح نفسه، ويصف خصوصية الإضاءة في جزء منه.',
      'لذلك لا تتردد في الزيارة نهاراً؛ فالظل هو الميزة، والإضاءة المسائية تضيء الممرات الرئيسية. كل ما تحتاجه هو تكييف نظرك لدقائق عند الدخول والخروج.',
    ],
  },
];

const faq = [
  { q: 'لماذا يُسمى سوق مطرح سوق الظلام؟', a: 'بحسب بلدية مسقط، يعود الاسم إلى كثرة الأزقة والسكك على عتبات المتاجر التي تحجب أشعة الشمس خلال النهار، وتُطلق التسمية على الجزء الممتد من مسجد الرسول الأعظم إلى خور بمبة.' },
  { q: 'هل يعني الاسم أن السوق مغلق أو مظلم؟', a: 'لا؛ الاسم وصفي لحالة الإضاءة داخل الممرات المسقوفة، ولا يعني إغلاق السوق. السوق يعمل نهاراً وليلاً، والإضاءة الداخلية تعمل مساءً.' },
  { q: 'هل سوق الظلام مكان منفصل عن سوق مطرح؟', a: 'لا، هو اسم يُطلق على جزء من سوق مطرح نفسه، لا سوق منفصل عنه.' },
  { q: 'هل الزيارة نهاراً مجدية؟', a: 'نعم؛ الظل داخل الأزقة يخفّف الحرارة ويجعل التجوّل ممكناً نهاراً، وتظهر تفاصيل الأسقف الخشبية بوضوح.' },
  { q: 'ما أفضل وقت لتجربة الاسم على حقيقته؟', a: 'النهار يمنحك الإحساس الفعلي بتباين الضوء بين الخارج والداخل، والمساء يمنحك تجربة الإضاءة الداخلية. جرّب الاثنين إن أمكن.' },
];

const sources = [
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'يوضح تسمية «سوق الظلام» ونطاقها الجغرافي وسببها المرتبط بالأزقة المسقوفة.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'وصف رسمي للسوق كممرات مسقوفة تقليدية في مطرح.' },
];

const related = [
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'نشأة السوق وعلاقته بميناء مطرح.' },
  { href: '/souq/architecture/', label: 'عمارة سوق مطرح التقليدية', desc: 'كيف تصنع الممرات المسقوفة الظل داخل السوق.' },
  { href: '/visit/opening-hours/', label: 'أوقات عمل سوق مطرح', desc: 'ساعات النهار والمساء التي تناسب كل تجربة.' },
  { href: '/souq/photography-etiquette/', label: 'التصوير وآداب الزيارة', desc: 'أفضل إضاءة للتصوير داخل الممرات المسقوفة.' },
];
---
<GuideLayout
  title="لماذا يسمى سوق مطرح «سوق الظلام»؟ تفسير الاسم | دليل سوق مطرح"
  h1="لماذا يسمى سوق الظلام؟"
  description="سبب تسمية سوق مطرح بـ«سوق الظلام» وفق وصف بلدية مسقط: الأزقة المسقوفة التي تحجب ضوء النهار بين مسجد الرسول الأعظم وخور بمبة، ومقارنة النهار والمساء."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell">
      <p class="kicker">تفسير الاسم</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">الاسم يصف الظل… لا الظلام</h2>
      <div class="mt-6 max-w-3xl space-y-4 text-[#58483e]">
        <p><BidiText text="يبدو اسم «سوق الظلام» مقلقاً لمن يسمعه أول مرة، لكنه في الحقيقة وصف بسيط لخصوصية الإضاءة داخل ممرات السوق المسقوفة. فهم الاسم يفتح لك باباً لتقدير عبقرية تصميم السوق التقليدي قبل أن تدخله." /></p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">ما يعنيه الاسم</b>
          <ul class="mt-3 list-disc space-y-2 pr-5 text-sm text-[#66574e]">
            <li>وصف لحالة الإضاءة داخل الأزقة المسقوفة.</li>
            <li>مرتبط بجزء من السوق من مسجد الرسول الأعظم إلى خور بمبة.</li>
            <li>نتيجة طبيعية لتصميم يحجب ضوء الشمس نهاراً.</li>
          </ul>
        </div>
        <div class="card rounded-3xl p-6">
          <b class="block text-lg font-black text-[#176b68]">ما لا يعنيه الاسم</b>
          <ul class="mt-3 list-disc space-y-2 pr-5 text-sm text-[#66574e]">
            <li>لا يعني أن السوق مغلق أو مهجور.</li>
            <li>لا يعني أنه سوق منفصل عن سوق مطرح.</li>
            <li>لا يعني أن الزيارة نهاراً غير ممكنة.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-10">
        {sections.slice(1).map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">ملخص في سطرين</p>
          <p class="mt-3 text-sm text-[#66574e]">الأزقة الضيقة والمسقوفة تحجب ضوء النهار، فيبدو الداخل أهدأ وأكثر ظلاً من الخارج؛ ومن هنا جاء اسم «سوق الظلام». أما مساءً فتغيّر الإضاءة الداخلية المشهد بالكامل.</p>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تحقق (<BidiText text="2 نوفمبر 2026" />):</b> تفسير الاسم وحدود نطاقه مأخوذ من وصف بلدية مسقط. قد تتباين الروايات الشفهية غير الرسمية؛ اعتمدنا هنا على المصدر البلدي الرسمي فقط.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
