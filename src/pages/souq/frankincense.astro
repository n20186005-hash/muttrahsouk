---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'اللبان والبخور' },
];

const quickFacts = [
  { label: 'المنشأ الشهير', value: 'محافظة ظفار جنوب سلطنة عُمان' },
  { label: 'درجات تجارية شائعة', value: 'الحوجري، النجدي، الشزري، الشعبي' },
  { label: 'الفرق الأساسي', value: 'اللبان راتنج طبيعي؛ البخور قد يكون مركّباً بمواد إضافية' },
  { label: 'قبل الشراء', value: 'اسأل عن المنشأ وجرّب رائحة كمية صغيرة' },
];

const sections = [
  {
    heading: 'ما هو اللبان العُماني؟',
    body: [
      'اللبان راتنج طبيعي يُستخرج من أشجار تنمو في جنوب عُمان، وتحديداً في جبال محافظة ظفار. واسم النوع الشائع في المنطقة هو Boswellia sacra حسب توصيف الدراسات العلمية، وهو أحد أشهر ما يرتبط بسمعة عُمان التجارية عبر «طريق اللبان» التاريخي.',
      'يرتبط محصول اللبان في عُمان بمكانة ثقافية واضحة، إذ تُدرج «أرض اللبان» في قائمة التراث العالمي لليونسكو، ما يعكس أهمية هذه التجارة في تاريخ المنطقة وعلاقتها بالموانئ والواحات القديمة.',
    ],
  },
  {
    heading: 'الدرجات والأنواع: كيف تقرأ التسميات؟',
    body: [
      'تتداول تجارة اللبان أسماء درجات متعددة، ومن أشهرها الحوجري والنجدي والشزري والشعبي. تصف الدراسات العلمية الحديثة هذه التسميات بأنها تعكس مناطق نمو مختلفة وظروفاً بيئية متباينة، وهو ما ينعكس على اللون والحجم وسلوك الاحتراق.',
      'مع ذلك، تبقى أي ادعاءات عن «الأفضل» أو «الأندر» اجتهاداً تجارياً متفاوتاً بين الباعة، ولا يوجد في المصادر التي راجعناها معيار مطلق متفق عليه لكل الأسواق. لذلك تعامل مع التسميات كدليل إرشادي لا كتصنيف حاسم، وقارن الرائحة واللون والحجم بنفسك.',
    ],
  },
  {
    heading: 'الفرق بين اللبان والبخور المركّب',
    body: [
      'اللبان غالباً يُباع في صورته الأولية كمادة صمغية شفافة أو شبه شفافة بأحجام مختلفة، ويُحرق وحده للاستمتاع برائحته الأصلية. أما البخور المركّب فقد يخلط فيه البائع راتنج اللبان أو غيره مع مواد عطرية أخرى وزيوت، ما يغيّر الرائحة ومدة الاحتراق.',
      'إذا كنت تبحث عن الرائحة الطبيعية الخالصة فاسأل صراحةً عن لبان غير مركّب، وإذا كانت الروائح المخلوطة هي المقصودة فاسأل عن مكوّنات الخلطة وعن سرعة احتراقها.',
    ],
  },
  {
    heading: 'الروائح والتخزين وتجربة الشراء',
    body: [
      'اللبان مادة حساسة للرطوبة والحرارة، ولذلك يُفضّل تخزينه بعيداً عن الرطوبة في وعاء محكم الإغلاق. اسأل البائع عن أفضل طريقة للتعامل مع الدرجة التي تشتريها، خصوصاً إن كنت ستنقلها إلى مناخ مختلف.',
      'جرّب دائماً رائحة كمية صغيرة قبل الشراء: لاحظ شدة الرائحة وسرعة ظهورها ونقاءها من العُقد الغريبة. واطلب أن تفحص الحبات يدوياً للتأكد من عدم وجود شوائب، ثم قارن بين أكثر من محل قبل أن تقرر.',
    ],
  },
];

const faq = [
  { q: 'ما الفرق بين اللبان والبخور المركّب؟', a: 'اللبان في الأصل راتنج طبيعي يُحرق وحده برائحته الأصلية، أما البخور المركّب فقد تُضاف إليه زيوت ومواد عطرية إضافية تغيّر الرائحة ومدة الاحتراق. اسأل البائع عن نوع المنتج بدقة.' },
  { q: 'هل «الحوجري» هو الأفضل دائماً؟', a: 'يُتداول الحوجري على أنه درجة راقية، لكن الدراسات تشير إلى اختلاف التسميات بحسب منطقة النمو والظروف البيئية. لا يوجد معيار مطلق متفق عليه لكل الأسواق، لذلك قارن الخصائص بنفسك ولا تعتمد على الاسم وحده.' },
  { q: 'كيف أختبر اللبان قبل الشراء؟', a: 'اطلب حرقه على كمية صغيرة ولاحظ شدة الرائحة وسرعة ظهورها ونقاءها، وافحص الحبات بحثاً عن الشوائب أو العُقد. هذا هو الفحص الأفضل المتاح داخل السوق، مع مقارنة أكثر من عيّنة.' },
  { q: 'هل يمكن إخراج اللبان من عُمان بحرية؟', a: 'لم نتحقق في هذا الدليل من قواعد تصدير اللبان وأشتاله الحيّة أو تصاريح الجمع. تشير إحدى الوثائق المنشورة أن أنواع البخور لم تكن مدرجة في قوائم اتفاقية التجارة الدولية وقت إعدادها، لكن الأنظمة الوطنية قد تفرض ضوابط؛ راجع الجهات الرسمية المختصة قبل السفر.' },
];

const sources = [
  { label: 'دراسة علمية محكّمة: توصيف درجات اللبان في عُمان', org: 'دورية علمية محكّمة', url: 'https://www.frontiersin.org/journals/sustainable-food-systems/articles/10.3389/fsufs.2026.1785309/full', desc: 'تصنيف درجات اللبان العُماني (الحوجري، النجدي، الشزري، الشعبي) واختلاف مناطق النمو والخصائص.' },
  { label: 'أرض اللبان — التراث العالمي', org: 'اليونسكو', url: 'https://whc.unesco.org/en/list/1010', desc: 'إدراج «أرض اللبان» في قائمة التراث العالمي، وتجارة اللبان التاريخية ومرافئها.' },
  { label: 'منظمة التجارة الدولية للأحياء — تقرير عن أنواع البخور', org: 'اتفاقية التجارة الدولية (وثيقة منشورة)', url: 'https://cites.org/sites/default/files/documents/E-CoP19-Inf-10-R1.pdf', desc: 'نقطة مرجعية تفيد أن أنواع اللبان لم تكن مدرجة في قوائم اتفاقية التجارة الدولية وقت التقرير؛ الضوابط الوطنية تبقى ذات أثر.' },
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'الإشارة إلى اللبان والبخور ضمن ما يشتهر به السوق.' },
];

const related = [
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري', desc: 'نظرة شاملة على فئات منتجات السوق.' },
  { href: '/souq/perfume-spices/', label: 'العطور والتوابل', desc: 'الزيوت العطرية والبهارات والحلوى العُمانية.' },
  { href: '/souq/wholesale-vs-main/', label: 'سوق الجملة والسوق التقليدي', desc: 'الفرق بين قسمي السوق ومن يرتادهما.' },
  { href: '/souq/history/', label: 'تاريخ سوق مطرح', desc: 'خلفية السوق وعلاقته بميناء مطرح.' },
];
---
<GuideLayout
  title="اللبان والبخور في سوق مطرح: الأنواع والدرجات والشراء | دليل سوق مطرح"
  h1="اللبان والبخور العُماني في سوق مطرح"
  description="دليل اللبان والبخور في سوق مطرح: المنشأ الظفارِي، الدرجات التجارية الشائعة، الفرق بين اللبان والبخور المركّب، والروائح والتخزين وتجربة الشراء."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة فحص قبل الدفع</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">المنشأ:</b> اسأل عن منطقة الجمع أو التصنيع.</li>
            <li><b class="text-[#18110d]">النوع:</b> لبان خالص أم بخور مركّب؟</li>
            <li><b class="text-[#18110d]">اللون والحجم:</b> لاحظ الشفافية وحجم الحبات.</li>
            <li><b class="text-[#18110d]">التخزين:</b> اطلب نصيحة التخزين للنقل.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> لا يقدّم هذا الدليل أسعاراً أو ماركات، ولا يؤكد تصنيفاً معيارياً واحداً للجودة. كل ادعاء تجاري يُقرأ بحذر ويُتحقق منه ميدانياً.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#176b68] py-16 text-white">
    <div class="shell">
      <p class="text-sm font-bold text-[#F6D98C]">أرض اللبان</p>
      <h2 class="display mt-3 text-4xl font-black">لماذا ارتبط اللبان بعُمان؟</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">محصول الجنوب</h3>
          <p class="mt-2 text-[#d8eee9]">تتركز أشجار اللبان في جبال ظفار جنوب عُمان، وهي البيئة الطبيعية الأشهر لإنتاجه.</p>
        </article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">طريق تجاري قديم</h3>
          <p class="mt-2 text-[#d8eee9]">ارتبط اللبان بطرق تجارية قديمة ربطت موانئ المنطقة بالعالم، وهو ما تعكسه مواقع «أرض اللبان».</p>
        </article>
        <article class="rounded-3xl border border-white/15 bg-black/20 p-6">
          <h3 class="text-lg font-black text-[#F6D98C]">حضور في المناسبات</h3>
          <p class="mt-2 text-[#d8eee9]">يُستخدم اللبان والبخور في العطور والاستقبال والمناسبات، ما يجعله هدية شائعة من عُمان.</p>
        </article>
      </div>
      <div class="mt-8 rounded-3xl border border-white/20 bg-black/20 p-5 text-sm text-[#d8eee9]">
        <b class="text-[#F6D98C]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="الدرجات والأسعار والادعاءات التجارية عن الجودة تتغير بحسب المحل والموسم. تحقّق ميدانياً بالفحص والسؤال، وأي مسألة عن جمع النباتات الحيّة أو تصديرها تُراجع مع الجهات الرسمية المختصة." />
      </div>
    </div>
  </section>
</GuideLayout>
