---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'المساومة والدفع' },
];

const quickFacts = [
  { label: 'العملة', value: 'الريال العُماني' },
  { label: 'النقد', value: 'مفيد للمبالغ الصغيرة؛ احمل فكّة' },
  { label: 'البطاقات', value: 'تتفاوت بين المحال؛ اسأل قبل الشراء' },
  { label: 'الصرافات', value: 'تتوفر عموماً قرب المناطق التجارية؛ تحقق من الأقرب' },
];

const sections = [
  {
    heading: 'آداب المساومة الهادئة والمحترمة',
    body: [
      'المساومة جزء معتاد من التسوق في الأسواق التقليدية، لكنها في عُمان تبقى في إطار اللطف والاحترام. ابدأ بسؤال هادئ عن السعر، وأبدِ اهتمامك الحقيقي بالمنتج، ثم اقترح سعراً معقولاً بدل رفض العرض بحدّة.',
      'لا يوجد سعر قياسي معلن لكل فئة، وقد يختلف العرض بين محل وآخر؛ لذلك من المفيد أن تتعرف على المجال السعري التقريبي قبل الشراء بمقارنة أكثر من عرض. الأمور التي لا تُساوَم عليها عادةً كالأسعار المعلنة أو الخدمات المحددة تُحترم كما هي.',
    ],
  },
  {
    heading: 'النقد بالريال العُماني',
    body: [
      'الريال العُماني هو العملة المتداولة، وحمل قدر من النقد مفيد للمشتريات الصغيرة التي قد لا تُقبل فيها البطاقة. وحّد المبالغ الصغيرة والفكّة لديك قبل الدخول لتسهيل الدفع ودعم المفاصلة بمرونة.',
      'لم نتحقق في هذا الدليل من وجود رسوم أو حد أدنى للدفع بالبطاقة في أي محل، ولا من سياسات الاسترجاع. اسأل بوضوح عن أي رسم إضافي قبل إتمام العملية، ولا تفترض أن السعر المعلن نهائي بالضرورة.',
    ],
  },
  {
    heading: 'البطاقات والدفع الإلكتروني',
    body: [
      'تقبل بعض المحال البطاقات بينما يعتمد غيرها على النقد فقط، وقد تكون الحدود الدنيا للدفع بالبطاقة متفاوتة. الأفضل دائماً سؤال البائع عن وسيلة الدفع قبل أن تبدأ التفاوض أو الاختيار، لتجنب أي مفاجأة عند المحاسبة.',
      'في المواسم المزدحمة قد يكون الدفع النقدي أسرع، بينما تكون البطاقة أنسب للمبالغ الكبيرة إن قُبلت. اعرف سلفاً أي وسيلة تريد استخدامها، وتأكد من أن جهاز الدفع يعمل قبل الاعتماد على البطاقة.',
    ],
  },
  {
    heading: 'الصرافات واحترام العاملين والخصوصية',
    body: [
      'تتوفر أجهزة الصراف الآلي عموماً في المناطق التجارية القريبة، لكن مواقعها وأوقات عملها قد تتغير، لذا تحقّق من أقرب صراف قبل أن تنفد نقودك. لا تفترض أن كل صراف يقبل بطاقتك أو يعمل في كل الأوقات.',
      'أخيراً، احترم العاملين في المحال: لا تصوّرهم دون إذن، ولا تُلحّ في المساومة بعد أن يرفض البائع، وتجنّب رفع الصوت أو المقارنة العلنية بين المحال. التسوق المهذّب يجعل التجربة ألطف للطرفين ويسهّل الحصول على معلومات صادقة عن الجودة.',
    ],
  },
];

const faq = [
  { q: 'هل الأسعار ثابتة أم قابلة للمساومة؟', a: 'تتفاوت؛ بعض المحال تعلن أسعاراً محددة وبعضها يقبل التفاوض، ولا يوجد سعر قياسي موحّد لكل فئة. قارن أكثر من عرض قبل الشراء، وساوِم بهدوء واحترام دون إلحاح.' },
  { q: 'هل تقبل المحال البطاقات؟', a: 'تتفاوت القبول من محل إلى آخر وقد تكون هناك حدود دنيا للدفع بالبطاقة. اسأل عن وسيلة الدفع قبل بدء التفاوض، واحتفظ بقدر من الريال العُماني للمبالغ الصغيرة.' },
  { q: 'أين أجد صرافاً آلياً قريباً؟', a: 'تتوفر الصرافات عموماً في المناطق التجارية القريبة، لكن المواقع والأوقات تتغير. تحقّق من أقرب جهاز عبر تطبيق مصرفك أو الخريطة قبل أن ينفد نقدك، وتأكد من قبوله لنوع بطاقتك.' },
  { q: 'كيف أساوم بطريقة مناسبة؟', a: 'ابدأ بسؤال هادئ عن السعر واقترح رقماً معقولاً بعد إبداء اهتمامك الحقيقي، وتقبّل الرفض دون إلحاح. تجنّب رفع الصوت أو المقارنة العلنية بين المحال، واحترم الأسعار المعلنة والخدمات المحددة.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق السوق كسوق عربي تقليدي ينبغي التعامل فيه بالعادات المحلية.' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف النشاط التجاري للسوق وعدد المحال، ما يوضح تنوع التعامل بين الباعة.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع والإحداثيات؛ راجع أحدث نسخة قبل الانطلاق، وهي لقطة مستخدمين وليست تقييماً جمعه هذا الدليل.' },
];

const related = [
  { href: '/souq/what-to-buy/', label: 'ماذا تشتري', desc: 'فئات المنتجات وما تسأل عنه في كل فئة.' },
  { href: '/souq/wholesale-vs-main/', label: 'سوق الجملة والسوق التقليدي', desc: 'الفرق بين قسمي السوق ومن يرتادهما.' },
  { href: '/souq/frankincense/', label: 'اللبان والبخور', desc: 'الأنواع والدرجات وتجربة الشراء.' },
  { href: '/souq/perfume-spices/', label: 'العطور والتوابل', desc: 'الزيوت العطرية والبهارات والحلوى العُمانية.' },
];
---
<GuideLayout
  title="المساومة والدفع في سوق مطرح: نقداً أم بالبطاقة؟ | دليل سوق مطرح"
  h1="المساومة والدفع في سوق مطرح"
  description="دليل المساومة والدفع في سوق مطرح: آداب التفاوض الهادئ، النقد بالريال العُماني، تفاوت قبول البطاقات، الصرافات، واحترام العاملين والخصوصية."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قبل التفاوض</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li><b class="text-[#18110d]">اعرف:</b> المجال السعري التقريبي للفئة.</li>
            <li><b class="text-[#18110d]">اسأل:</b> عن وسيلة الدفع أولاً.</li>
            <li><b class="text-[#18110d]">احتفظ:</b> بفكّة ومبالغ صغيرة.</li>
            <li><b class="text-[#18110d]">احترم:</b> العاملين والأسعار المعلنة.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> لا يقدّم هذا الدليل أسعاراً ولا ماركات ولا يضمن قبول أي وسيلة دفع في محل بعينه. كل التفاصيل المالية تُتحقق ميدانياً.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">وسائل الدفع</p>
      <h2 class="display mt-3 text-4xl font-black">ما الذي تتوقعه عند المحاسبة؟</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#176b68] text-white">
              <th class="p-4 font-black">الوسيلة</th>
              <th class="p-4 font-black">الميزة</th>
              <th class="p-4 font-black">ما ينبغي التحقق منه</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#B98739]/20">
            <tr>
              <td class="p-4 font-black text-[#18110d]">النقد</td>
              <td class="p-4 text-[#58483e]">أسرع للمبالغ الصغيرة ويقبله معظم المحال</td>
              <td class="p-4 text-[#58483e]">توفّر الفكّة، ودقة العدّ أمامك</td>
            </tr>
            <tr>
              <td class="p-4 font-black text-[#18110d]">البطاقة</td>
              <td class="p-4 text-[#58483e]">مناسبة للمبالغ الكبيرة عند القبول</td>
              <td class="p-4 text-[#58483e]">وجود حد أدنى للدفع أو رسوم إضافية</td>
            </tr>
            <tr>
              <td class="p-4 font-black text-[#18110d]">الصراف الآلي</td>
              <td class="p-4 text-[#58483e]">مصدر إضافي للنقد عند الحاجة</td>
              <td class="p-4 text-[#58483e]">قبول بطاقتك وموقع أقرب جهاز وأوقاته</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="لا نضمن قبول البطاقة أو وجود صراف قريب أو أي سعر أو رسم. تحقّق ميدانياً من وسيلة الدفع قبل إتمام أي عملية، واحمل فكّة كافية لتجنّب التأخير في المواسم المزدحمة." />
      </div>
    </div>
  </section>
</GuideLayout>
