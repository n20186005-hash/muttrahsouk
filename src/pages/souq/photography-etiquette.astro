---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'التصوير والآداب' },
];

const quickFacts = [
  { label: 'القاعدة الأساسية', value: 'استأذن قبل تصوير الأشخاص' },
  { label: 'مواقع ممنوعة', value: 'المباني الحكومية والعسكرية والبنية الحساسة' },
  { label: 'الطائرات المسيّرة', value: 'تحتاج ترخيصاً مسبقاً من الجهة المختصة' },
  { label: 'أفضل ضوء للصور', value: 'الصباح الباكر وقبيل الغروب' },
];

const sections = [
  {
    heading: 'القاعدة الأولى: الإذن قبل تصوير الأشخاص',
    body: [
      'ينصح المصدر الرسمي للزائر باستئذان الأشخاص قبل تصويرهم، ويوصي في الوقت نفسه باللباس المحتشم واحترام آداب السلوك العُمانية. وعملياً هذا يعني أن تصوير المشهد العام والممرات والبضاعة لا يثير إشكالاً، أما توجيه الكاميرا إلى واقف بعينه فيستدعي سؤالاً سريعاً ومهذباً والانتظار حتى يُجاب بالموافقة.',
      'إذا أشار الشخص برأسه أو يده رافضاً فالأفضل أن تشكره وتنتقل. تعامل مع الباعة والأشخاص المتواجدين قرب الميناء بحذر خاص، لأنهم قد لا يرغبون بالظهور في إطار. احترام الرفض يحفظ لك تجربة أهدأ ويكسب ثقة من حولك.',
    ],
  },
  {
    heading: 'ما لا يجوز تصويره',
    body: [
      'يشير المصدر الرسمي إلى أن تصوير بعض المباني الحكومية أو المواقع العسكرية غير مسموح. وبما أن سوق مطرح ملاصق لمنطقة الميناء، فمن الحكمة ألا تصوّب عدستك نحو المنشآت الأمنية والبنية الحساسة المحيطة، وأن تلتزم بالممرات السياحية والواجهة البحرية.',
      'هذه القيود قابلة للتغيّر بحسب الجهات المختصة، وما نذكره هنا هو توجيه عام لا فتوى قانونية. إذا كنت في شكّ من موقع بعينه، فالأسلم أن تمتنع عن التصوير ثم تسأل الجهة الرسمية إن دعت الحاجة، ويمكنك دائماً الاقتصار على تصوير السوق من الخارج.',
    ],
  },
  {
    heading: 'الطائرات المسيّرة (الدرون)',
    body: [
      'تنصّ لائحة الطيران المدني العُمانية على أن تشغيل الطائرات المسيّرة بدون ترخيص وفق الشروط المعمول بها أمر غير مسموح. لذلك لا يُنصح بإطلاق طائرة مسيّرة فوق السوق أو الميناء بغرض تصوير جوي دون استيفاء شروط الترخيص المسبق.',
      'تفاصيل الترخيص والمناطق المسموح بها وشروطها شأن يخصّ الجهات المختصة، ولم نتحقق من قيمتها الحالية بالتفصيل. هذا البند غير مؤكَّد النطاق ويتوقّف على تعليمات رسمية محدّثة، فتحقّق من هيئة الطيران المدني قبل أي استخدام، وبقيّة هذه الصفحة مكتوبة بحسب ما اطّلعنا عليه حتى 2 نوفمبر 2026.',
    ],
  },
];

const faq = [
  { q: 'هل يمكنني التصوير في السوق بحرية؟', a: 'تصوير المشهد العام والممرات والبضاعة عادةً مقبول، أما تصوير الأشخاص فيتطلّب إذناً مسبقاً، وتصوير المباني الحكومية والعسكرية والبنية الحساسة غير مسموح. عند الشك، اسأل أو امتنع.' },
  { q: 'هل أحتاج إذناً لتصوير الباعة؟', a: 'نعم، الأفضل أن تستأذن أولاً، وأن تحترم الرفض دون إلحاح. بعض الباعة قد يفضّل ألا يظهر بضاعته أو شخصه في الصور.' },
  { q: 'هل الطائرات المسيّرة مسموحة للتصوير؟', a: 'تشير اللائحة الرسمية إلى اشتراط ترخيص للتشغيل. تفاصيل الشروط والمناطق المسموح بها غير مؤكَّدة هنا وتتغيّر؛ تحقّق من هيئة الطيران المدني قبل أي استخدام.' },
  { q: 'ما اللباس المناسب أثناء التصوير؟', a: 'ينصح المصدر الرسمي باللباس المحتشم، وهذا مهمّ خصوصاً قرب المواقع الدينية والمناسبات. اللباس المحتشم يسهّل تعاملك مع من حولك ويحفظ لك حسن الاستقبال.' },
  { q: 'هل التصوير داخل المواقع الدينية مسموح؟', a: 'تختلف القواعد من موقع إلى آخر وقد تُمنع صور محدّدة أثناء الصلاة. لم نتحقق من تعليمات كل موقع على حدة؛ اسأل القائمين قبل التصوير والتزم بتوجيهاتهم.' },
];

const sources = [
  { label: 'إرشادات سياحية للزائرين', org: 'وزارة الخارجية العُمانية (رسمي)', url: 'https://www.fm.gov.om/en/visitors/travel-advice-for-visitors/', desc: 'يوصي باللباس المحتشم واستئذان الأشخاص قبل التصوير، ومنع تصوير المباني الحكومية والعسكرية.' },
  { label: 'لائحة تنظيم الطائرات المسيّرة بدون طيار', org: 'هيئة الطيران المدني العُمانية (رسمي)', url: 'https://www.caa.gov.om/files/publications/regulation-governing-unmanned-aircraft-systems-drones.pdf', desc: 'قرار رسمي ينظّم تشغيل الطائرات المسيّرة واشتراط الترخيص.' },
  { label: 'سوق مطرح — التعريف الرسمي', org: 'بوابة عُمان السياحية (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'سياق المكان وعلاقته بالواجهة البحرية والكورنيش.' },
];

const related = [
  { href: '/visit/best-time/', label: 'أفضل وقت للزيارة', desc: 'الفصول والأوقات الأنسب للضوء والجو.' },
  { href: '/itineraries/sunset-photo/', label: 'مسار الغروب والتصوير', desc: 'برنامج مقترح لجولة تصوير عند الغروب.' },
  { href: '/around/corniche/', label: 'كورنيش مطرح', desc: 'واجهة بحرية مناسبة للتصوير العام.' },
  { href: '/souq/architecture/', label: 'العمارة التقليدية', desc: 'تفاصيل الأسقف والأقواس التي تستحق العدسة.' },
  { href: '/visit/accessible-route/', label: 'زيارة ميسّرة', desc: 'مسارات تناسب احتياجات التنقّل المختلفة.' },
];
---
<GuideLayout
  title="التصوير في سوق مطرح: القواعد والآداب ونصائح عملية | دليل سوق مطرح"
  h1="التصوير في سوق مطرح والآداب العامة"
  description="كيف تصوّر في سوق مطرح باحترام: استئذان الأشخاص قبل التصوير، حدود تصوير المباني الحساسة، اشتراط ترخيص الطائرات المسيّرة، وأفضل أوقات الضوء."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قائمة إتيكيت سريعة</p>
          <ul class="mt-3 space-y-3 text-sm text-[#66574e]">
            <li>استأذن بعبارة قصيرة ومهذبة قبل تصوير أي شخص.</li>
            <li>احترم الرفض فوراً دون محاولة إقناع أو تكرار.</li>
            <li>تجنّب الفلاش المباشر في وجه الناس ولاسيما داخل الممرات الضيقة.</li>
            <li>لا تصوّب عدستك نحو المنشآت الأمنية والميناء المحيط بالسوق.</li>
            <li>لا تسدّ الممر ولا تعطّل حركة المارّة أثناء التصوير.</li>
          </ul>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> تنظيم التصوير وشروط تشغيل الطائرات المسيّرة من اختصاص الجهات الرسمية وقد تتغيّر. ما ورد هنا توجيه عام كما اطّلعنا عليه حتى <BidiText text="2 نوفمبر 2026" />، وتُستحسن مراجعة المصادر الرسمية قبل الانطلاق.
        </div>
      </aside>
    </div>
  </section>
</GuideLayout>
