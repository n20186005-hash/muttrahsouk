---
import GuideLayout from '../../layouts/GuideLayout.astro';
import BidiText from '../../components/BidiText.astro';

const breadcrumb = [
  { name: 'الرئيسية', href: '/' },
  { name: 'السوق وثقافته', href: '/souq/history/' },
  { name: 'ماذا تشتري' },
];

const quickFacts = [
  { label: 'أشهر الفئات', value: 'اللبان والبخور، العطور، التوابل، الأقمشة، الفضيات، الخناجر، الفخار والتحف' },
  { label: 'قبل الشراء', value: 'اسأل عن المنشأ والمادة والوزن' },
  { label: 'الهدايا الخفيفة', value: 'البخور والتوابل والمنسوجات أسهل في الحمل' },
  { label: 'الدفع', value: 'تتفاوت البطاقات بين المحال؛ احمل قدراً من الريال العُماني' },
];

const sections = [
  {
    heading: 'كيف تشتري بذكاء في سوق مطرح؟',
    body: [
      'سوق مطرح مناسب لتجربة التسوق التقليدي، لكن الجودة تتفاوت بين المحال أكثر مما يتفاوت السعر وحده. أسلوب عملي: اختر فئة واحدة أولاً، ثم قارن ثلاث أو أربع محال قبل الشراء بدل الاكتفاء بأول عرض يصادفك.',
      'قبل الدفع اسأل ثلاثة أسئلة: ما منشأ المنتج؟ ما المادة المصنوع منها؟ وما وزنه إن كانت القطعة ثمينة؟ هذه الأسئلة تكشف كثيراً عن الجودة وتساعدك على المقارنة العادلة بين العرضين.',
      'تذكّر أن هذا دليل مستقل لا يوصي بمحال بعينها ولا يقدّم أسعاراً مؤكدة؛ فالأسماء التجارية والأسعار تتبدّل باستمرار. اعتمد على فحص المنتج وسؤال البائع ومقارنة ما تراه على أرض الواقع.',
    ],
  },
  {
    heading: 'أبرز فئات المنتجات في السوق',
    body: [
      'تصف الفئات التالية ما تشتهر به أزقة السوق عادةً وما ينبغي أن تسأل عنه في كل فئة، دون الإشارة إلى أي محل بعينه.',
    ],
  },
];

const categories = [
  { icon: 'اللبان والبخور', body: 'محصول عُماني شهير من محافظة ظفار. اسأل عن المنشأ والدرجة وطريقة التخزين؛ تحمل بعض الدرجات التجارية تسميات مثل الحوجري والنجدي والشزري والشعبي.' },
  { icon: 'العطور والدهن', body: 'زيوت عطرية ومباخر ومستحضرات عطرية. اسأل عن نوع الزيت ودرجة تركيزه وحجم العبوة، وجرّب كمية صغيرة على الجلد قبل الشراء.' },
  { icon: 'التوابل والبهارات', body: 'مزيج البهارات والكركم والليمون المجفف (اللومي) وغيرها. اسأل عن مكونات الخلطة وطزاجتها وطريقة حفظها، وميّز الرائحة القوية الدالة على الطزاجة.' },
  { icon: 'الأقمشة والمنسوجات', body: 'أقمشة وأوشحة ومنسوجات محلية. اسأل عن نوع النسيج وثبات الألوان وطريقة الغسل، وتحقّق من الطول والعرض قبل القص.' },
  { icon: 'الفضيات والمجوهرات', body: 'قطع فضية قد تكون مرصّعة. اسأل عن نقاء الفضة ووزنها بالجرام وهل هي مصنوعة يدوياً أم منسوخة، واطلب وزنها على ميزان إن أمكن.' },
  { icon: 'الخنجر العُماني', body: 'قطعة رمزية وتراثية بارزة في السوق. راجع صفحة الفضة والخناجر لتفاصيل المكونات وضرورة التحقق من قواعد الحمل قبل الشراء.' },
  { icon: 'الفخار والتحف', body: 'أوانٍ فخارية وتحف وهدايا. اسأل عن مدى هشاشتها وتغليفها للسفر؛ فهي الأكثر عرضة للكسر أثناء النقل.' },
  { icon: 'الهدايا الصغيرة', body: 'منتجات خفيفة مناسبة للهدايا كالبخور والتوابل والمنسوجات والحلي الصغيرة، وهي الأسهل في الحمل والسفر.' },
];

const compare = [
  { a: 'اللبان والبخور', b: 'المنشأ، اللون، نقاء الراتنج، التخزين', c: 'خفيف ومحمول بسهولة' },
  { a: 'العطور والدهن', b: 'نوع الزيت، التركيز، حجم العبوة', c: 'سائل؛ يحتاج تغليفاً محكماً' },
  { a: 'التوابل', b: 'المكونات، الطزاجة، تاريخ التعبئة', c: 'خفيف؛ انتبه للرطوبة' },
  { a: 'الأقمشة', b: 'نوع النسيج، ثبات اللون، المقاس', c: 'قد يكون كبير الحجم' },
  { a: 'الفضيات', b: 'النقاء، الوزن، صناعة يدوية أم منسوخة', c: 'ثقيل نسبياً؛ يحتاج حماية' },
  { a: 'الفخار والتحف', b: 'الصلابة، طريقة التغليف', c: 'هشّ؛ يحتاج لفاً جيداً' },
];

const faq = [
  { q: 'هل الأسعار في سوق مطرح ثابتة؟', a: 'لا؛ الأسعار تتفاوت بين المحال وتتغير بمرور الوقت، وقد تكون قابلة للتفاوض. قارن أكثر من عرض قبل الشراء، ولا تعتمد على أي سعر منشور في هذا الدليل.' },
  { q: 'ما أفضل هدية خفيفة للحمل والسفر؟', a: 'البخور واللبان والتوابل والمنسوجات الصغيرة من الأسهل في الحمل. تجنّب السوائل والزجاج والفخار إلا مع تغليف محكم، لأنها أكثر عرضة للتلف أو لقيود النقل.' },
  { q: 'كيف أعرف أن القطعة الفضية أصلية؟', a: 'اسأل البائع صراحةً عن نوع المعدن ووزن القطعة، واطلب وزنها أمامك إن أمكن. لا يوجد اختبار بسيط يقطع بالأصالة داخل السوق، لذلك قارن بين أكثر من محل وتجنّب الادعاءات غير الموثقة.' },
  { q: 'هل يمكنني إخراج الخناجر والفضيات من عُمان؟', a: 'قواعد حمل أو تصدير بعض القطع تحتاج تحققاً رسمياً من الجهات المختصة قبل السفر، ولم نتحقق منها في هذا الدليل. راجع صفحة الفضة والخناجر واتصل بالجهات الرسمية قبل الشراء للسفر.' },
];

const sources = [
  { label: 'تجربة عُمان — سوق مطرح', org: 'وزارة التراث والسياحة (رسمي)', url: 'https://experienceoman.om/destinations/muscat/mutrah-souq', desc: 'تعريف رسمي بالسوق وفئاته العامة، وفترة الزيارة المناسبة (سبتمبر–مايو).' },
  { label: 'بلدية مسقط — سوق مطرح', org: 'بلدية مسقط (رسمي)', url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903', desc: 'وصف السلع التي يشتهر بها السوق (اللبان والبخور والعطور والتحف والفضيات والمنسوجات) وعدد المحال.' },
  { label: 'خرائط جوجل — سوق مطرح', org: 'خرائط جوجل', url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8', desc: 'اللقطة المرجعية للموقع والإحداثيات؛ راجع أحدث نسخة قبل الانطلاق، وهي لقطة مستخدمين وليست تقييماً جمعه هذا الدليل.' },
];

const related = [
  { href: '/souq/frankincense/', label: 'اللبان والبخور', desc: 'الأنواع والدرجات وكيف تفرّق بين اللبان والبخور المركّب.' },
  { href: '/souq/perfume-spices/', label: 'العطور والتوابل', desc: 'الزيوت العطرية والبهارات والحلوى العُمانية.' },
  { href: '/souq/silver-khanjar/', label: 'الفضة والخناجر', desc: 'الخنجر العُماني ومكوناته والعناية به.' },
  { href: '/souq/bargaining-payment/', label: 'المساومة والدفع', desc: 'آداب السعر ووسائل الدفع في السوق.' },
];
---
<GuideLayout
  title="ماذا تشتري من سوق مطرح؟ دليل فئات المنتجات والجودة | دليل سوق مطرح"
  h1="ماذا تشتري من سوق مطرح؟ دليل الفئات والجودة"
  description="دليل فئات ما يمكن شراؤه من سوق مطرح: اللبان والبخور، العطور، التوابل، الأقمشة، الفضيات، الخنجر والتحف، مع أسئلة المنشأ والجودة وملاءمة الحمل والسفر."
  breadcrumb={breadcrumb}
  quickFacts={quickFacts}
  faq={faq}
  sources={sources}
  related={related}
>
  <section class="section">
    <div class="shell grid gap-12 lg:grid-cols-[1.1fr_.9fr]">
      <div class="space-y-10">
        {sections.map((s) => (
          <div>
            <h2 class="display text-3xl font-black text-[#18110d]">{s.heading}</h2>
            <div class="mt-4 space-y-4 text-[#58483e]">
              {s.body.map((p) => <p><BidiText text={p} /></p>)}
            </div>
          </div>
        ))}
      </div>
      <aside class="grid content-start gap-5">
        <div class="card rounded-3xl p-6">
          <p class="text-xs font-black text-[#176b68]">قاعدة عامة عند التسوق</p>
          <ol class="mt-3 list-decimal space-y-2 pe-5 text-sm text-[#66574e]">
            <li>حدّد الفئة والغرض قبل الدخول.</li>
            <li>قارن أكثر من محل في الفئة نفسها.</li>
            <li>اسأل عن المنشأ والمادة والوزن.</li>
            <li>افحص المنتج بعينك قبل الدفع.</li>
          </ol>
        </div>
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
          <b class="text-[#18110d]">تنبيه:</b> الأسعار والماركات والدرجات تتغير، ولا يوصي هذا الدليل بمحل بعينه. أي ادعاء عن «الأفضل» أو «الأصلي» يُقرأ بحذر ويُتحقق منه بنفسك.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-[#f1e3c4] py-16">
    <div class="shell">
      <p class="kicker">فئات المنتجات</p>
      <h2 class="display mt-3 text-4xl font-black">ما الذي تشتهر به أزقة السوق؟</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => (
          <article class="card rounded-3xl p-5">
            <h3 class="text-lg font-black text-[#18110d]">{c.icon}</h3>
            <p class="mt-2 text-sm text-[#66574e]"><BidiText text={c.body} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="kicker">مقارنة سريعة</p>
      <h2 class="display mt-3 text-3xl font-black">ما تسأل عنه بحسب الفئة</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-right text-sm">
          <thead>
            <tr class="bg-[#176b68] text-white">
              <th class="p-4 font-black">الفئة</th>
              <th class="p-4 font-black">ما تسأل عنه</th>
              <th class="p-4 font-black">ملاءمة الحمل والسفر</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#B98739]/20">
            {compare.map((r) => (
              <tr>
                <td class="p-4 font-black text-[#18110d]">{r.a}</td>
                <td class="p-4 text-[#58483e]">{r.b}</td>
                <td class="p-4 text-[#58483e]">{r.c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">قسم التحقق (<BidiText text="2 نوفمبر 2026" />):</b>
        <BidiText text="المنتجات والمعروضات تتغير بحسب الموسم والمحل. تحقّق ميدانياً من المادة والمنشأ والوزن قبل الشراء، ولأي مسألة تتعلق بتصدير القطع الثمينة أو النباتية راجع الجهات الرسمية المختصة قبل السفر." />
      </div>
    </div>
  </section>
</GuideLayout>
