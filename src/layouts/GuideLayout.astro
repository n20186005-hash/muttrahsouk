---
// قالب موحّد لصفحات الدليل الفرعية: مسار تنقل، بيانات منظّمة، أسئلة شائعة، مصادر وروابط داخلية.
// كل صفحة تمرّر محتواها العربي عبر الخصائص وفتحة المحتوى، دون تكرار الهيكل.
import BaseLayout from './BaseLayout.astro';
import BidiText from '../components/BidiText.astro';

interface Crumb { name: string; href?: string }
interface Fact { label: string; value: string }
interface QA { q: string; a: string }
interface SourceLink { label: string; url: string; org?: string; desc?: string }
interface Related { href: string; label: string; desc?: string }

interface Props {
  title: string;
  h1: string;
  description: string;
  breadcrumb: Crumb[];
  updated?: string;
  intro?: string[];
  quickFacts?: Fact[];
  factsTitle?: string;
  faq?: QA[];
  sources?: SourceLink[];
  related?: Related[];
  jsonLd?: unknown | unknown[];
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  h1,
  description,
  breadcrumb,
  updated = '2 نوفمبر 2026',
  intro = [],
  quickFacts = [],
  factsTitle = 'معلومات سريعة',
  faq,
  sources,
  related,
  jsonLd,
  image,
  imageAlt,
  noindex = false,
} = Astro.props;

const site = Astro.site;
const path = Astro.url.pathname;
const absolute = (pathname: string) => (site ? new URL(pathname, site).toString() : undefined);
const canonical = absolute(path);
const crumbUrl = (href?: string) => (href ? absolute(href) : undefined);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(crumbUrl(c.href) ? { item: crumbUrl(c.href) } : {}),
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  inLanguage: 'ar-OM',
  ...(canonical ? { mainEntityOfPage: canonical, url: canonical } : {}),
  ...(image ? { image: [image] } : {}),
  dateModified: '2026-11-02',
  author: { '@type': 'Organization', name: 'دليل سوق مطرح' },
  publisher: { '@type': 'Organization', name: 'دليل سوق مطرح' },
  about: { '@type': 'TouristAttraction', name: 'سوق مطرح', alternateName: ['Mutrah Souq', 'Muttrah Souq'] },
};

const faqLd = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : undefined;

const schemas = [breadcrumbLd, articleLd, ...(faqLd ? [faqLd] : []), ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt} jsonLd={schemas} noindex={noindex}>
  <article>
    <header class="relative overflow-hidden bg-[#18110d] pt-28 pb-14 text-white">
      <div class="pattern absolute inset-0 opacity-25"></div>
      <div class="shell relative max-w-4xl">
        <nav aria-label="مسار التنقل" class="text-xs font-bold text-[#d8c6a2]">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            {breadcrumb.map((c, i) => (
              <li class="flex items-center gap-x-2">
                {c.href ? <a class="underline decoration-[#B98739]/60 underline-offset-4 hover:text-[#F6D98C]" href={c.href}>{c.name}</a> : <span class="text-[#F6D98C]">{c.name}</span>}
                {i < breadcrumb.length - 1 && <span aria-hidden="true" class="text-[#B98739]">›</span>}
              </li>
            ))}
          </ol>
        </nav>
        <h1 class="display mt-5 text-4xl font-black leading-[1.3] md:text-5xl">{h1}</h1>
        {intro.length > 0 && (
          <div class="mt-5 space-y-4 text-lg text-[#f0e4cd]">
            {intro.map((p) => <p><BidiText text={p} /></p>)}
          </div>
        )}
        <p class="mt-6 inline-flex rounded-full border border-[#E2A52E]/50 bg-black/25 px-4 py-1.5 text-xs font-bold text-[#F6D98C]">
          آخر مراجعة للمعلومات: <BidiText text={updated} />
        </p>
      </div>
    </header>

    {quickFacts.length > 0 && (
      <section class="bg-[#f1e3c4] py-10">
        <div class="shell">
          <h2 class="text-sm font-black tracking-wide text-[#176b68]">{factsTitle}</h2>
          <dl class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {quickFacts.map((f) => (
              <div class="card rounded-3xl p-5">
                <dt class="text-xs font-bold text-[#66574e]">{f.label}</dt>
                <dd class="mt-2 text-lg font-black text-[#18110d]"><BidiText text={f.value} /></dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <slot />

    {faq && faq.length > 0 && (
      <section id="faq" class="bg-[#176b68] py-16 text-white">
        <div class="shell max-w-4xl">
          <p class="text-sm font-bold text-[#F6D98C]">الأسئلة الشائعة</p>
          <h2 class="display mt-3 text-4xl font-black">أسئلة تتكرر حول هذا الموضوع</h2>
          <div class="mt-8 divide-y divide-white/15 border-y border-white/15">
            {faq.map((item) => (
              <details class="group py-5">
                <summary class="cursor-pointer list-none text-lg font-black">{item.q}<span class="float-left text-[#F6D98C] group-open:rotate-45">＋</span></summary>
                <p class="mt-3 max-w-3xl text-[#d8eee9]"><BidiText text={item.a} /></p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {related && related.length > 0 && (
      <section class="section">
        <div class="shell">
          <p class="kicker">تابع الاستكشاف</p>
          <h2 class="display mt-3 text-3xl font-black">صفحات مرتبطة بهذا الموضوع</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <a class="card block rounded-3xl p-5 transition hover:-translate-y-0.5" href={r.href}>
                <b class="text-lg font-black text-[#18110d]">{r.label}</b>
                {r.desc && <span class="mt-2 block text-sm text-[#66574e]">{r.desc}</span>}
              </a>
            ))}
            <a class="card block rounded-3xl p-5 transition hover:-translate-y-0.5" href="/">
              <b class="text-lg font-black text-[#18110d]">الصفحة الرئيسية: سوق مطرح</b>
              <span class="mt-2 block text-sm text-[#66574e]">نظرة شاملة على السوق وموقعه وأوقات الزيارة والمواقف.</span>
            </a>
          </div>
        </div>
      </section>
    )}

    {sources && sources.length > 0 && (
      <section class="bg-[#f1e3c4] py-14">
        <div class="shell">
          <p class="kicker">المصادر</p>
          <h2 class="display mt-3 text-3xl font-black">مراجع هذه الصفحة</h2>
          <ul class="mt-7 space-y-4">
            {sources.map((s) => (
              <li class="card rounded-3xl p-5">
                <p class="text-xs font-bold text-[#176b68]">{s.org ?? 'مصدر خارجي'}</p>
                <a class="mt-1 block font-black text-[#18110d] underline decoration-[#B98739]/50 underline-offset-4 hover:text-[#176b68]" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
                {s.desc && <p class="mt-2 text-sm text-[#66574e]">{s.desc}</p>}
                <p class="mt-2 break-all text-xs text-[#a08558]" dir="ltr">{s.url}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="py-12">
      <div class="shell rounded-[2rem] border border-[#B98739]/30 bg-[#fffaf0] p-6 text-sm text-[#66574e]">
        <p><b class="text-[#18110d]">ملاحظة الاستقلالية:</b> هذا الدليل مستقل وغير رسمي ولا يتبع أي جهة حكومية، ولا يتضمن توصيات تجارية مدفوعة. أوقات العمل والأسعار والمواقف ووسائل النقل قابلة للتغيير؛ تحقّق من القنوات الرسمية وخرائط جوجل قبل الانطلاق، خصوصاً في العطلات والمناسبات.</p>
        <p class="mt-3">صور الدليل وتراخيصها موثّقة في <a class="underline" href="/CREDITS.txt">اعتمادات الصور وتراخيصها</a>.</p>
      </div>
    </section>
  </article>
</BaseLayout>
