  {
    label: 'تجربة عُمان — مسقط',
    org: 'تجربة عُمان (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat',
    desc: 'نظرة أوسع على محافظة مسقط ووجهاتها، توضّح مكانة السوق ضمن منطقة مسقط.',
  },
  {
    label: 'بلدية مسقط',
    org: 'بلدية مسقط (رسمي)',
    url: 'https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&MoID=1&NID=1903',
    desc: 'المرجع البلدي لمطرح ومسقط، يفيد عند التحقق من الخدمات العامة والمرافق.',
  },
  {
    label: 'خرائط جوجل — لقطة المكان',
    org: 'خرائط جوجل',
    url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8',
    desc: 'الموقع والتقييم والساعات كما ظهرت في 23 أكتوبر 2026؛ ساعات المحال قد تختلف.',
  },
  {label:'صور الدليل وتراخيصها',org:'اعتماد المصورين',url:'/CREDITS.txt',desc:'كل صورة مرتبطة بصفحتها الأصلية وترخيصها؛ الصور أرشيفية وليست دليلاً على الوضع الحالي.'},
  {label:'Open-Meteo',org:'نماذج الطقس والبحر',url:'https://open-meteo.com/en/docs/marine-weather-api',desc:'مصدر المتغيرات وحدود النموذج البحري، وليس جدول مد رسمياً أو خدمة سلامة.'},
