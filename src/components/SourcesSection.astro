// المحتوى مستمد من SOURCES.md ولا يضيف أي ادعاءات غير موثّقة.
const sources = [
  {
    label: 'وزارة التراث والسياحة — سوق مطرح',
    org: 'تجربة عُمان (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat/mutrah-souq',
    desc: 'الصفحة الرسمية للسوق ضمن بوابة السياحة العُمانية، مرجع للهوية والسياق الجغرافي.',
  },
  {
    label: 'تجربة عُمان — مسقط',
    org: 'تجربة عُمان (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat',
    desc: 'نظرة أوسع على محافظة مسقط ووجهاتها، توضّح مكانة السوق ضمن منطقة مسقط.',
  },
  {
    label: 'بلدية مسقط',
    org: 'بلدية مسقط (رسمي)',
    url: 'https://www.muscatmunicipality.gov.om/',
    desc: 'المرجع البلدي لمطرح ومسقط، يفيد عند التحقق من الخدمات العامة والمرافق.',
  },
  {
    label: 'خريطة الموقع (المالك)',
    org: 'خرائط جوجل',
    url: 'https://maps.app.goo.gl/i18WFNytBsRsd3YW8',
    desc: 'رابط المشاركة الذي زوّده مالك المشروع لتثبيت الموقع والإحداثيات.',
  },
  {
    label: 'ويكي بيانات — سوق مطرح',
    org: 'Wikidata',
    url: 'https://www.wikidata.org/wiki/Q87834530',
    desc: 'عقدة الكيان الموثّقة في قاعدة المعرفة المفتوحة، تثبّت الهوية في محركات البحث.',
  },
  {
    label: 'ويكيميديا كومنز — تصنيف السوق',
    org: 'Wikimedia Commons',
    url: 'https://commons.wikimedia.org/wiki/Category:Muttrah_souq',
    desc: 'مصدر صور الملك العام/المرخّص المستخدمة في الموقع، مع تفاصيل الاعتماد في IMAGE_SOURCES.md.',
  },
