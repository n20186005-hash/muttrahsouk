const sources = [
  {
    label: 'وزارة التراث والسياحة — سوق مطرح',
    org: 'تجربة عُمان (رسمي)',
    url: 'https://experienceoman.om/destinations/muscat/mutrah-souq',
    desc: 'الصفحة الرسمية للسوق ضمن بوابة السياحة العُمانية، مرجع للهوية والسياق الجغرافي.',
