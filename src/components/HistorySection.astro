---
// قسم التاريخ والمكانة التجارية — إضافة محتوى (لا يحذف أي قسم قائم)
const timeline = [
  ['الميناء والمكانة', 'قبل اكتشاف النفط كانت مطرح، وميناء مسقط المجاور، القلب التجاري الذي تستقر عنده البضائع القادمة من المحيط الهندي وتتوزع إلى داخل عُمان.'],
  ['سوقٌ دائم قديم', 'تصفه دراسات أكاديمية بأنه من أقدم الأسواق التقليدية الدائمة في عُمان، ويعود شكله المفتوح يومياً داخل الأزقة المسقوفة إلى نحو القرن التاسع عشر.'],
  ['«سوق الظلام»', 'تسمية وردت في بعض الكتابات لكثافة ممراته وغطائها الخشبي الذي يخفف وهج النهار؛ ويذكر كثير من الوصاف أنه يمتد خطياً من الواجهة البحرية نحو قلب الحي.'],
  ['حاضرٌ عامل', 'ما زال سوقاً يعمل كل يوم: اللبان والبخور والعطور، الفضيات والخناجر، المنسوجات المطرزة، الحلوى والبهارات، والهدايا والتحف — لا متحفاً للعرض.'],
];
---
<section id="history" class="bg-[#f1e3c4] py-16">
  <div class="shell">
    <p class="kicker">من قلب التاريخ</p>
    <h2 class="display mt-3 max-w-3xl text-4xl font-black md:text-5xl">ليست مجرد سوق: ذاكرة ميناءٍ وتجارةٍ وحياة</h2>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_.85fr]">
      <div class="space-y-5 text-[#58483e]">
        <p class="text-lg"><b class="text-[#18110d]">مطرح أولاً ميناء:</b> يقع السوق في حي مطرح الساحلي الذي يعَدّ من أقدم أحياء مسقط وأشدها ارتباطاً بالبحر. تشير مراجع التاريخ التجاري إلى أن المنطقة كانت، قبل نهضة النفط، نافذة السلطنة على تجارة المحيط الهندي وملتقى للسفن والبضائع القادمة من الهند وشرق أفريقيا والخليج.</p>
        <p>أما سوق مطرح نفسه فتصفه دراسات أكاديمية بأنه من أقدم الأسواق التقليدية الدائمة في عُمان، وتذكر بعض الكتابات أنه عُرف قديماً بـ«سوق الظلام» بسبب ممراته المزدحمة وغطائها الخشبي الذي يلطّف حرارة النهار ويحجب جزءاً من الضوء. تلك الممرات المسقوفة، التي تبدأ من واجهة الكورنيش وتمتد نحو قلب الحي، هي ما يمنح السوق سقفه الخشبي المميز وأجوائه المتشابكة التي يصفها الزائرون اليوم.</p>
        <p>غير أن ما يجعل المكان مختلفاً أن هذا الإرث ما زال حياً: فالسوق يعمل يومياً ويؤدي وظيفته التجارية الحقيقية، وتتجاور فيه محال اللبان والبخور والعطور التقليدية، وحرف الفضيات وصناعة الخناجر، ومحال المنسوجات العُمانية المطرزة، وأكشاك الحلوى والبهارات والقهوة، إلى جانب أقسام الهدايا والتحف. وهذه الاستمرارية هي جوهر الفرق بينه وبين الأسواق التي أعدّت للعرض فقط.</p>
        <p>وللمكان بعدٌ ثقافي: فالكرم جزء من عادات التسوق في الأسواق العُمانية، وقد يُقدَّم للزائر في بعض المحال فنجان قهوة عُمانية مع التمر أو الحلوى، ويتصدر اللبان طقوس الضيافة المحلية. التجول هنا تجربة تلامس الحياة اليومية، لا مجرد مشاهدة من الخارج.</p>
      </div>
      <aside class="space-y-4">
        <p class="font-black text-[#18110d]">محطات في التعريف</p>
        {timeline.map(([t, d]) => (
          <div class="card rounded-3xl p-5">
            <h3 class="font-black text-[#176b68]">{t}</h3>
            <p class="mt-2 text-sm text-[#66574e]">{d}</p>
          </div>
        ))}
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-4 text-xs leading-6 text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة تاريخية:</b> هذه الفقرات معلومات عامة مستمدة من مراجع مفتوحة وتاريخ المنطقة التجاري، ولا تدّعي التفصيل الأكاديمي. تحقّق من المصادر الرسمية للحصول على تفاصيل موثّقة قبل الاعتماد على أي معلومة في كتابة متخصصة.
        </div>
      </aside>
    </div>
  </div>
</section>
