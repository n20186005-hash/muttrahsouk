---
// قسم التاريخ والمكانة التجارية — إضافة محتوى (لا يحذف أي قسم قائم)
const timeline = [
 ['الواجهة البحرية','تصف بلدية مسقط موقع السوق على الواجهة البحرية في مطرح.'],
 ['الممرات والأسقف','تذكر البلدية الأزقة الضيقة والمتعرجة والأسقف الخشبية المنقوشة.'],
 ['سوق الظلام','تربط البلدية الاسم بحجب الأزقة لضوء النهار في جزء من السوق.'],
 ['سلع السوق','من السلع المذكورة رسمياً: اللبان والبخور والعطور والتحف والفضيات والمنسوجات.'],
];
---
<section id="history" class="bg-[#f1e3c4] py-16">
  <div class="shell">
    <p class="kicker">من قلب التاريخ</p>
    <h2 class="display mt-3 max-w-3xl text-4xl font-black md:text-5xl">ليست مجرد سوق: ذاكرة ميناءٍ وتجارةٍ وحياة</h2>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_.85fr]">
      <div class="space-y-5 text-[#58483e]">
        <p class="text-lg">تصف بوابة تجربة عُمان السوق بأنه سوق عربي تقليدي بأزقة ومتاجر متشابكة. وتعرض بلدية مسقط تفاصيل ممراته الضيقة وأسقفه الخشبية المنقوشة وصلته بالواجهة البحرية.</p>
        <p>تشرح البلدية تسمية «سوق الظلام» بحجب الأزقة لضوء الشمس في الجزء الممتد من مسجد الرسول الأعظم إلى خور بمبة، بدلاً من تحديد تاريخ تأسيس غير متحقق.</p>
        <p>تذكر البلدية محال اللبان والبخور والعطور والهدايا والفضيات والأقمشة؛ اسأل البائع عن منشأ السلعة ومادتها وسعرها قبل الشراء، ولا تفترض أن كل معروض صُنع محلياً.</p>
        <p><a class="underline" href="https://www.mm.gov.om/ar/NewNewsDetails.aspx?MID=59&amp;MoID=1&amp;NID=1903">بلدية مسقط: سوق مطرح بين عبق الماضي وإشراقة الحاضر</a></p>
      </div>
      <aside class="space-y-4">
        <p class="font-black text-[#18110d]">محطات في التعريف</p>
        {timeline.map(([t, d]) => (
          <div class="card rounded-3xl p-5">
            <h3 class="font-black text-[#176b68]">{t}</h3>
            <p class="mt-2 text-sm text-[#66574e]">{d}</p>
          </div>
        ))}
        <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-4 text-xs leading-6 text-[#66574e]">
          <b class="text-[#18110d]">ملاحظة تاريخية:</b> المصدر البلدي يصف تاريخ السوق وأعمال تطويره؛ ليس كشفاً لحالة كل مرفق اليوم.
        </div>
      </aside>
    </div>
  </div>
</section>
