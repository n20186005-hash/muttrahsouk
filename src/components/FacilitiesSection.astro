---
// قسم المرافق — أنواع الخدمات فقط دون ذكر أسماء تجارية (حياد تام)
const numerals = ['١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
const facilities = [
  ['المرافق الصحية (دورات المياه)', 'تتوفر مرافق عامة في محيط الكورنيش وفي بعض المجمعات القريبة من السوق، وقد يُطلب مقابل رمزي للاستخدام. تحقّق من المتاح وقت زيارتك.'],
  ['مواقف السيارات', 'مواقف عامة على جانبي كورنيش مطرح وفي الشوارع المحيطة، ويرتفع الإشغال مساءً وفي العطلات. التوجه مبكراً أو استخدام سيارة أجرة يوفّر وقت البحث عن موقف.'],
  ['المطاعم والمقاهي', 'يقدّم المحيط القريب للسوق تشكيلة واسعة من المطاعم والمقاهي العُمانية والخليجية. لا يوصي هذا الدليل بأي اسم محدد، بل ينصح بالاختيار وفق النظافة والقائمة والسعر.'],
  ['الفنادق والإقامة', 'تنتشر الفنادق والشقق الفندقية على طول كورنيش مطرح وفي مسقط؛ يسهل الوصول إلى السوق سيراً أو بسيارة أجرة من أغلبها حسب موقع إقامتك.'],
  ['البقالة والسوبرماركت', 'توجد محال بقالة ومتاجر مواد غذائية في حي مطرح والمناطق القريبة، لشراء الماء والمأكولات الخفيفة ومستلزمات الرحلة اليومية.'],
  ['محطات الوقود وشحن السيارات الكهربائية', 'محطات الوقود متوفرة في مسقط وعلى الطرق المؤدية إلى مطرح، وتتوسع نقاط شحن السيارات الكهربائية تدريجياً. إن كنت تقود سيارة كهربائية، تحقّق من أقرب نقطة شحن قبل التخطيط.'],
  ['الصراف الآلي والخدمات المصرفية', 'ماكينات الصراف الآلي والفروع المصرفية متاحة في مطرح ومسقط. يُنصح بحمل مبلغ نقدي صغير بالريال العُماني لأن الدفع النقدي ما زال شائعاً داخل السوق.'],
  ['المساجد ودور الصلاة', 'توجد مساجد على مسافة مشي قصيرة من السوق في حي مطرح، بما يناسب أداء الصلوات أثناء الجولة.'],
  ['الصيدليات والرعاية الصحية', 'صيدليات ومراكز صحية متوفرة في مطرح ومسقط للحالات البسيطة؛ وللحالات الطارئة يُرجى التواصل مع الجهات الصحية المختصة.'],
];
---
<section id="facilities" class="section">
  <div class="shell">
    <div class="flex items-end justify-between gap-5">
      <div>
        <p class="kicker">المرافق والخدمات</p>
        <h2 class="display mt-3 max-w-3xl text-4xl font-black md:text-5xl">ماذا تجد حول السوق قبل أن تحتاجه</h2>
      </div>
      <p class="hidden max-w-md text-sm text-[#58483e] md:block">مرافق وخدمات عامة تُذكر بنوعها فقط للحفاظ على الحياد، دون توصية بأي جهة أو علامة تجارية.</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {facilities.map(([title, text], i) => (
        <article class="card rounded-3xl p-6">
          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#176b68]/10 text-lg font-black text-[#176b68]">{numerals[i] ?? i + 1}</span>
            <div>
              <h3 class="text-lg font-black leading-7">{title}</h3>
              <p class="mt-2 text-sm text-[#66574e]">{text}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-6 rounded-2xl border border-[#B98739]/30 bg-[#fffaf0] p-4 text-sm text-[#66574e]">
      <b class="text-[#18110d]">للتذكير:</b> تتغير الخدمات المتاحة وأوقاتها وأسعارها بمرور الوقت، وتختلف جودتها من مكان لآخر. يُنصح بالتحقق الفعلي من القنوات الرسمية وخرائط جوجل قبل الزيارة، خصوصاً في العطلات والمناسبات.
    </p>
  </div>
</section>
