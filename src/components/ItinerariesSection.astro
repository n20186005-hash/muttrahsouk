---
// مسارات مخصّصة حسب نوع الزائر + خيارات نصف يوم / يوم كامل.
const numerals = ['١', '٢', '٣'];
const groups = [
  {
    title: 'العائلات مع الأطفال',
    text: 'ابدأوا صباحاً حين يكون الزحام أخف، وامشوا في الممرات الأوسع قرب المدخل، ثم خذوا استراحة على الكورنيش حيث المساحة المفتوحة والنسيم. احرصوا على الماء والظل، واجعلوا الجولة قصيرة وممتعة بلا استعجال.',
    half: 'نحو 1.5–2 ساعة: السوق + جولة قصيرة على الكورنيش.',
    full: 'نحو 4 ساعات: أضيفوا قلعة مطرح والميناء ضمن جولة هادئة.',
  },
  {
    title: 'عشاق التصوير والطبيعة',
    text: 'الساعات الذهبية قرب الشروق المتأخر أو الغروب تمنح أجواءً دافئة للخشب والفضيات والأزقة. التقطوا الكورنيش من أعلى قرب القلعة، واسألوا الباعة قبل تصويرهم أو محالهم.',
    half: 'نحو 2 ساعة حول السوق والكورنيش في الضوء الناعم.',
    full: 'نحو 5 ساعات: غطّوا السوق + الكورنيش + القلعة + حديقة ريام للغروب.',
  },
  {
    title: 'كبار السن وذوو الاحتياجات (وصول منخفض الجهد)',
    text: 'استخدموا سيارة أجرة أو توصيلاً إلى أقرب نقطة مدخل ممكنة، وتجنّبوا ساعات الذروة، واختاروا مساراً بسيطاً مع استراحات متكررة. بعض الممرات ضيّق ومرصوص بحجارة؛ توخَّ الزيارة الهادئة.',
    half: 'نحو ساعة واحدة في القسم الرئيسي القريب من المدخل.',
    full: 'نحو 3 ساعات مع توقف على الكورنيش القريب للراحة.',
  },
];
---
<section id="itinerary" class="section">
  <div class="shell">
    <p class="kicker">مسارات مخصّصة</p>
    <h2 class="display mt-3 max-w-3xl text-4xl font-black md:text-5xl">خطّط حسب رفقتك ووتيرة رحلتك</h2>
    <p class="mt-4 max-w-3xl text-[#58483e]">ثلاثة مسارات موجّهة لاختلاف الزوّار، كلٌّ بخيار نصف يوم ويوم كامل — اقتراحات إرشادية قابلة للتعديل، لا مساراً إلزامياً.</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {groups.map((g, i) => (
        <article class="card rounded-3xl p-6">
          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#176b68]/10 text-lg font-black text-[#176b68]">{numerals[i] ?? i + 1}</span>
            <div>
              <h3 class="text-lg font-black leading-7">{g.title}</h3>
              <p class="mt-2 text-sm text-[#66574e]">{g.text}</p>
            </div>
          </div>
          <div class="mt-5 space-y-2 text-sm">
            <p class="rounded-2xl bg-[#176b68]/5 p-3"><b class="text-[#176b68]">نصف يوم:</b> {g.half}</p>
            <p class="rounded-2xl bg-[#B98739]/10 p-3"><b class="text-[#B98739]">يوم كامل:</b> {g.full}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
