---
// قسم المسؤولية والاحترام — توعية محايدة (لا توصية تجارية ولا ادعاءات علمية مطلقة).
const items = [
  ['احترم الزيّ والعادات', 'الملابس المحتشمة مناسبة لطبيعة المكان والحي؛ احرص على تغطية الكتفين والركبتين تقريباً عند التجول، واحترم خصوصية المصلّين عند اقترابك من المساجد.'],
  ['التقط بأدب', 'استأذن قبل تصوير الباعة أو الزوّار، واحترم رغبتهم إن اعتذروا؛ ولا تلمس التحف والفضيات الدقيقة دون إذن حفاظاً عليها.'],
  ['حافظ على الإرث', 'السوق حيّ يعمل يومياً منذ عقود؛ دعم الحرف المحلية والمشتريات الأصلية يساهم في بقاء هذا الإرث الثقافي ويشجّع الحرفيين على الاستمرار.'],
  ['الرطوبة والشمس', 'صيف مسقط حار ورطب؛ احمل الماء، وتجنّب الجهد تحت الشمس الظهيرة، وافضّل زيارات الصباح الباكر أو المساء عند اشتداد الحرارة.'],
  ['تسوّق برقي', 'المساومة جزء من ثقافة الأسواق العُمانية؛ كن ودوداً وحازماً عند الاتفاق على السعر، ولا تلحّ بإفراط، واحرص على الهدوء والابتسام.'],
  ['سلامتك أولاً', 'انتبه لمتعلقاتك في الأزقة المزدحمة، وتحقّق من السعر والجودة والمنشأ قبل الشراء، واحتفظ ببعض النقد بالريال العُماني للمبالغ الصغيرة.'],
];
---
<section id="responsibility" class="bg-[#2b1b13] py-16 text-white">
  <div class="shell">
    <p class="text-sm font-bold text-[#E2A52E]">زيارة مسؤولة</p>
    <h2 class="display mt-3 max-w-3xl text-4xl font-black md:text-5xl">قليل من المعرفة يصنع زيارة أفضل</h2>
    <p class="mt-4 max-w-3xl text-[#d8c6a2]">السوق ليس متجراً فحسب، بل حيّ ثقافي حيّ. هذه نصائح محايدة تساعدك على زيارة تحترم المكان وأهله وتتجنّب المزالق الشائعة.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {items.map(([t, d]) => (
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <h3 class="font-black text-[#F6D98C]">{t}</h3>
          <p class="mt-2 text-sm leading-7 text-[#d8c6a2]">{d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
