---
// اقتراح جولة — محتوى إرشادي محايد دون التزامات زمنية صارمة
const steps = [
  ['ابدأ من الواجهة', 'قف عند كورنيش مطرح أمام مدخل السوق لتتعرف على الميناء وقواربه وأجواء المنطقة قبل الدخول إلى الأزقة.'],
  ['جوّب السوق بهدوء', 'ساعة إلى ساعتين تكفيان عادةً للاستمتاع بالممرات والتفاوض دون استعجال؛ الصباح أهدأ والمساء أحيى بالأنوار والحركة.'],
  ['توقّف لتذوق محلي', 'جرب القهوة العُمانية مع التمر أو الحلوى العُمانية في أي مقهى قريب يناسبك، أو وجبة سمك ومشاكيك على الكورنيش.'],
  ['ارتقِ لمنظر أوسع', 'قلعة مطرح القريبة تتيح إطلالة على الميناء والكورنيش، لكن تحقق من أوقات زيارة القلعة قبل الصعود.'],
  ['مدّد الجولة اختيارياً', 'إن توفر وقت أطول، أضف حديقة ريام على الكورنيش، أو المتحف الوطني في مسقط، بالوصول إليهما بسيارة أجرة أو مركبة خاصة.'],
];
---
<section id="route" class="bg-[#f1e3c4] py-16">
  <div class="shell grid gap-10 lg:grid-cols-[1.1fr_.9fr]">
    <div>
      <p class="kicker">اقتراح جولة</p>
      <h2 class="display mt-3 text-4xl font-black md:text-5xl">أفكار لترتيب وقتك حول السوق</h2>
      <p class="mt-5 text-[#58483e]">اقتراح إرشادي قابل للتعديل بحسب وقت وصولك وحرارته ونوع رحلتك، وليس مساراً إلزامياً.</p>
      <ol class="mt-8 space-y-4">
        {steps.map(([title, text], i) => (
          <li class="flex gap-4">
            <span aria-hidden="true" class="mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#176b68] font-black text-white">{i + 1}</span>
            <div class="card flex-1 rounded-3xl p-5">
              <h3 class="font-black text-[#176b68]">{title}</h3>
              <p class="mt-2 text-sm text-[#66574e]">{text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <aside class="grid content-start gap-5">
      <div class="card rounded-3xl p-6">
        <p class="text-xs font-black text-[#176b68]">جولة قصيرة (سيراً)</p>
        <h3 class="mt-1 text-xl font-black">نحو 2–3 ساعات</h3>
        <p class="mt-3 text-sm text-[#66574e]">سوق مطرح + كورنيش مطرح + قلعة مطرح. مناسبة لمن لا يملك وقتاً طويلاً، وتغطي أهم ما في المنطقة على الأقدام.</p>
      </div>
      <div class="card rounded-3xl p-6">
        <p class="text-xs font-black text-[#176b68]">جولة موسعة (نصف يوم)</p>
        <h3 class="mt-1 text-xl font-black">نحو 4–6 ساعات</h3>
        <p class="mt-3 text-sm text-[#66574e]">أضف حديقة ريام على امتداد الكورنيش، أو المتحف الوطني في مسقط لفهم تاريخ عُمان، وتنقّل بينها بسيارة أجرة أو مركبة خاصة.</p>
      </div>
      <div class="rounded-3xl border border-[#B98739]/30 bg-[#fffaf0] p-5 text-sm text-[#66574e]">
        <b class="text-[#18110d]">نصيحة ميدانية:</b> حافظ على ترطيبك صيفاً، وفضّل زيارات الصباح الباكر أو المساء عند اشتداد الحرارة، وارتدِ ملابس مريحة محتشمة وأحذية مناسبة للمشي على أرضيات السوق.
      </div>
    </aside>
  </div>
</section>
