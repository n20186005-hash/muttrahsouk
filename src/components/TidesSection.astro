---
import { marine as loadMarine, stamp } from "../lib/environment";
const marine=await loadMarine();

function nearestIndex(times: string[]): number {
  const now = Date.now();
  let best = 0;
  let bestDiff = Infinity;
  for (let i = 0; i < times.length; i++) {
    const diff = Math.abs(stamp(times[i]) - now);
    if (diff < bestDiff) {
      bestDiff = diff;
      best = i;
    }
  }
  return best;
}

function fmtTime(iso: string): string {
  try {
    return new Intl.DateTimeFormat('ar-OM', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Muscat' }).format(new Date(stamp(iso)));
  } catch {
    return '';
  }
}

interface TideExt {
  type: 'high' | 'low';
  time: number;
  height: number;
}

function findNextTides(times: string[], heights: (number | null)[]): { high: TideExt | null; low: TideExt | null } {
  const now = Date.now();
  const ext: TideExt[] = [];
  for (let i = 1; i < heights.length - 1; i++) {
    const h = heights[i];
    if (h == null) continue;
    const p = heights[i - 1];
    const n = heights[i + 1];
    if (p == null || n == null) continue;
    if (h > p && h >= n) ext.push({ type: 'high', time: stamp(times[i]), height: h });
    else if (h < p && h <= n) ext.push({ type: 'low', time: stamp(times[i]), height: h });
  }
  // فلترة لتجنّب القمم الوهمية: فاصل لا يقل عن 3 ساعات
  const filt: TideExt[] = [];
  let last = -Infinity;
  for (const e of ext) {
    if (e.time - last >= 3 * 3600 * 1000) {
      filt.push(e);
      last = e.time;
    }
  }
  const high = filt.filter((e) => e.type === 'high' && e.time >= now).sort((a, b) => a.time - b.time)[0] ?? null;
  const low = filt.filter((e) => e.type === 'low' && e.time >= now).sort((a, b) => a.time - b.time)[0] ?? null;
  return { high, low };
}

let tideNow: number | null = null;
let waveNow: number | null = null;
let sstNow: number | null = null;
let nextHigh: TideExt | null = null;
let nextLow: TideExt | null = null;

if (marine) {
  const i = nearestIndex(marine.hourly.time);
  tideNow = marine.hourly.sea_level_height_msl[i] ?? null;
  waveNow = marine.hourly.wave_height[i] ?? null;
  sstNow = marine.hourly.sea_surface_temperature[i] ?? null;
  const found = findNextTides(marine.hourly.time, marine.hourly.sea_level_height_msl);
  nextHigh = found.high;
  nextLow = found.low;
}

const rising = !!nextHigh && (!nextLow || nextHigh.time < nextLow.time);

const tideTips=['هذه تقديرات بحرية شبكية وليست رصداً عند الكورنيش أو جدول مد رسمي. لا تثبت سلامة السباحة أو الملاحة أو الوصول إلى الصخور.','راقب تنبيهات الجهات المحلية وحواجز الموقع؛ لا تستنتج حالة التيارات أو صلاحية الاقتراب من الماء من ارتفاع الموج وحده.'];

---

<section id="tides" class="bg-[#e9f1ef] py-16">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="kicker">البحر بجانب السوق</p>
        <h2 class="display mt-3 text-4xl font-black md:text-5xl">البحر قرب مطرح: تقديرات النموذج</h2>
      </div>
      <p class="max-w-md text-sm text-[#3f5d58]">Open-Meteo: ارتفاع سطح البحر فوق متوسطه العالمي (يشمل المد)، وارتفاع الموج وحرارة الماء متغيرات مختلفة. دقة نموذج المد نحو 8 كم، وقد يختار المزود خلية بحرية بعيدة عن موقع السوق؛ غير مناسب للملاحة الساحلية. الأوقات بتوقيت مسقط، والذاكرة المؤقتة حتى 30 دقيقة.</p>
    </div>

    {marine ? (
      <div class="mt-10 space-y-6">
        <div class="rounded-[2rem] bg-[#176b68] p-7 text-white">
          <div class="grid items-center gap-8 md:grid-cols-[auto_1fr]">
            <div>
              <p class="text-sm font-bold text-[#F6D98C]">ارتفاع سطح البحر النموذجي قرب الوقت الحالي</p>
              <p dir="ltr" class="mt-1 text-6xl font-black leading-none">{tideNow != null ? tideNow.toFixed(1) : '—'}<span class="text-2xl"> م</span></p>
              <p class="mt-2 text-sm font-bold">{rising ? 'القمة النموذجية التالية تسبق القاع' : nextLow ? 'القاع النموذجي التالي يسبق القمة' : 'لا تتوفر قمة أو قاع تالٍ'}</p>
            </div>
            <div class="grid grid-cols-2 gap-3 text-center sm:grid-cols-4">
              <div class="rounded-2xl bg-white/12 px-3 py-4"><p class="text-xs text-[#d8eee9]">الموج</p><p dir="ltr" class="mt-1 text-xl font-black">{waveNow != null ? waveNow.toFixed(1) : '—'}<span class="text-sm"> م</span></p></div>
              <div class="rounded-2xl bg-white/12 px-3 py-4"><p class="text-xs text-[#d8eee9]">حرارة الماء</p><p dir="ltr" class="mt-1 text-xl font-black">{sstNow != null ? Math.round(sstNow) : '—'}<span class="text-sm">°م</span></p></div>
              <div class="rounded-2xl bg-white/12 px-3 py-4"><p class="text-xs text-[#d8eee9]">القمة التالية</p><p dir="ltr" class="mt-1 text-xl font-black">{nextHigh ? fmtTime(new Date(nextHigh.time).toISOString()) : '—'}</p></div>
              <div class="rounded-2xl bg-white/12 px-3 py-4"><p class="text-xs text-[#d8eee9]">القاع التالي</p><p dir="ltr" class="mt-1 text-xl font-black">{nextLow ? fmtTime(new Date(nextLow.time).toISOString()) : '—'}</p></div>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-[#176b68]/20 bg-[#fffaf0] p-6">
          <p class="font-black text-[#18110d]">أوقات المد والقاع التالية</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-2xl border border-[#176b68]/15 bg-[#176b68]/5 p-5">
              <p class="text-sm font-black text-[#176b68]">قمة نموذجية</p>
              <p dir="ltr" class="mt-2 text-2xl font-black text-[#18110d]">{nextHigh ? fmtTime(new Date(nextHigh.time).toISOString()) : '—'}</p>
              <p class="mt-1 text-sm text-[#58483e]">{nextHigh ? `ارتفاع تقريبي ${nextHigh.height.toFixed(1)} م` : 'غير متوفر ضمن النطاق'}</p>
            </div>
            <div class="rounded-2xl border border-[#B98739]/20 bg-[#B98739]/5 p-5">
              <p class="text-sm font-black text-[#B98739]">قاع نموذجي</p>
              <p dir="ltr" class="mt-2 text-2xl font-black text-[#18110d]">{nextLow ? fmtTime(new Date(nextLow.time).toISOString()) : '—'}</p>
              <p class="mt-1 text-sm text-[#58483e]">{nextLow ? `انحسار تقريبي ${nextLow.height.toFixed(1)} م` : 'غير متوفر ضمن النطاق'}</p>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-[#B98739]/20 bg-[#fffaf0] p-6">
          <p class="font-black text-[#18110d]">حدود البيانات</p>
          <ul class="mt-4 space-y-3 text-sm text-[#58483e]">
            {tideTips.map((t) => (
              <li class="flex gap-2"><span class="text-[#176b68]">•</span><span>{t}</span></li>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <div class="mt-10 max-w-3xl rounded-[2rem] border border-[#176b68]/30 bg-[#fffaf0] p-8 text-[#3f5d58]">
        <p class="font-black text-[#18110d]">تعذر تحميل بيانات المد والجزر حالياً</p>
        <p class="mt-2 text-sm">حدث خطأ مؤقت في جلب بيانات البحر. أعد تحميل الصفحة لاحقاً، لا تتوفر تقديرات موثوقة هنا؛ راجع الجهات المحلية ولا تعتمد على هذا القسم لسلامة الاقتراب من البحر.</p>
      </div>
    )}
    <p class="mt-6 text-sm"><a class="underline" href="https://open-meteo.com/en/docs/marine-weather-api">المصدر وحدود نموذج البحر</a></p>
  </div>
</section>
